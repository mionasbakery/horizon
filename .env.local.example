# Copy to .env.local (gitignored), fill in the two client values below by hand, then run
#   npm run gbp:auth
# to have scripts/gbp-auth.mjs fill in the remaining three for you.

# Manual. Create a **Desktop app** OAuth client in the Google Cloud Console, with scope
# https://www.googleapis.com/auth/business.manage on the consent screen. Desktop is required: it is
# the only client type that accepts the http://127.0.0.1:<port> redirect the auth script uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Written by `npm run gbp:auth` — leave empty.
GOOGLE_REFRESH_TOKEN=

# Written by `npm run gbp:auth` — leave empty. Bare numeric IDs, not full resource paths.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
