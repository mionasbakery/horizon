          "blocks": {
            "date": {
              "type": "mionas-newsletter-date",
              "name": "Mionas: Newsletter Date",
              "settings": {
                "show_year": true,
                "size": "lg",
                "variant": "accent",
                "tag": "p",
                "padding-block-start": 0,
                "padding-block-end": 16,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "body": {
              "type": "mionas-text",
              "name": "Mionas: Text role - Body",
              "settings": {
                "text": "{{ closest.article.content }}",
                "variant": "body",
                "size": "lg",
                "color": "default",
                "tag": "div",
                "text_wrap": "normal",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "structured_data": {
              "type": "custom-liquid",
              "name": "Custom liquid - Article data for search engines",
              "settings": {
                "custom_liquid": "<script type=\"application/ld+json\">{{ article | structured_data }}</script>"
              }
            },
            "image_css": {
              "type": "custom-liquid",
              "name": "Custom liquid - Image CSS",
              "settings": {
                "custom_liquid": "<style>#MainContent .rte img { border-radius: var(--radius-xl); }</style>"
              }
            }
          },
          "block_order": [
            "date",
            "body",
            "structured_data",
            "image_css"
          ]
        }
