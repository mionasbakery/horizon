              "blocks": {
                "faq_productos_otros": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Otros productos",
                  "settings": {
                    "question": "¿Qué otros productos tenéis, además de cookies?",
                    "answer": "<p>En el obrador también hacemos <a href=\"/products/brookie\">brookies</a>, <a href=\"/collections/mega-cookies\">megacookies</a>, mini cheesecakes y <a href=\"/collections/encargos\">tartas personalizadas</a> para tus celebraciones.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_productos_veganas": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Veganas",
                  "settings": {
                    "question": "¿Tenéis opciones veganas?",
                    "answer": "<p>Sí. Tenemos una colección de <a href=\"/collections/cookies-veganas\">cookies veganas</a>.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_productos_sin_gluten": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Sin gluten",
                  "settings": {
                    "question": "¿Tenéis opciones sin gluten?",
                    "answer": "<p>No, de momento no ofrecemos cookies sin gluten. Nuestro obrador trabaja con gluten a diario y no podemos garantizar que no haya contaminación cruzada.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_productos_pan": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Pan",
                  "settings": {
                    "question": "¿Vendéis pan?",
                    "answer": "<p>No, no vendemos pan. Somos especialistas en cookies americanas.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_productos_cafe": {
