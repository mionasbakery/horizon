                "faq_envios_domicilio": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Envíos a domicilio",
                  "settings": {
                    "question": "¿Hacéis envíos a domicilio?",
                    "answer": "<p>Sí, enviamos a toda la Península. De momento no llegamos a Baleares ni Canarias. Preparamos los envíos para que las cookies lleguen en perfecto estado.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_envios_coste": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Coste y plazo",
                  "settings": {
                    "question": "¿Cuánto cuesta el envío y cuánto tarda?",
                    "answer": "<p>El coste es de [TARIFA DE ENVÍO] y el plazo habitual de entrega es de [PLAZO DE ENTREGA]. Verás el importe exacto al finalizar tu compra.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
