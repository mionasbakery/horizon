            "faq_pedidos": {
              "type": "mionas-faq",
              "name": "Mionas: FAQ - Pedidos",
              "settings": {},
              "blocks": {
                "faq_pedidos_recogida": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Recogida",
                  "settings": {
                    "question": "¿Puedo recoger mi pedido en la tienda?",
                    "answer": "<p>Sí. Puedes recoger tu pedido en nuestra tienda de Carrer de Sant Bonaventura, 16 (Sitges) dentro del horario de apertura. Indica la recogida en tienda al finalizar tu compra.</p>",
                    "open_by_default": true
                  },
                  "blocks": {}
                },
                "faq_pedidos_antelacion": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Antelación",
                  "settings": {
                    "question": "¿Con cuánta antelación debo hacer mi pedido?",
                    "answer": "<p>Horneamos cada día en pequeñas cantidades. Para pedidos grandes o packs personalizados, te recomendamos pedir con la máxima antelación posible.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_pedidos_personalizados": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Pedidos personalizados",
                  "settings": {
                    "question": "¿Hacéis pedidos personalizados para cumpleaños, bodas o eventos?",
                    "answer": "<p>Sí. Las megacookies y los packs a medida son de lo que más disfrutamos. Cuéntanos la ocasión y lo preparamos contigo.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_pedidos_modificar": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Modificar o cancelar",
                  "settings": {
                    "question": "¿Puedo modificar o cancelar mi pedido?",
                    "answer": "<p>Escríbenos cuanto antes por WhatsApp o email y buscamos la mejor solución. Si el pedido ya está en el horno, puede que no lleguemos a tiempo, pero siempre lo intentamos.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "faq_pedidos_horario": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Horario",
                  "settings": {
                    "question": "¿Cuál es vuestro horario de apertura?",
                    "answer": "<p>De martes a sábado abrimos de 10:00 a 14:00 y de 16:30 a 20:30. Los domingos, de 10:00 a 14:00. Los lunes permanecemos cerrados.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                }
              },
              "block_order": [
                "faq_pedidos_recogida",
                "faq_pedidos_antelacion",
                "faq_pedidos_personalizados",
                "faq_pedidos_modificar",
                "faq_pedidos_horario"
              ]
            },
