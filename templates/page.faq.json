                "mionas_faq_question_jjXMPi": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Veganas",
                  "settings": {
                    "question": "¿Tenéis opciones veganas?",
                    "answer": "<p>Sí. Tenemos una colección de <a href=\"/collections/cookies-veganas\">cookies veganas</a>.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "mionas_faq_question_bPhUeq": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Sin gluten",
                  "settings": {
                    "question": "¿Tenéis opciones sin gluten?",
                    "answer": "<p>No, de momento no ofrecemos cookies sin gluten. Nuestro obrador trabaja con gluten a diario y no podemos garantizar que no haya contaminación cruzada.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "mionas_faq_question_allergens": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Alérgenos",
                  "settings": {
                    "question": "¿Dónde puedo consultar los alérgenos?",
                    "answer": "<p>Puedes consultar toda la información en nuestra <a href=\"/pages/alergenos\">página de alérgenos</a>.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                },
                "mionas_faq_question_storage": {
                  "type": "_mionas-faq-question",
                  "name": "Mionas: FAQ question - Conservación",
                  "settings": {
                    "question": "¿Cómo conservo y caliento las cookies?",
                    "answer": "<p>Las cookies se mantienen frescas hasta una semana si las guardas en un recipiente hermético.</p><p>Si no las vas a consumir durante los primeros días, puedes congelarlas. Para calentarlas, déjalas entre 3 y 5 minutos en el horno a 180 °C o entre 5 y 10 segundos en el microondas.</p><p>Si estaban congeladas, caliéntalas durante 5 minutos en el horno a 180 °C.</p>",
                    "open_by_default": false
                  },
                  "blocks": {}
                }
              },
