                  "name": "Mionas: FAQ question - Cursos",
                  "settings": {
                    "question": "¿Ofrecéis cursos de repostería?",
                    "answer": "<p>Sí. Organizamos <a href=\"/collections/cursos\">cursos</a> en nuestro obrador de Sitges. Consulta las próximas fechas y reserva tu plaza en la tienda online.</p>",
                    "open_by_default": false
