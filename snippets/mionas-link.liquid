{%- doc -%}
  Renders an inline text link, a ../design-system/src/components/Link/Link.tsx mirror, as either an <a> or a <button>.

  @param {string} content - Label content. Emitted unfiltered; caller must sanitise if needed.
  @param {string} [color] - A Text colour, or inherit to take the surrounding colour. Defaults to primary.
  @param {string} [variant] - A Text variant: display, heading, subheading, title, lead, body or label. Leave it blank, or pass inherit, to take the surrounding size.
  @param {string} [icon] - Icon name, passed through to snippets/icon.liquid. Blank/"none" for no icon.
  @param {string} [text_wrap] - normal or nowrap. Defaults to normal.
  @param {string} [tag] - "a" (default) or "button".
  @param {string} [link] - href, used only when tag is "a". Blank renders a disabled, non-interactive link.
  @param {boolean} [open_in_new_tab] - Adds target="_blank" and rel="noopener noreferrer". Used only when tag is "a".
  @param {string} [attributes] - Raw extra attributes, such as aria-current, or "type" on a <button> -- this snippet doesn't default it. Caller-controlled only -- never pass merchant free text through here.
  @param {string} [class] - Extra classes for the caller's own overrides.
  @param {string} [shopify_attributes] - The caller's block.shopify_attributes, so the theme editor can still select the block.

  @example
  {% render 'mionas-link', content: 'Contact us', link: '/pages/contact', variant: 'body' %}
{%- enddoc -%}
{%- comment -%}
  Link.tsx renders through Text, so this renders through snippets/mionas-text.liquid: the variant and
  colour classes, and their CSS, come from there. This file adds only the link weight, hover and
  icon. It is a snippet so blocks/mionas-language-links.liquid and mionas-policy-links.liquid share
  it; a block can't {% render %} another block.

  The tag switch exists because language links must be real <button> elements to submit the native
  'localization' form (see snippets/mionas-language-links.liquid); a plain <a> can't do that without
  JavaScript, which this component deliberately avoids.
{%- endcomment -%}
{%- liquid
  assign resolved_tag = tag | default: 'a'
  assign resolved_color = color | default: 'primary'

  assign resolved_variant = variant | default: 'inherit'
  assign allowed_variants = 'inherit|display|heading|subheading|title|lead|body|label' | split: '|'
  unless allowed_variants contains resolved_variant
    assign resolved_variant = 'body'
  endunless

  assign classes = 'mionas-link'
  if resolved_variant == 'inherit'
    assign classes = classes | append: ' mionas-link--inherit'
  else
    assign classes = classes | append: ' mionas-link--' | append: resolved_variant
  endif
  if icon != blank and icon != 'none'
    assign classes = classes | append: ' mionas-link--with-icon'
  endif
  if text_wrap == 'nowrap'
    assign classes = classes | append: ' mionas-link--nowrap'
  endif
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}
{%- capture link_attributes -%}
  {%- if resolved_tag == 'a' -%}
    {%- if link == blank -%}
      role="link" aria-disabled="true"
    {%- else -%}
      href="{{ link }}"
      {%- if open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif -%}
    {%- endif -%}
  {%- endif -%}
  {%- if attributes != blank %} {{ attributes }}{% endif -%}
{%- endcapture -%}
{%- capture link_content -%}
  {%- if icon != blank and icon != 'none' -%}
    <svg class="mionas-link__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      {%- render 'icon', icon: icon -%}
    </svg>
  {%- endif -%}
  {{- content -}}
{%- endcapture -%}
{%- render 'mionas-text',
  content: link_content,
  variant: resolved_variant,
  color: resolved_color,
  tag: resolved_tag,
  class: classes,
  attributes: link_attributes,
  shopify_attributes: shopify_attributes
-%}

{% stylesheet %}
  /* Two classes deep so the link weight beats the .text-role--<variant> weight at one class, the way
     Link.module.css overrides Text's. */
  .text-role.mionas-link {
    font-weight: var(--link-base-font-weight);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .text-role.mionas-link--display {
    font-weight: var(--link-display-font-weight);
  }

  .text-role.mionas-link--heading {
    font-weight: var(--link-heading-font-weight);
  }

  .text-role.mionas-link--subheading {
    font-weight: var(--link-subheading-font-weight);
  }

  .text-role.mionas-link--title {
    font-weight: var(--link-title-font-weight);
  }

  .text-role.mionas-link--lead {
    font-weight: var(--link-lead-font-weight);
  }

  .text-role.mionas-link--body {
    font-weight: var(--link-body-font-weight);
  }

  .text-role.mionas-link--label {
    font-weight: var(--link-label-font-weight);
  }

  /* A <button> doesn't inherit font size from its surroundings on its own. */
  .mionas-link--inherit {
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  .mionas-link--nowrap {
    white-space: nowrap;
  }

  .mionas-link:hover {
    text-decoration: underline;
  }

  .mionas-link[aria-disabled="true"] {
    cursor: default;
    pointer-events: none;
  }

  .mionas-link--with-icon {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .mionas-link__icon {
    flex: none;
    width: 16px;
    height: 16px;
  }
{% endstylesheet %}
