{%- doc -%}
  The uppercase label above a form field. Renders an invisible, non-labelling placeholder of the
  same height if text is blank, instead of a real <label>.

  @param {string} text - The label copy. Blank renders a height-preserving placeholder, not a <label>.
  @param {string} [for] - The id of the control this labels. Optional but strongly preferred.
  @param {boolean} [required] - Defaults to true. Pass false to append the " (optional)" suffix.
  @param {boolean} [error] - Pass true for the error colour.
  @param {string} [optional_text] - Word inside the " (optional)" suffix's parentheses.
  @param {string} [class] - Extra classes to append.
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/FormLabel/FormLabel.tsx.

  Blank text never renders a real <label>: an empty `<label for="...">` outranks the placeholder in
  the accessible-name algorithm and suppresses the input's name entirely (confirmed in Chrome as
  `name: ""`). It renders a height-reserving `<span>` instead, with `aria-hidden` and no `for` to
  stay out of that problem.

  `required` uses an explicit `== false` check because Liquid's `default` filter treats false as
  empty and would flip it back to true.

  There's no locale key for `optional_text`'s default -- nothing under `general.form.*` exists in
  locales/en.default.json, and `| t` on a missing key renders "translation missing: ..." rather than
  falling through -- so it stays a plain parameter; Spanish callers pass `optional_text: 'opcional'`.

  Focus colour is not set here: FormLabel.module.css's `.root` reads
  `var(--form-label-focus-color, var(--form-label-base-foreground))`, and
  FormField.module.css's `.root:focus-within` assigns that variable -- the indirection that lets
  colour reach a label that precedes the input in the DOM, where no sibling combinator could.

  Fonts: --font-family-archivo, repointed at the theme's loaded body font by
  snippets/design-system-bridge.liquid.
{%- endcomment -%}
{% liquid
  assign label_is_required = true
  if required == false
    assign label_is_required = false
  endif

  assign label_classes = 'mionas-form-label'
  if error == true
    assign label_classes = label_classes | append: ' mionas-form-label--error'
  endif
  if class
    assign label_classes = label_classes | append: ' ' | append: class
  endif
%}
{%- if text != blank -%}
  <label class="{{ label_classes }}"{% if for != blank %} for="{{ for }}"{% endif %}>
    {{- text -}}
    {%- unless label_is_required -%}
      <span class="mionas-form-label__optional"> ({{ optional_text | default: 'optional' }})</span>
    {%- endunless -%}
  </label>
{%- else -%}
  <span class="{{ label_classes }} mionas-form-label--placeholder" aria-hidden="true">&nbsp;</span>
{%- endif -%}

{% stylesheet %}
  /* FormLabel.module.css .root, plus Text's role="label" scale which FormLabel.tsx gets from
     rendering <Text as="label" role="label">. */
  .mionas-form-label {
    padding-left: var(--form-label-base-padding);
    color: var(--form-label-focus-color, var(--form-label-base-foreground));
    text-transform: uppercase;
    font-family: var(--font-family-archivo);
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
  }

  .mionas-form-label--error {
    color: var(--form-label-state-error-foreground);
  }

  /* Occupies the same box a real label would without being seen or announced. */
  .mionas-form-label--placeholder {
    visibility: hidden;
  }

  /* Pinned back to the base colour so the suffix doesn't inherit the label's focused/error colour.
     Uppercase is inherited from .root rather than reset, so "(opcional)" reads "(OPCIONAL)" same as
     the label itself. */
  .mionas-form-label__optional {
    color: var(--form-label-base-foreground);
  }
{% endstylesheet %}
