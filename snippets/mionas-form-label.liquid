{%- doc -%}
  The uppercase label above a form field. Renders an invisible, non-labelling placeholder of the
  same height if text is blank, instead of a real <label>.

  @param {string} text - The label copy. Blank renders a height-preserving placeholder, not a <label>.
  @param {string} [for] - The id of the control this labels. Optional but strongly preferred.
  @param {boolean} [required] - Defaults to true. Pass false to append the " (optional)" suffix.
  @param {boolean} [error] - Pass true for the error colour.
  @param {string} [optional_text] - Word inside the " (optional)" suffix's parentheses.
  @param {string} [class] - Extra classes to append.
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/FormLabel/FormLabel.tsx -- the uppercase label above a field.

  BLANK TEXT NEVER RENDERS A REAL <label>. An empty <label for="..."> outranks the placeholder in
  the accessible-name algorithm, so it suppresses the input's name rather than just failing to add
  one -- Chrome confirmed `name: ""` on the email signup's input. Do not "restore" a real,
  `for`-associated `<label>` here for layout reasons.

  It renders a height-reserving `<span>` placeholder instead (see below), so a labelless field still
  aligns with its labelled siblings. `aria-hidden` and no `for` keep it out of the accessible-name
  problem above.

  Accepts:
    text      The label copy. Blank renders a height-reserving placeholder instead -- see above.
    for       Optional but strongly preferred: the id of the control this labels.
    required  Defaults to true, matching FormLabel.tsx's `required = true`. Pass false to append the
              " (optional)" suffix. This is an explicit `== false` test rather than
              `| default: true`, because Liquid's `default` filter treats false as empty and would
              flip it straight back to true.
    error     Pass true for the error colour. snippets/mionas-form-field.liquid forwards this
              automatically, mirroring FormField.tsx's `error={!!error}`. The error rule is declared
              after the base rule at equal specificity, so it wins even while the field has focus --
              matching FormLabel.tsx, where `error ? styles.error : focused ? styles.focused : ...`
              checks error first.
    optional_text
              The word inside the parentheses of the " (optional)" suffix. Defaults to the literal
              FormLabel.tsx uses. There is no locale key for this -- nothing under `general.form.*`
              exists in locales/en.default.json -- and a `| t` on a missing key renders the string
              "translation missing: ..." rather than falling through to a default, so this is a
              plain parameter. Spanish callers pass optional_text: 'opcional'.
    class     Extra classes to append.

  FOCUS COLOUR IS NOT SET HERE. FormLabel.module.css's .root reads
  `var(--form-label-focus-color, var(--form-label-base-foreground))`, and FormField.module.css's
  `.root:focus-within` is what assigns --form-label-focus-color. That indirection is what lets the
  colour reach a label that PRECEDES the input in the DOM, where no sibling combinator can. This
  snippet keeps the design system's own custom-property name so the two stay greppable together.

  Fonts: --font-family-archivo, the design system's body primitive, repointed at the theme's
  loaded body font by snippets/design-system-bridge.liquid. FormLabel.module.css sets no family of
  its own, so this spends the primitive rather than inventing a component token.
{%- endcomment -%}
{% liquid
  assign label_is_required = true
  if required == false
    assign label_is_required = false
  endif

  assign label_classes = 'mionas-form-label'
  if error == true
    assign label_classes = label_classes | append: ' mionas-form-label--error'
  endif
  if class
    assign label_classes = label_classes | append: ' ' | append: class
  endif
%}
{%- if text != blank -%}
  <label class="{{ label_classes }}"{% if for != blank %} for="{{ for }}"{% endif %}>
    {{- text -}}
    {%- unless label_is_required -%}
      <span class="mionas-form-label__optional"> ({{ optional_text | default: 'optional' }})</span>
    {%- endunless -%}
  </label>
{%- else -%}
  <span class="{{ label_classes }} mionas-form-label--placeholder" aria-hidden="true">&nbsp;</span>
{%- endif -%}

{% stylesheet %}
  /* FormLabel.module.css .root, plus Text's role="label" scale which FormLabel.tsx gets from
     rendering <Text as="label" role="label">. */
  .mionas-form-label {
    padding-left: var(--form-label-base-padding);
    color: var(--form-label-focus-color, var(--form-label-base-foreground));
    text-transform: uppercase;
    font-family: var(--font-family-archivo);
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
  }

  .mionas-form-label--error {
    color: var(--form-label-state-error-foreground);
  }

  /* Occupies the same box a real label would without being seen or announced. */
  .mionas-form-label--placeholder {
    visibility: hidden;
  }

  /* FormLabel.module.css .optional -- deliberately pinned back to the base colour so the suffix
     does not inherit the focused/error colour the rest of the label takes on. Uppercase is NOT
     overridden here: FormLabel.module.css's .optional inherits .root's text-transform: uppercase
     rather than resetting it, so "(opcional)" reads "(OPCIONAL)" same as the label itself. */
  .mionas-form-label__optional {
    color: var(--form-label-base-foreground);
  }
{% endstylesheet %}
