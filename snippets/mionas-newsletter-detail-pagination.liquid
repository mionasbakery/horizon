{%- doc -%}
  Renders links to the older and the newer newsletter, below the one being read.

  @param {blog} blog - The blog of the newsletter being read.
{%- enddoc -%}
{%- liquid
  # blog.previous_article is the older email and blog.next_article the newer one (checked in the theme dev preview).
  assign older = blog.previous_article
  assign newer = blog.next_article
  assign previous_label = 'mionas.newsletter.previous' | t
  assign next_label = 'mionas.newsletter.next' | t
  assign older_title = older.title | escape
  assign newer_title = newer.title | escape
-%}
{%- if older != blank or newer != blank -%}
  <nav
    class="mionas-newsletter-detail-pagination"
    aria-label="{{ 'mionas.newsletter.pagination_label' | t | escape }}"
  >
    {%- comment -%} An empty cell keeps the other link on its own side. {%- endcomment -%}
    {%- if older != blank -%}
      <a class="mionas-newsletter-detail-pagination__cell" href="{{ older.url }}">
        {%- render 'mionas-text', content: previous_label, variant: 'label', size: 'lg', tag: 'span', class: 'mionas-newsletter-detail-pagination__label' -%}
        {%- render 'mionas-text', content: older_title, variant: 'title', size: 'sm', tag: 'span', class: 'mionas-newsletter-detail-pagination__subject' -%}
      </a>
    {%- else -%}
      <span class="mionas-newsletter-detail-pagination__cell"></span>
    {%- endif -%}
    {%- if newer != blank -%}
      <a class="mionas-newsletter-detail-pagination__cell mionas-newsletter-detail-pagination__cell--newer" href="{{ newer.url }}">
        {%- render 'mionas-text', content: next_label, variant: 'label', size: 'lg', tag: 'span', class: 'mionas-newsletter-detail-pagination__label' -%}
        {%- render 'mionas-text', content: newer_title, variant: 'title', size: 'sm', tag: 'span', class: 'mionas-newsletter-detail-pagination__subject' -%}
      </a>
    {%- else -%}
      <span class="mionas-newsletter-detail-pagination__cell mionas-newsletter-detail-pagination__cell--newer"></span>
    {%- endif -%}
  </nav>
{%- endif -%}
