{%- doc -%}
  Renders the newsletter signup's success content: an envelope, the thanks, where the discount code
  went and a button that closes the popup around it. The popup's component must define
  continueShopping().
{%- enddoc -%}
{%- liquid
  assign title = 'mionas.newsletter_success.title' | t
  assign text = 'mionas.newsletter_success.text' | t
-%}
{%- capture continue_classes -%}
  {%- render 'mionas-button-class', variant: 'primary', full_width: true -%}
{%- endcapture -%}

<div class="mionas-signup-done">
  <span class="mionas-signup-done__icon">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"/>
      <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"/>
    </svg>
  </span>
  {%- render 'mionas-text', content: title, variant: 'heading', tag: 'h2' -%}
  {%- render 'mionas-text', content: text, variant: 'body', tag: 'p' -%}
  <button
    type="button"
    class="{{ continue_classes }}"
    on:click="/continueShopping"
  >
    {{ 'mionas.newsletter_popup.continue' | t }}
  </button>
</div>

{% stylesheet %}
  .mionas-signup-done {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .mionas-signup-done .mionas-button {
    align-self: stretch;
  }

  .mionas-signup-done__icon {
    display: flex;
    color: var(--brand-primary);
  }

  /* Placeholder: the design system has no icon size this large. Candidate token. */
  .mionas-signup-done__icon svg {
    width: 48px;
    height: 48px;
  }
{% endstylesheet %}
