{%- doc -%}
  Renders stamp text in the Stamp face, sized to the text it labels, coloured and padded by a stamp block's settings.

  @param {string} content - Inline HTML to show. Emitted unfiltered; callers sanitise it.
  @param {object} [settings] - The calling block's settings: size, variant, tag and padding-*.
  @param {string} [size] - The labelled text's variant and size, e.g. headline-md, for a caller with no block settings; wins over settings.size.
  @param {string} [color] - Text colour variant for a caller with no block settings; wins over settings.variant.
  @param {string} [tag] - Element for a caller with no block settings; wins over settings.tag.
  @param {string} [shopify_attributes] - The calling block's block.shopify_attributes.
{%- enddoc -%}
{%- comment -%}
  settings.variant is the stamp's Color setting, not Text's band -- the id stayed `variant` to avoid
  re-migrating existing stored settings like footer-group.json's. A size that is not one of the
  pairs below, such as a stored lg/md/sm from before the pairs, falls back to Stamp.tsx's default.
{%- endcomment -%}
{%- liquid
  assign size = size | default: settings.size
  assign allowed_sizes = 'display-lg|display-md|display-sm|headline-lg|headline-md|headline-sm|title-lg|title-md|title-sm|body-lg|body-md|body-sm' | split: '|'
  unless allowed_sizes contains size
    assign size = 'headline-md'
  endunless
  assign color = color | default: settings.variant
  assign tag = tag | default: settings.tag
  assign stamp_class = 'mionas-stamp mionas-stamp--' | append: size | append: ' spacing-style'
-%}
{%- capture stamp_style -%}
  {%- if settings -%}{%- render 'spacing-style', settings: settings -%}{%- endif -%}
{%- endcapture -%}
{%- render 'mionas-text',
  content: content,
  variant: 'label',
  size: 'md',
  color: color,
  tag: tag,
  class: stamp_class,
  style: stamp_style,
  shopify_attributes: shopify_attributes
-%}

{% stylesheet %}
  /* Two classes deep on purpose, same as .text-role.mionas-price: a single-class selector would tie
     in specificity with the .text-role--label-md role underneath and leave the winner to bundle
     order. Color is deliberately absent -- it must come from the .text-role--<variant> class. */
  .text-role.mionas-stamp {
    font-family: var(--stamp-base-font-family);
    font-weight: var(--stamp-base-font-weight);
    letter-spacing: var(--stamp-base-letter-spacing);
    text-transform: var(--stamp-base-text-transform);
  }

  .text-role.mionas-stamp--display-lg {
    font-size: var(--stamp-size-display-lg-font-size);
    line-height: var(--stamp-size-display-lg-line-height);
  }

  .text-role.mionas-stamp--display-md {
    font-size: var(--stamp-size-display-md-font-size);
    line-height: var(--stamp-size-display-md-line-height);
  }

  .text-role.mionas-stamp--display-sm {
    font-size: var(--stamp-size-display-sm-font-size);
    line-height: var(--stamp-size-display-sm-line-height);
  }

  .text-role.mionas-stamp--headline-lg {
    font-size: var(--stamp-size-headline-lg-font-size);
    line-height: var(--stamp-size-headline-lg-line-height);
  }

  .text-role.mionas-stamp--headline-md {
    font-size: var(--stamp-size-headline-md-font-size);
    line-height: var(--stamp-size-headline-md-line-height);
  }

  .text-role.mionas-stamp--headline-sm {
    font-size: var(--stamp-size-headline-sm-font-size);
    line-height: var(--stamp-size-headline-sm-line-height);
  }

  .text-role.mionas-stamp--title-lg {
    font-size: var(--stamp-size-title-lg-font-size);
    line-height: var(--stamp-size-title-lg-line-height);
  }

  .text-role.mionas-stamp--title-md {
    font-size: var(--stamp-size-title-md-font-size);
    line-height: var(--stamp-size-title-md-line-height);
  }

  .text-role.mionas-stamp--title-sm {
    font-size: var(--stamp-size-title-sm-font-size);
    line-height: var(--stamp-size-title-sm-line-height);
  }

  .text-role.mionas-stamp--body-lg {
    font-size: var(--stamp-size-body-lg-font-size);
    line-height: var(--stamp-size-body-lg-line-height);
  }

  .text-role.mionas-stamp--body-md {
    font-size: var(--stamp-size-body-md-font-size);
    line-height: var(--stamp-size-body-md-line-height);
  }

  .text-role.mionas-stamp--body-sm {
    font-size: var(--stamp-size-body-sm-font-size);
    line-height: var(--stamp-size-body-sm-line-height);
  }
{% endstylesheet %}
