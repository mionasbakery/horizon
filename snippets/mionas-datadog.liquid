{% doc %}
  Loads Datadog RUM on the storefront, collecting only after the visitor allows analytics cookies.
{% enddoc %}
{%- liquid
  assign application_id = '3cfcdfbf-c542-4a44-984c-86817696fa70'
  assign client_token = 'pub59bd54eb9ba2058b8cefef1f0cf0ed78'
  assign remote_configuration_id = '924379f5-1d49-4513-911f-9f8187d8be0a'
  if request.host == shop.domain
    assign env = 'production'
  else
    assign env = 'preview'
  endif
  capture version
    render 'mionas-version'
  endcapture
  assign version = version | strip
-%}
{%- comment -%}
  layout/theme.liquid renders this after content_for_header, which defines the consent API; an upstream
  Horizon merge that rewrites the layout can drop that line. The checkout half lives in
  pixels/mionas-datadog.js, with the same application ID and client token.
{%- endcomment -%}
{%- unless request.design_mode -%}
  {%- if application_id != blank and client_token != blank -%}
    <script>
      (function (h, o, u, n, d) {
        h = h[d] = h[d] || { q: [], onReady: function (c) { h.q.push(c); } };
        d = o.createElement(u); d.async = 1; d.src = n;
        d.crossOrigin = 'anonymous';
        n = o.getElementsByTagName(u)[0]; n.parentNode.insertBefore(d, n);
      })(window, document, 'script', 'https://www.datadoghq-browser-agent.com/eu1/v7/datadog-rum-shopify.js', 'DD_RUM');

      (function () {
        var rum = window.DD_RUM;

        // Starts with collection off, so a visitor who never answers the cookie banner is never recorded.
        rum.onReady(function () {
          rum.init({
            applicationId: '{{ application_id }}',
            clientToken: '{{ client_token }}',
            site: 'datadoghq.eu',
            service: 'mionas-storefront',
            env: '{{ env }}',
            version: {{ version | json }},
            sessionSampleRate: 100,
            // Replay sampling, privacy level and interaction, resource and long-task tracking are set in
            // Datadog under RUM → the application → SDK Configuration.
            remoteConfiguration: { id: '{{ remote_configuration_id }}' },
            trackingConsent: 'not-granted',
          });
          {% if customer -%}
            var user = { id: '{{ customer.id }}', name: {{ customer.name | json }}, email: {{ customer.email | json }} };
            for (var key in user) if (!user[key]) delete user[key];
            rum.setUser(user);
          {%- else -%}
            rum.clearUser();
          {%- endif %}
          rum.startSessionReplayRecording();
        });

        // Consent arrives after the page's first events, which Datadog would drop while collection is
        // off, so actions wait here until the visitor allows analytics.
        var granted = false;
        var waiting = [];

        function send(name, context) {
          rum.onReady(function () {
            rum.addAction(name, context);
          });
        }

        function action(name, properties) {
          var context = { platform: 'web', locale: '{{ request.locale.iso_code }}' };
          for (var key in properties) if (properties[key] != null) context[key] = properties[key];
          if (granted) send(name, context);
          else waiting.push([name, context]);
        }

        function applyConsent() {
          granted = window.Shopify?.customerPrivacy?.analyticsProcessingAllowed?.() === true;
          rum.onReady(function () {
            rum.setTrackingConsent(granted ? 'granted' : 'not-granted');
          });
          if (!granted) return;
          waiting.forEach(function (entry) {
            send(entry[0], entry[1]);
          });
          waiting = [];
        }

        /** Shopify IDs arrive as gid://shopify/Product/123 or as numbers; the Mixpanel pixel sends the bare number. */
        function numericId(id) {
          return id == null ? undefined : String(id).split('/').pop();
        }

        /** One GA4 item. Shopify names a product's only variant "Default Title", which says nothing. */
        function item(fields) {
          if (fields.item_variant === 'Default Title') delete fields.item_variant;
          for (var key in fields) if (fields[key] == null) delete fields[key];
          return fields;
        }

        // GA4 names and parameters, as the Mixpanel pixel sends them, so all three tools answer the same questions.
        window.mionasDatadog = { action: action };

        document.addEventListener('shopify:product:view', function (event) {
          // Product cards fire this too; only the product page counts as viewing the product.
          if (event.context !== 'page') return;
          var variant = event.product?.selectedVariant;
          var price = variant ? Number(variant.price.amount) : undefined;
          action('view_item', {
            currency: variant?.price.currencyCode,
            value: price,
            items: [
              item({
                item_id: numericId(event.product?.id),
                item_name: event.product?.title,
                item_variant: variant?.title,
                price: price,
                quantity: 1,
              }),
            ],
          });
        });

        document.addEventListener('shopify:cart:lines-update', function (event) {
          if (event.action !== 'add') return;
          event.promise?.then(function (result) {
            if (!result?.cart || result.userErrors?.length) return;
            event.lines.forEach(function (line) {
              var variantId = numericId(line.merchandiseId);
              var added = (result.detail?.items || []).find(function (entry) {
                return String(entry.variant_id) === variantId;
              });
              var price = added ? added.price / 100 : undefined;
              action('add_to_cart', {
                currency: window.Shopify?.currency?.active,
                value: price == null ? undefined : Math.round(price * line.quantity * 100) / 100,
                items: [
                  item({
                    item_id: numericId(added?.product_id),
                    item_name: added?.product_title,
                    item_variant: added?.variant_title,
                    price: price,
                    quantity: line.quantity,
                  }),
                ],
              });
            });
          }, function () {});
        });

        window.Shopify?.loadFeatures?.([{ name: 'consent-tracking-api', version: '0.1' }], function (error) {
          if (!error) applyConsent();
        });
        document.addEventListener('visitorConsentCollected', function () {
          applyConsent();
        });
      })();
    </script>
  {%- endif -%}
{%- endunless -%}
