{%- doc -%}
  Renders the row at the foot of a form for a submit button and links to sit side by side.

  @param {string} content - The actions' markup, built with {% capture %} before rendering.
  @param {string} [class] - Extra classes.
  @param {string} [attributes] - Raw string appended to the wrapper tag.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system/src/react/FormActions/FormActions.tsx: `<Box direction="row" gap="sm">`
  plus one padding rule. Spends --space-sm for the gap (same token Box's gap="sm" resolves to) and
  --form-actions-base-padding for the start inset that lines the row up with the fields above it.
{%- endcomment -%}
{% liquid
  assign actions_classes = 'mionas-form-actions'
  if class
    assign actions_classes = actions_classes | append: ' ' | append: class
  endif
%}
<div class="{{ actions_classes }}" {{ attributes }}>{{ content }}</div>

{% stylesheet %}
  /* FormActions.module.css .root, plus the Box direction="row" gap="sm" it wraps. */
  .mionas-form-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-sm);
    padding-left: var(--form-actions-base-padding);
  }
{% endstylesheet %}
