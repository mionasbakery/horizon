{%- doc -%}
  Renders the breadcrumb trail <nav>, shared by the standalone section and the nested block.

  @param {string} home_label - Copy for the first crumb.
  @param {string} landmark_label - Accessible name for the nav landmark.
  @param {object} [menu] - Linklist to derive the hierarchy from. Falls back to navigation-menu.
{%- enddoc -%}
{%- comment -%}
  Shared by sections/mionas-breadcrumbs.liquid (standalone) and blocks/mionas-breadcrumbs.liquid
  (nested). Both callers own their wrapper and shopify_attributes; this snippet emits only the
  <nav> landmark. Mirrors the design-system Breadcrumbs + BreadcrumbLink components
  (../design-system/src/react/Breadcrumbs); no native Horizon file produces a breadcrumb trail, so
  this is a fork by necessity.

  home_label and landmark_label are required because {% render %} is an isolated scope -- routes,
  request, template and the resource objects resolve here as globals, but these two do not.

  Every crumb, including the current page, renders as a real <a> with aria-current="page" on the
  last one rather than swapping it for inert text -- see .cursor/rules/breadcrumb-accessibility.mdc.
  The one exception: a menu ancestor whose URL is the site root is a <span>, since Home already
  links there and two crumbs pointing at the same page is worse than one non-interactive label.
{%- endcomment -%}
{% liquid
  # page_title is the SEO title (merchant-edited, sometimes tag-suffixed), not the resource name.
  # Prefer the resource's own title and fall back to page_title only when there is no resource.
  assign current_title = page_title
  case template.name
    when 'collection'
      assign current_title = collection.title | default: page_title
    when 'product'
      assign current_title = product.title | default: page_title
    when 'article'
      assign current_title = article.title | default: page_title
    when 'blog'
      assign current_title = blog.title | default: page_title
    when 'page'
      assign current_title = page.title | default: page_title
  endcase

  # The trail follows the merchant's navigation menu so crumbs match the path a visitor actually
  # clicked. Menus nest at most three levels, so two nested loops cover every case with no
  # recursion. link.current is the exact match; child_active/child_current mark the active branch.
  #
  # link_list settings only accept "main-menu" or "footer" as a schema default, so the real
  # fallback lives here instead: navigation-menu, which sections/header-group.json renders.
  #
  # `== blank` rather than `.links.size == 0`: nil == 0 is false in Liquid, so a size check would
  # silently leave an unset menu nil and no crumb would ever match.
  if menu == blank
    assign menu = linklists['navigation-menu']
  endif
  assign menu_matched = false
  assign ancestor_1_title = blank
  assign ancestor_1_url = blank
  assign ancestor_2_title = blank
  assign ancestor_2_url = blank

  for link_1 in menu.links
    if link_1.current
      assign menu_matched = true
      break
    endif
    if link_1.child_active or link_1.child_current
      assign menu_matched = true
      assign ancestor_1_title = link_1.title
      assign ancestor_1_url = link_1.url
      for link_2 in link_1.links
        if link_2.current
          break
        endif
        if link_2.child_active or link_2.child_current
          assign ancestor_2_title = link_2.title
          assign ancestor_2_url = link_2.url
          break
        endif
      endfor
      break
    endif
  endfor
%}

<nav class="mionas-breadcrumbs" aria-label="{{ landmark_label }}">
  <ol class="mionas-breadcrumbs__list">
    <li class="mionas-breadcrumbs__item">
      <a href="{{ routes.root_url }}" class="mionas-breadcrumbs__link">{{ home_label }}</a>
      <span class="mionas-breadcrumbs__separator" aria-hidden="true">&rsaquo;</span>
    </li>

    {%- comment -%}
      Menu ancestors and the resource crumb are additive, not alternatives: a product opened from
      a collection makes the menu's collection branch active, but the collection crumb itself
      still has to come from `collection`. Treating them as either/or would drop a crumb.
    {%- endcomment -%}
    {%- if menu_matched -%}
      {%- if ancestor_1_title != blank -%}
        <li class="mionas-breadcrumbs__item">
          {%- if ancestor_1_url == routes.root_url -%}
            <span class="mionas-breadcrumbs__text">{{ ancestor_1_title }}</span>
          {%- else -%}
            <a href="{{ ancestor_1_url }}" class="mionas-breadcrumbs__link">{{ ancestor_1_title }}</a>
          {%- endif -%}
          <span class="mionas-breadcrumbs__separator" aria-hidden="true">&rsaquo;</span>
        </li>
      {%- endif -%}
      {%- if ancestor_2_title != blank -%}
        <li class="mionas-breadcrumbs__item">
          {%- if ancestor_2_url == routes.root_url -%}
            <span class="mionas-breadcrumbs__text">{{ ancestor_2_title }}</span>
          {%- else -%}
            <a href="{{ ancestor_2_url }}" class="mionas-breadcrumbs__link">{{ ancestor_2_title }}</a>
          {%- endif -%}
          <span class="mionas-breadcrumbs__separator" aria-hidden="true">&rsaquo;</span>
        </li>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      The resource crumb: the collection a product was reached through, or an article's blog.
      Skipped when a menu ancestor already links there, so the same page never appears twice.
    {%- endcomment -%}
    {%- case template.name -%}
      {%- when 'product' -%}
        {%- if collection != blank and collection.url != ancestor_1_url and collection.url != ancestor_2_url -%}
          <li class="mionas-breadcrumbs__item">
            <a href="{{ collection.url }}" class="mionas-breadcrumbs__link">{{ collection.title }}</a>
            <span class="mionas-breadcrumbs__separator" aria-hidden="true">&rsaquo;</span>
          </li>
        {%- endif -%}
      {%- when 'article' -%}
        {%- if blog != blank and blog.url != ancestor_1_url and blog.url != ancestor_2_url -%}
          <li class="mionas-breadcrumbs__item">
            <a href="{{ blog.url }}" class="mionas-breadcrumbs__link">{{ blog.title }}</a>
            <span class="mionas-breadcrumbs__separator" aria-hidden="true">&rsaquo;</span>
          </li>
        {%- endif -%}
    {%- endcase -%}

    <li class="mionas-breadcrumbs__item">
      <a
        href="{{ request.path }}"
        class="mionas-breadcrumbs__link"
        aria-current="page"
      >{{ current_title }}</a>
    </li>
  </ol>
</nav>

{% stylesheet %}
  .mionas-breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--breadcrumbs-base-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mionas-breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: var(--breadcrumbs-base-gap);
  }

  /* Family is --font-family-archivo, the design system's body primitive, repointed at the theme's
     loaded body font by snippets/design-system-bridge.liquid. Breadcrumbs.module.css sets no
     family of its own -- BreadcrumbLink inherits -- so this spends the primitive rather than
     borrowing Link's component token for an element that isn't a Link. */
  .mionas-breadcrumbs__link,
  .mionas-breadcrumbs__text {
    font-family: var(--font-family-archivo);
    font-weight: var(--link-base-font-weight);
    font-size: var(--link-size-sm-font-size);
    text-decoration: none;
    color: var(--breadcrumb-link-base-foreground);
  }

  .mionas-breadcrumbs__link:hover {
    text-decoration: underline;
    color: var(--breadcrumb-link-state-hover-foreground);
  }

  .mionas-breadcrumbs__link[aria-current='page'] {
    color: var(--breadcrumb-link-state-active-foreground);
    font-weight: var(--breadcrumb-link-state-active-font-weight);
  }

  /* Mirrors Breadcrumbs.tsx rendering the separator as <Text variant="secondary">: only a colour
     token, no font-size of its own -- the glyph inherits whatever size surrounds it. */
  .mionas-breadcrumbs__separator {
    color: var(--text-color-secondary);
  }
{% endstylesheet %}
