{%- doc -%}
  The Mionas form submit button, a full-width Button, and an optional note below it, rendered as siblings.

  @param {string} label - Button text
  @param {string} [note] - Secondary line below the button, centered. Blank renders nothing.
  @param {string} [variant] - A Button variant, see snippets/mionas-button-class.liquid. Defaults to primary.
  @param {string} [size] - sm, md or lg. Defaults to md.
  @param {string} [class] - Extra classes on the button
{%- enddoc -%}

{%- comment -%}
  A <button type="submit"> wearing the Button classes, the way Button.tsx renders a <button> by
  default. The mionas-submit-button class stays as a hook for the forms' own width rules.

  blocks/corporate-quote-form.liquid deliberately does not use this snippet -- it uses Horizon's
  native `.button` class, and repointing it here would restyle a live B2B page.

  Renders the button and the note as siblings with no wrapper, so the caller's own flex column
  (snippets/mionas-form.liquid, or the block's card) provides the gap between them.
{%- endcomment -%}
{%- liquid
  capture submit_classes
    render 'mionas-button-class', variant: variant, size: size, full_width: true, prefix: 'mionas-submit-button'
  endcapture
  if class
    assign submit_classes = submit_classes | append: ' ' | append: class
  endif
-%}
<button type="submit" class="{{ submit_classes }}">{{- label -}}</button>
{%- if note != blank -%}
  {%- render 'mionas-text', content: note, variant: 'label', color: 'secondary', class: 'mionas-submit-button__note' -%}
{%- endif -%}

{% stylesheet %}
  .mionas-submit-button__note {
    text-align: center;
  }
{% endstylesheet %}
