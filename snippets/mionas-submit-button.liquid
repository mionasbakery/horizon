{%- doc -%}
  The Mionas form submit button and an optional note below it, rendered as siblings.

  @param {string} label - Button text
  @param {string} [note] - Secondary line below the button, centered. Blank renders nothing.
  @param {string} [variant] - 'outline' switches to a transparent/bordered look; anything else keeps the filled primary look
  @param {string} [size] - 'sm', 'md' or 'lg', spending --button-size-<size>-*. Defaults to 'md'.
  @param {string} [class] - Extra classes on the button
{%- enddoc -%}

{%- comment -%}
  There is no design-system Button component to mirror for a <button>: ../design-system's Button
  renders an anchor, and so does blocks/mionas-button.liquid. This reproduces the
  primary/md/full-width Button look by spending the same --button-* tokens directly.

  blocks/corporate-quote-form.liquid deliberately does not use this snippet -- it uses Horizon's
  native `.button` class, and repointing it here would restyle a live B2B page.

  Renders the button and the note as siblings with no wrapper, so the caller's own flex column
  (snippets/mionas-form.liquid, or the block's card) provides the gap between them.
{%- endcomment -%}
{% liquid
  assign submit_classes = 'mionas-submit-button'
  if variant == 'outline'
    assign submit_classes = submit_classes | append: ' mionas-submit-button--outline'
  endif
  if size == 'sm' or size == 'lg'
    assign submit_classes = submit_classes | append: ' mionas-submit-button--' | append: size
  endif
  if class
    assign submit_classes = submit_classes | append: ' ' | append: class
  endif
%}
<button type="submit" class="{{ submit_classes }}">{{- label -}}</button>
{%- if note != blank -%}
  <p class="mionas-submit-button__note">{{ note }}</p>
{%- endif -%}

{% stylesheet %}
  /* Reproduces mionas-button's primary/md/full-width look -- see header comment. */
  .mionas-submit-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: var(--button-size-md-height);
    padding: 0 var(--button-size-md-padding);
    border: 1.5px solid transparent;
    border-radius: var(--button-base-radius);
    background: var(--button-primary-background);
    color: var(--button-primary-foreground);
    font-family: var(--font-family-archivo);
    font-size: var(--button-size-md-font-size);
    font-weight: var(--button-base-font-weight);
    cursor: pointer;
  }

  .mionas-submit-button:active {
    transform: scale(var(--button-state-pressed-scale));
    opacity: var(--button-state-pressed-opacity);
  }

  /* Additive outline variant -- see blocks/mionas-contact-form.liquid's submit_variant setting.
     Existing callers pass no `variant` and keep the filled .mionas-submit-button look above. */
  .mionas-submit-button--outline {
    background: transparent;
    color: var(--button-outline-foreground);
    box-shadow: var(--button-outline-shadow);
  }

  /* Additive size variants -- default (no modifier class) stays --button-size-md-*, matching
     every existing caller. */
  .mionas-submit-button--sm {
    height: var(--button-size-sm-height);
    padding: 0 var(--button-size-sm-padding);
    font-size: var(--button-size-sm-font-size);
  }

  .mionas-submit-button--lg {
    height: var(--button-size-lg-height);
    padding: 0 var(--button-size-lg-padding);
    font-size: var(--button-size-lg-font-size);
  }

  /* Secondary body text, so this spends Card's description token rather than a form-label one. */
  .mionas-submit-button__note {
    margin: 0;
    color: var(--card-description-foreground);
    font-size: var(--font-size-13);
    text-align: center;
  }
{% endstylesheet %}
