{%- doc -%}
  Renders the trigger that opens the newsletter dialog by itself after the visitor's idle time. It has no visible content; assets/mionas-newsletter-trigger.js runs it.

  @param {string} dialog_id - The id of the dialog it opens.
  @param {object} settings - The section settings: idle_seconds, reset_on_press, reset_on_scroll,
    pause_while_typing, pause_while_hidden, pause_for_cart and reshow_days.
{%- enddoc -%}

<mionas-newsletter-trigger
  for="{{ dialog_id }}"
  data-idle="{{ settings.idle_seconds }}"
  data-reset-on-press="{{ settings.reset_on_press }}"
  data-reset-on-scroll="{{ settings.reset_on_scroll }}"
  data-pause-while-typing="{{ settings.pause_while_typing }}"
  data-pause-while-hidden="{{ settings.pause_while_hidden }}"
  data-pause-for-cart="{{ settings.pause_for_cart }}"
  data-reshow-days="{{ settings.reshow_days }}"
  hidden
></mionas-newsletter-trigger>
