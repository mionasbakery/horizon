{%- doc -%}
  CSS-only layout patch for templates/page.contacto.json, rendered there via a "Custom Liquid"
  block (`{% render 'contacto-page-bridge' %}`). Takes no params. `{% style %}` output isn't
  scoped to the block or section it's rendered from, so every rule is scoped through the marker
  div below instead: `:has(.contacto-layout-scope)` stands in for "the section this bridge was
  placed in". `.mionas-card` and `.mionas-contact-form` get the same scoping even though they're
  page-unique today, since both are generic Mionas components rather than page-specific classes.
{%- enddoc -%}
<div class="contacto-layout-scope" hidden></div>
{% style %}
  /* Native `width: fill` is `flex: 1 1 0%`, and Horizon hardcodes `flex-wrap: nowrap` above
     749px, so this row otherwise squeezes both columns instead of wrapping. */
  [data-testid='section-content']:has(.contacto-layout-scope) > .group-block > .group-block-content {
    flex-wrap: wrap;
    /* Native `vertical_alignment: center` visibly centers the two columns once they're
       different heights; `stretch` top-aligns them and grows the shorter one to match. */
    align-items: stretch;
  }

  /* Minimum comfortable width per column before the row wraps. `min(<n>px, 100%)` so a phone
     narrower than the floor gets 100% width instead of being forced wider than the screen. */
  [data-testid='section-content']:has(.contacto-layout-scope) > .group-block > .group-block-content > .group-block--width-fill:first-child {
    min-width: min(480px, 100%);
  }

  [data-testid='section-content']:has(.contacto-layout-scope) > .group-block > .group-block-content > .group-block--width-fill:last-child {
    min-width: min(340px, 100%);
  }

  /* A wrapped flex item's `height: fill` (100%) resolves against the combined height of every
     wrapped line, not just its own -- without this the shorter column stretches to match the
     taller one's total and leaves empty space beneath it. */
  [data-testid='section-content']:has(.contacto-layout-scope) > .group-block > .group-block-content > .group-block--width-fill {
    height: auto;
  }

  /* :has(> .mionas-card), not a bare descendant :has(): the outer "info" column also has
     .mionas-card among its descendants (as grandchildren, through this row), so a descendant
     match would also flip info itself into row mode. */
  [data-testid='section-content']:has(.contacto-layout-scope) .group-block-content:has(> .mionas-card) {
    flex-direction: column;
  }

  /* Cards default to height: fill, which in column mode stretches them to share the column's
     height instead of sizing to content. min-width is the same floor in both states (column
     below 1300px, row at/above it), capped at (340px - 12px gap) / 2 so two cards side by side
     in row mode can't outgrow the info column's own 340px floor and overflow it. */
  [data-testid='section-content']:has(.contacto-layout-scope) .group-block-content:has(> .mionas-card) .mionas-card {
    height: auto;
    flex: 0 0 auto;
    min-width: min(160px, 100%);
  }

  /* Each card's own width: 100% means 100% of the row; two children at 100% each overlap
     instead of sitting side by side, so row mode needs an explicit half-width override. */
  @media (min-width: 1300px) {
    [data-testid='section-content']:has(.contacto-layout-scope) .group-block-content:has(> .mionas-card) {
      flex-direction: row;
    }

    [data-testid='section-content']:has(.contacto-layout-scope) .group-block-content:has(> .mionas-card) .mionas-card {
      width: calc((100% - 12px) / 2);
      flex: 0 0 calc((100% - 12px) / 2);
    }
  }

  /* Address and day/hours text must not line-wrap regardless of card width. */
  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-card p.text-role:has(br) {
    white-space: nowrap;
  }

  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-card span.text-role {
    white-space: nowrap;
  }

  /* Contact form grows to the column's full height (align-items: stretch above); this chain
     passes that height down through each wrapper so it lands in the message field instead of
     as blank space below the submit button. :has(textarea), not :last-child, so it still
     targets the message row if fields are ever reordered. resize: none since a manually
     resized textarea would fight the auto-grow. */
  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-contact-form > form {
    height: 100%;
  }

  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-contact-form > form > .mionas-form {
    flex: 1;
  }

  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-contact-form .mionas-form > .mionas-contact-form__surface {
    flex: 1;
  }

  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-contact-form__surface .mionas-form-field:has(textarea) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* field-sizing: content grows the box with typed input past the flex-filled baseline above,
     no JS. Chromium-only for now -- Safari/Firefox just keep the static baseline height, no
     breakage. min-height keeps its own rows="5" floor even when the flex-filled baseline would
     otherwise be shorter (e.g. once the form column is short on mobile). */
  [data-testid='section-content']:has(.contacto-layout-scope) .mionas-contact-form__surface .mionas-form-field:has(textarea) textarea {
    flex: 1;
    height: 100%;
    min-height: 5lh;
    resize: none;
    field-sizing: content;
  }
{% endstyle %}
