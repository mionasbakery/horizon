{%- doc -%}
  Renders the widget that opens a Mionas popup: a folded page corner fixed to a corner of the screen.
  It ships hidden; a script shows it.

  @param {string} element - The custom element tag: mionas-popup-widget, or the tag of a subclass.
  @param {string} popup_id - The id of the popup it opens.
  @param {string} section_id - The id of the rendering section, for the theme editor.
  @param {string} position - left or right.
  @param {string} vertical - bottom or top, on desktop; phones always use a bottom corner.
  @param {string} color - The fold's fill: accent, primary or accent-inverse. The caller colours the content to match.
  @param {string} label - The accessible name of its open button.
  @param {string} content - The visible content of its open button.
  @param {string} [attributes] - Extra attributes for the custom element.
{%- enddoc -%}

<{{ element }}
  for="{{ popup_id }}"
  class="mionas-popup-widget mionas-popup-widget--{{ position }} mionas-popup-widget--{{ vertical }} mionas-popup-widget--{{ color }}"
  data-section-id="{{ section_id }}"
  {{ attributes }}
  hidden
>
  <button
    type="button"
    class="mionas-popup-widget__open"
    aria-haspopup="dialog"
    aria-controls="{{ popup_id }}"
    aria-label="{{ label }}"
    on:click="/openPopup"
  >
    <span
      class="mionas-popup-widget__body"
      aria-hidden="true"
    >
      {{- content -}}
    </span>
  </button>
</{{ element }}>

{% stylesheet %}
  /* A folded page corner: the open button is clipped to the triangle. The corner variables below
     place it; the bottom left corner is the default. */
  .mionas-popup-widget {
    /* The design system has no size for this; 152px is the smallest fold that keeps two title-size
       stamp lines inside it. */
    --mionas-popup-widget-size: 152px;
    /* How far the text sits from the fold's middle toward the corner, so its gap to the fold edge
       matches its gap to the screen edges. Change it together with the size or the text size. */
    --mionas-popup-widget-inset: 21px;
    --mionas-popup-widget-clip: polygon(0 0, 0 100%, 100% 100%);
    --mionas-popup-widget-turn: 45deg;
    --mionas-popup-widget-toward: top right;
    --mionas-popup-widget-shift-x: calc(-1 * var(--mionas-popup-widget-inset));
    --mionas-popup-widget-shift-y: var(--mionas-popup-widget-inset);
    /* Scaling the fold from nothing needs longer than the design system's durations: at 220ms each
       60fps frame moved it up to a third of its size, which reads as a stutter. */
    --mionas-popup-widget-speed-in: 500ms;
    --mionas-popup-widget-easing-in: var(--ease-out-cubic);
    --mionas-popup-widget-speed-out: 300ms;
    --mionas-popup-widget-easing-out: var(--animation-easing);

    position: fixed;
    bottom: 0;
    left: 0;
    z-index: var(--layer-sticky);
    /* Only the clipped button takes the pointer, so the empty half of the square leaves the page
       under it clickable and hover starts on the fold itself. */
    pointer-events: none;
    width: var(--mionas-popup-widget-size);
    height: var(--mionas-popup-widget-size);
    transform-origin: left bottom;
    filter: drop-shadow(var(--shadow-md));
    transition:
      transform var(--duration-base) var(--easing-spring),
      filter var(--duration-base) var(--easing-standard);
  }

  .mionas-popup-widget--right {
    --mionas-popup-widget-clip: polygon(100% 0, 100% 100%, 0 100%);
    --mionas-popup-widget-turn: -45deg;
    --mionas-popup-widget-toward: top left;
    --mionas-popup-widget-shift-x: var(--mionas-popup-widget-inset);

    right: 0;
    left: auto;
    transform-origin: right bottom;
  }

  /* Phones always keep the fold in a bottom corner. */
  @media screen and (min-width: 750px) {
    /* Under the header and announcement bar; header.js keeps --header-group-height current after load. */
    .mionas-popup-widget--top {
      --mionas-popup-widget-clip: polygon(0 0, 100% 0, 0 100%);
      --mionas-popup-widget-turn: -45deg;
      --mionas-popup-widget-toward: bottom right;
      --mionas-popup-widget-shift-y: calc(-1 * var(--mionas-popup-widget-inset));

      top: var(--header-group-height, 0px);
      bottom: auto;
      transform-origin: left top;
    }

    .mionas-popup-widget--top.mionas-popup-widget--right {
      --mionas-popup-widget-clip: polygon(0 0, 100% 0, 100% 100%);
      --mionas-popup-widget-turn: 45deg;
      --mionas-popup-widget-toward: bottom left;

      transform-origin: right top;
    }
  }

  .mionas-popup-widget--accent {
    --mionas-popup-widget-fill: var(--brand-accent);
  }

  .mionas-popup-widget--primary {
    --mionas-popup-widget-fill: var(--brand-primary);
  }

  .mionas-popup-widget--accent-inverse {
    --mionas-popup-widget-fill: var(--brand-accent-inverse);
  }

  /* The script writes the widget's height, 0 while hidden, so the footer can scroll clear of it. The
     room goes to the last footer section, not the body, so the footer's own background shows behind
     the fold; this needs the widget's section to stay last in the footer group. */
  .shopify-section:has(+ .shopify-section:last-child .mionas-popup-widget--bottom) {
    padding-block-end: var(--mionas-popup-widget-height, 0px);
  }

  @media screen and (max-width: 749px) {
    .shopify-section:has(+ .shopify-section:last-child .mionas-popup-widget) {
      padding-block-end: var(--mionas-popup-widget-height, 0px);
    }
  }

  .mionas-popup-widget[hidden] {
    display: none;
  }

  /* Hidden but still laid out, so the page padding keeps its height under the open popup. */
  .mionas-popup-widget[data-covered] {
    visibility: hidden;
  }

  .mionas-popup-widget__open {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    /* The lighter band along the long edge reads as the crease; the gradient runs toward that edge. */
    background: linear-gradient(
      to var(--mionas-popup-widget-toward),
      var(--mionas-popup-widget-fill) 70%,
      color-mix(in srgb, var(--mionas-popup-widget-fill), white 12%) 70%
    );
    clip-path: var(--mionas-popup-widget-clip);
    cursor: pointer;
    pointer-events: auto;
  }

  .mionas-popup-widget__body {
    position: absolute;
    top: calc(50% + var(--mionas-popup-widget-shift-y));
    left: calc(50% + var(--mionas-popup-widget-shift-x));
    display: flex;
    flex-direction: column;
    align-items: center;
    white-space: nowrap;
    transform: translate(-50%, -50%) rotate(var(--mionas-popup-widget-turn));
  }

  @media (hover: hover) {
    .mionas-popup-widget:hover {
      transform: scale(1.1);
      filter: drop-shadow(var(--shadow-lg));
    }
  }

  /* The clip hides an outline on the button itself, so the ring goes on the widget's square. */
  .mionas-popup-widget:has(.mionas-popup-widget__open:focus-visible) {
    outline: var(--focus-outline-width) solid var(--border-focus);
    outline-offset: var(--space-2xs);
    filter: drop-shadow(var(--shadow-lg));
  }

  .mionas-popup-widget__open:focus-visible {
    outline: none;
  }

  .mionas-popup-widget--unfolding {
    animation: mionas-popup-widget-unfold var(--mionas-popup-widget-speed-in) var(--mionas-popup-widget-easing-in);
  }

  .mionas-popup-widget--folding {
    animation: mionas-popup-widget-fold var(--mionas-popup-widget-speed-out) var(--mionas-popup-widget-easing-out)
      forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .mionas-popup-widget--unfolding {
      animation-name: mionas-popup-widget-fade-in;
    }

    .mionas-popup-widget--folding {
      animation-name: mionas-popup-widget-fade-out;
    }

    .mionas-popup-widget.mionas-popup-widget {
      transform: none;
    }
  }

  @keyframes mionas-popup-widget-unfold {
    from {
      transform: scale(0);
    }
    to {
      transform: none;
    }
  }

  @keyframes mionas-popup-widget-fold {
    to {
      transform: scale(0);
    }
  }

  @keyframes mionas-popup-widget-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes mionas-popup-widget-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
{% endstylesheet %}
