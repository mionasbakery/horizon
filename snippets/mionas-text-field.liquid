{%- doc -%}
  A labelled text input (or textarea) inside an underline field.

  @param {string} label - Label copy
  @param {string} name - The form field name, e.g. 'contact[email]'
  @param {string} id - Required in practice; associates the label with the control
  @param {string} [type] - Defaults to 'text'
  @param {string} [value] - Prefilled value
  @param {string} [placeholder] - Placeholder text
  @param {number} [rows] - Renders a textarea with this many rows instead of an input
  @param {boolean} [required] - Defaults to true
  @param {boolean} [disabled] - Pass true to disable and dim the control
  @param {string} [error] - Message string; switches the field to error colours and autofocuses it
  @param {string} [autocomplete] - Passed through when set
  @param {string} [spellcheck] - Passed through when set
  @param {string} [autocapitalize] - Passed through when set
  @param {string} [inputmode] - Passed through when set
  @param {string} [pattern] - Passed through when set; email fields get a stricter default
  @param {string} [optional_text] - Forwarded to the label
  @param {string} [attributes] - Raw string appended to the control tag
  @param {string} [class] - Extra classes on the field wrapper
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/TextField/TextField.tsx.

  The input draws no border or background of its own; the underline belongs to
  snippets/mionas-form-field.liquid, which wraps this snippet. A border here would double up.

  `rows` renders a <textarea> instead of an <input>. This is a theme extension -- the design system
  has no Textarea component -- so it reuses the input's styling and adds only `resize: vertical`.

  `required` uses an explicit `== false` check because Liquid's `default` filter treats false as
  empty and would flip it back to true.

  `error` autofocuses the control (not the message) so a failed Shopify form re-render doesn't
  strand the user at the top of the page with no indication anything went wrong; aria-describedby
  still announces the message. Only one field per form should pass `error`, since the browser only
  honours the first autofocus in document order.

  `pattern` defaults to a stricter email check when `type` is 'email' -- see the liquid tag below.

  Fonts: --text-field-base-font-family resolves through --font-family-archivo, which
  snippets/design-system-bridge.liquid repoints at the theme's loaded body font.
{%- endcomment -%}
{% liquid
  assign field_type = type | default: 'text'
  assign field_id = id
  assign field_error_id = field_id | append: '-error'

  assign field_is_required = true
  if required == false
    assign field_is_required = false
  endif

  assign field_has_error = false
  if error != blank
    assign field_has_error = true
  endif

  # type="email" alone accepts things like "a@b" per the HTML spec, which only get caught after a
  # full round trip to Shopify. Default to a stricter pattern (skipped if the caller passes its own)
  # so the common cases fail fast in the browser instead.
  assign field_pattern = pattern
  if field_pattern == blank and field_type == 'email'
    assign field_pattern = '[^@\s]+@[^@\s]+\.[^@\s]{2,}'
  endif
%}
{%- capture text_field_control -%}
  {%- if rows -%}
    <textarea
      class="mionas-text-field__input mionas-text-field__input--textarea"
      id="{{ field_id }}"
      name="{{ name }}"
      rows="{{ rows }}"
      {% if placeholder != blank %}placeholder="{{ placeholder }}"{% endif %}
      {% if field_is_required %}required aria-required="true"{% endif %}
      {% if disabled %}disabled{% endif %}
      {% if field_has_error %}aria-invalid="true" aria-describedby="{{ field_error_id }}" autofocus{% endif %}
      {% if autocomplete != blank %}autocomplete="{{ autocomplete }}"{% endif %}
      {% if spellcheck != blank %}spellcheck="{{ spellcheck }}"{% endif %}
      {% if autocapitalize != blank %}autocapitalize="{{ autocapitalize }}"{% endif %}
      {{ attributes }}
    >{{- value -}}</textarea>
  {%- else -%}
    <input
      class="mionas-text-field__input"
      id="{{ field_id }}"
      name="{{ name }}"
      type="{{ field_type }}"
      value="{{ value }}"
      {% if placeholder != blank %}placeholder="{{ placeholder }}"{% endif %}
      {% if field_is_required %}required aria-required="true"{% endif %}
      {% if disabled %}disabled{% endif %}
      {% if field_has_error %}aria-invalid="true" aria-describedby="{{ field_error_id }}" autofocus{% endif %}
      {% if autocomplete != blank %}autocomplete="{{ autocomplete }}"{% endif %}
      {% if spellcheck != blank %}spellcheck="{{ spellcheck }}"{% endif %}
      {% if autocapitalize != blank %}autocapitalize="{{ autocapitalize }}"{% endif %}
      {% if inputmode != blank %}inputmode="{{ inputmode }}"{% endif %}
      {% if field_pattern != blank %}pattern="{{ field_pattern }}"{% endif %}
      {{ attributes }}
    >
  {%- endif -%}
{%- endcapture -%}
{%- render 'mionas-form-field',
  control: text_field_control,
  label: label,
  for: field_id,
  error: error,
  error_id: field_error_id,
  required: required,
  optional_text: optional_text,
  class: class
-%}

{% stylesheet %}
  /* `padding: 0` then `padding-left` isn't redundant -- browsers give inputs their own default
     padding, and the design only wants the start inset. */
  .mionas-text-field__input {
    appearance: none;
    width: 100%;
    border: none;
    outline: none;
    box-shadow: none;
    background: transparent;
    padding: 0;
    padding-left: var(--text-field-base-padding);
    color: var(--text-field-base-foreground);
    font-family: var(--text-field-base-font-family);
    font-size: var(--text-field-base-font-size);
    line-height: var(--text-field-base-line-height);
  }

  .mionas-text-field__input:disabled {
    opacity: var(--text-field-state-disabled-opacity);
  }

  /* Theme extension, no design-system counterpart -- see the textarea note in the header comment. */
  .mionas-text-field__input--textarea {
    resize: vertical;
  }
{% endstylesheet %}
