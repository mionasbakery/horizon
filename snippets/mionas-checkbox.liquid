{%- doc -%}
  Renders a checkbox with a visually hidden native input, a drawn box, an optional label, and an
  optional error message.

  @param {string} name - The form field name (required)
  @param {string} id - The input id, also used to associate the label and error (required)
  @param {string} [label] - Text beside the box
  @param {string} [value] - The submitted value when checked (default: 'on')
  @param {boolean} [checked] - Render pre-checked
  @param {boolean} [disabled] - Disable and dim the control
  @param {string} [error] - Error message rendered underneath via mionas-form-error
  @param {boolean} [required] - Mark the field required (default: false)
  @param {string} [class] - Extra classes on the wrapper
  @param {string} [attributes] - Raw string appended to the input tag
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Checkbox/Checkbox.tsx: a visually hidden native checkbox, a
  drawn box standing in for it, an optional text label, and an optional error underneath.

  The real <input> is clipped, not hidden with `display: none`/`visibility: hidden` -- either would
  drop it from the focus order and accessibility tree, breaking it for keyboard and screen-reader
  users.

  One deliberate divergence from Checkbox.tsx: React swaps a `.checked` class on state change, but
  Liquid renders once and never sees the box get ticked. So the checkmark and checked colours are
  driven by `:checked + .mionas-checkbox__box` in CSS instead, with the svg always in the DOM.
{%- endcomment -%}
{% liquid
  assign checkbox_value = value | default: 'on'
  assign checkbox_error_id = id | append: '-error'

  assign checkbox_classes = 'mionas-checkbox'
  if class
    assign checkbox_classes = checkbox_classes | append: ' ' | append: class
  endif

  assign checkbox_row_classes = 'mionas-checkbox__row'
  if disabled
    assign checkbox_row_classes = checkbox_row_classes | append: ' mionas-checkbox__row--disabled'
  endif
%}
<div class="{{ checkbox_classes }}">
  <div class="{{ checkbox_row_classes }}">
    <input
      class="mionas-checkbox__input"
      type="checkbox"
      id="{{ id }}"
      name="{{ name }}"
      value="{{ checkbox_value }}"
      {% if checked %}checked{% endif %}
      {% if disabled %}disabled{% endif %}
      {% if required %}required aria-required="true"{% endif %}
      {% if error != blank %}aria-invalid="true" aria-describedby="{{ checkbox_error_id }}"{% endif %}
      {{ attributes }}
    >
    <label class="mionas-checkbox__box" for="{{ id }}" aria-hidden="true">
      <svg class="mionas-checkbox__checkmark" viewBox="0 0 16 16" focusable="false">
        <path
          d="M3 8.5L6.5 12L13 4.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </label>
    {%- if label != blank -%}
      <label class="mionas-checkbox__label" for="{{ id }}">{{ label }}</label>
    {%- endif -%}
  </div>
  {%- render 'mionas-form-error', message: error, id: checkbox_error_id -%}
</div>

{% stylesheet %}
  /* Checkbox.module.css .root */
  .mionas-checkbox {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--checkbox-base-padding);
  }

  /* .row -- the start padding lines the box up with the text of the fields above it, which are
     themselves inset by --text-field-base-padding. */
  .mionas-checkbox__row {
    display: flex;
    align-items: center;
    gap: var(--checkbox-row-padding);
    padding-left: var(--checkbox-start-padding);
  }

  .mionas-checkbox__row--disabled {
    opacity: var(--checkbox-state-disabled-opacity);
  }

  /* .input -- clipped, not hidden. See the header comment. */
  .mionas-checkbox__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* .box */
  .mionas-checkbox__box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--checkbox-base-size);
    height: var(--checkbox-base-size);
    border-radius: var(--checkbox-base-radius);
    border-width: var(--checkbox-base-border-width);
    border-style: solid;
    border-color: var(--checkbox-base-border-color);
    background: var(--checkbox-base-background);
    cursor: pointer;
  }

  /* .checked, reached from the input's own state rather than a class Liquid can't update. */
  .mionas-checkbox__input:checked + .mionas-checkbox__box {
    background: var(--checkbox-checked-background);
    border-color: var(--checkbox-checked-border-color);
    color: var(--checkbox-checked-foreground);
  }

  /* .checkmark. Always present so the tick can appear on :checked without JavaScript; hidden rather
     than absent so no layout inside the box shifts when it appears. */
  .mionas-checkbox__checkmark {
    width: 70%;
    height: 70%;
    opacity: 0;
  }

  .mionas-checkbox__input:checked + .mionas-checkbox__box .mionas-checkbox__checkmark {
    opacity: 1;
  }

  /* :focus-visible on the clipped input, projected onto the drawn box -- the only focus ring the
     user can actually see, since the input itself is 1px and off-screen. */
  .mionas-checkbox__input:focus-visible + .mionas-checkbox__box {
    outline: 2px solid var(--checkbox-state-focused-border-color);
    outline-offset: 2px;
  }

  /* .label -- Checkbox.tsx renders this as <Text role="body">, not role="label" like FormLabel. */
  .mionas-checkbox__label {
    cursor: pointer;
    font-family: var(--font-family-archivo);
    font-size: var(--text-role-body-md-font-size);
    line-height: var(--text-role-body-md-line-height);
    font-weight: var(--text-role-body-md-font-weight);
    letter-spacing: var(--text-role-body-md-letter-spacing);
  }
{% endstylesheet %}
