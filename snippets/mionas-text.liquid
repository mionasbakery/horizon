{%- doc -%}
  Renders a single text node at one of ../design-system/src/react/Text/Text.tsx's roles and colour
  variants. Extracted from blocks/mionas-text.liquid so that block is not the only way to spend the
  role vocabulary: blocks/mionas-price.liquid renders its dynamic product copy through here instead
  of restating --text-role-* by hand, which is how it drifted out of step with the roles in the
  first place.

  The .text-role CSS lives in this snippet's stylesheet tag. Shopify ships only the stylesheet CSS
  of files a page renders, so the rules reach every page that renders this snippet, whichever
  block or section calls it.

  CALLERS MUST SANITISE `content` THEMSELVES. This snippet outputs it unfiltered, because
  mionas-text passes richtext that has already been flattened to inline HTML and the product blocks
  pass values from `| money` and product.title. Nothing here escapes; nothing here strips tags.

  @param {string} content - The text to render. Emitted unfiltered; see above.
  @param {string} [variant] - A Text.tsx band: display, headline, title, body, label. Defaults to body.
  @param {string} [size] - A Text.tsx size within the band: lg, md, sm. Defaults to md.
  @param {string} [color] - A colour variant: default, primary, inverse-primary, inverse-primary-muted, accent, accent-inverse, tint. Defaults to default.
  @param {string} [tag] - p, span, div or h1-h6. Anything else falls back to p.
  @param {string} [class] - Extra classes for the caller's own box (padding, weight overrides).
  @param {string} [style] - Inline declarations for the caller's own box. Emitted unfiltered like `content`, but unlike `content` it is NOT for caller HTML -- it exists so a block can pass its own inline CSS, such as snippets/spacing-style.liquid output (the --padding-* custom properties behind Horizon's `spacing-style` class) or a per-instance custom property the caller already validated the shape of (blocks/mionas-product-badges.liquid's per-badge accent colors, sourced from a Shopify `color`-type field so they are guaranteed "#rrggbb" or blank). Never pass merchant free text through here.
  @param {string} [heading_level] - When set, emits role="heading" aria-level="<n>" instead of a real <h*>, matching snippets/text.liquid's product-title branch.
  @param {string} [shopify_attributes] - The caller's block.shopify_attributes, so the theme editor can still select the block.

  @example
  {% render 'mionas-text', content: product.title, variant: 'body', size: 'md', tag: 'p', class: 'mionas-price' %}
{%- enddoc -%}

{%- liquid
  assign resolved_variant = variant | default: 'body'
  assign resolved_size = size | default: 'md'
  assign resolved_role = resolved_variant | append: '-' | append: resolved_size
  assign resolved_color = color | default: 'default'

  comment
    A stale variant/size pair must fall back, not pass through: `default` only catches nil/blank,
    not a string that stopped being a valid role, and an invalid class leaves the text with no
    size, weight or tracking at all.

    Validated as the joined pair, not each axis separately: callers like blocks/mionas-price.liquid
    split a stored `role` setting into variant/size themselves, so a stale value can produce a
    bogus pair even when each axis looks plausible alone.

    Keep this list in step with the .text-role--* rules below.
  endcomment
  assign allowed_roles = 'display-lg|display-md|display-sm|headline-lg|headline-md|headline-sm|title-lg|title-md|title-sm|body-lg|body-md|body-sm|label-lg|label-md|label-sm' | split: '|'
  unless allowed_roles contains resolved_role
    assign resolved_role = 'body-md'
  endunless

  comment
    tag comes from a select in every caller today, but a snippet is reachable from anywhere, so an
    unknown value falls back to p rather than emitting an invalid element.
  endcomment
  assign allowed_tags = 'p|span|div|h1|h2|h3|h4|h5|h6' | split: '|'
  assign resolved_tag = tag | default: 'p'
  unless allowed_tags contains resolved_tag
    assign resolved_tag = 'p'
  endunless

  assign classes = 'text-role text-role--' | append: resolved_role | append: ' text-role--' | append: resolved_color
  if class != blank
    assign classes = classes | append: ' ' | append: class
  endif
-%}

{%- comment -%}
  Interpolated rather than switched through a {% case %}: resolved_tag is already whitelisted
  above, so a per-tag branch would have nothing left to guard.
{%- endcomment -%}
<{{ resolved_tag }}
  class="{{ classes }}"
  {%- if style != blank %}
    style="{{ style }}"
  {%- endif %}
  {%- if heading_level != blank %}
    role="heading"
    aria-level="{{ heading_level }}"
  {%- endif %}
  {{ shopify_attributes }}
>{{- content -}}</{{ resolved_tag }}>

{% stylesheet %}
  .text-role {
    margin: 0;
    font-family: var(--font-family-archivo);
  }

  /* All fifteen band x size combinations are exposed, even though the theme only uses nine, so
     this stays a true mirror of Text.tsx rather than a silently reduced subset. Keep the
     `variant`/`size` selects in blocks/mionas-text.liquid and the whitelist above in step with
     this list. */
  .text-role--display-lg {
    font-size: var(--text-role-display-lg-font-size);
    line-height: var(--text-role-display-lg-line-height);
    font-weight: var(--text-role-display-lg-font-weight);
    letter-spacing: var(--text-role-display-lg-letter-spacing);
  }

  .text-role--display-md {
    font-size: var(--text-role-display-md-font-size);
    line-height: var(--text-role-display-md-line-height);
    font-weight: var(--text-role-display-md-font-weight);
    letter-spacing: var(--text-role-display-md-letter-spacing);
  }

  .text-role--display-sm {
    font-size: var(--text-role-display-sm-font-size);
    line-height: var(--text-role-display-sm-line-height);
    font-weight: var(--text-role-display-sm-font-weight);
    letter-spacing: var(--text-role-display-sm-letter-spacing);
  }

  .text-role--headline-lg {
    font-size: var(--text-role-headline-lg-font-size);
    line-height: var(--text-role-headline-lg-line-height);
    font-weight: var(--text-role-headline-lg-font-weight);
    letter-spacing: var(--text-role-headline-lg-letter-spacing);
  }

  .text-role--headline-md {
    font-size: var(--text-role-headline-md-font-size);
    line-height: var(--text-role-headline-md-line-height);
    font-weight: var(--text-role-headline-md-font-weight);
    letter-spacing: var(--text-role-headline-md-letter-spacing);
  }

  .text-role--headline-sm {
    font-size: var(--text-role-headline-sm-font-size);
    line-height: var(--text-role-headline-sm-line-height);
    font-weight: var(--text-role-headline-sm-font-weight);
    letter-spacing: var(--text-role-headline-sm-letter-spacing);
  }

  .text-role--title-lg {
    font-size: var(--text-role-title-lg-font-size);
    line-height: var(--text-role-title-lg-line-height);
    font-weight: var(--text-role-title-lg-font-weight);
    letter-spacing: var(--text-role-title-lg-letter-spacing);
  }

  .text-role--title-md {
    font-size: var(--text-role-title-md-font-size);
    line-height: var(--text-role-title-md-line-height);
    font-weight: var(--text-role-title-md-font-weight);
    letter-spacing: var(--text-role-title-md-letter-spacing);
  }

  .text-role--title-sm {
    font-size: var(--text-role-title-sm-font-size);
    line-height: var(--text-role-title-sm-line-height);
    font-weight: var(--text-role-title-sm-font-weight);
    letter-spacing: var(--text-role-title-sm-letter-spacing);
  }

  .text-role--body-lg {
    font-size: var(--text-role-body-lg-font-size);
    line-height: var(--text-role-body-lg-line-height);
    font-weight: var(--text-role-body-lg-font-weight);
    letter-spacing: var(--text-role-body-lg-letter-spacing);
  }

  .text-role--body-md {
    font-size: var(--text-role-body-md-font-size);
    line-height: var(--text-role-body-md-line-height);
    font-weight: var(--text-role-body-md-font-weight);
    letter-spacing: var(--text-role-body-md-letter-spacing);
  }

  .text-role--body-sm {
    font-size: var(--text-role-body-sm-font-size);
    line-height: var(--text-role-body-sm-line-height);
    font-weight: var(--text-role-body-sm-font-weight);
    letter-spacing: var(--text-role-body-sm-letter-spacing);
  }

  .text-role--label-lg {
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    font-weight: var(--text-role-label-lg-font-weight);
    letter-spacing: var(--text-role-label-lg-letter-spacing);
  }

  .text-role--label-md {
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
  }

  .text-role--label-sm {
    font-size: var(--text-role-label-sm-font-size);
    line-height: var(--text-role-label-sm-line-height);
    font-weight: var(--text-role-label-sm-font-weight);
    letter-spacing: var(--text-role-label-sm-letter-spacing);
  }

  /* No text-role--stamp rule here on purpose: blocks/mionas-stamp.liquid composes the label roles
     above rather than adding one beside them, mirroring Stamp.tsx's <Text variant="label">. */

  .text-role--default {
    color: var(--text-color-default);
  }

  .text-role--primary {
    color: var(--text-color-primary);
  }

  .text-role--inverse-primary {
    color: var(--text-color-inverse-primary);
  }

  .text-role--inverse-primary-muted {
    color: var(--text-color-inverse-primary-muted);
  }

  .text-role--accent {
    color: var(--text-color-accent);
  }

  .text-role--accent-inverse {
    color: var(--text-color-accent-inverse);
  }

  .text-role--tint {
    color: var(--text-color-tint);
  }
{% endstylesheet %}
