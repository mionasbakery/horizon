{%- doc -%}
  The column that spaces a form's fields apart. Renders only the Box half of Form.tsx -- callers
  wrap this in Liquid's own {% form %} tag, which owns the action URL, CSRF token, and form_type.

  @param {string} content - The fields' markup, built with capture before rendering
  @param {string} [class] - Extra classes
  @param {string} [attributes] - Raw string appended to the wrapper tag
  @param {string} [gap] - CSS length overriding the column's gap between fields (default: --space-lg)
  @param {boolean} [validate] - Show client-side validation errors in design-system markup (opt-in)

  @example
    {% capture form_fields %}
      {% render 'mionas-text-field', label: 'Email', name: 'contact[email]', id: 'x-email', type: 'email' %}
    {% endcapture %}
    {% form 'contact' %}
      {% render 'mionas-form', content: form_fields %}
    {% endform %}
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Form/Form.tsx. Form.tsx is `<form>` wrapping `<Box gap="lg">`;
  this snippet is only the Box half, since on a Shopify storefront the `<form>` itself comes from
  Liquid's {% form %} tag, which owns the action URL, CSRF token, and form_type. Callers render
  {% form %} themselves and put this immediately inside it.

  `validate` is opt-in, not the default: blocks/mionas-form.liquid composes arbitrary child field
  blocks, so the built-in error messages below can't be assumed to fit it.
{%- endcomment -%}
{% liquid
  assign form_classes = 'mionas-form'
  if class
    assign form_classes = form_classes | append: ' ' | append: class
  endif
%}
{%- capture form_column -%}
  <div
    class="{{ form_classes }}"
    {% if gap %}style="--mionas-form-gap: {{ gap }};"{% endif %}
    {{ attributes }}
  >{{ content }}</div>
{%- endcapture -%}

{%- if validate -%}
  {%- comment -%}
    The messages are literals, not schema settings -- see blocks/mionas-email-signup.liquid for why
    merchant-settable error copy was rejected. Both current callers have exactly one required field
    (email), so the copy names it directly; a form with a different required field passes
    data-message-required via mionas-text-field.liquid's `attributes` param instead.

    The script tag repeats per form instance safely: the browser dedupes a module by URL, and the
    customElements.define in the asset is guarded.
  {%- endcomment -%}
  {%- comment -%}
    Carries a class as well as its tag name so the stylesheet below can select it the way every
    other rule in this theme selects things. Nothing depends on the tag being styleable.
  {%- endcomment -%}
  <mionas-form-validation
    class="mionas-form-validation"
    data-message-required="Escribe tu email."
    data-message-invalid="Escribe un email válido."
  >
    {{ form_column }}
  </mionas-form-validation>
  <script src="{{ 'mionas-form-validation.js' | asset_url }}" type="module"></script>
{%- else -%}
  {{ form_column }}
{%- endif -%}

{% stylesheet %}
  /* Form.tsx's <Box gap="lg">. --space-lg is what Box's gap="lg" resolves to, and is the fallback
     when a caller passes no `gap` -- see the `gap` param above. */
  .mionas-form {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--mionas-form-gap, var(--space-lg));
  }

  /* `display: contents` is load-bearing: an unstyled custom element defaults to `inline`, which
     would break blocks/mionas-email-signup.liquid's inline layout that reaches through this element
     to flip .mionas-form to a row. */
  .mionas-form-validation {
    display: contents;
  }
{% endstylesheet %}
