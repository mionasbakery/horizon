{%- doc -%}
  A customer email signup form built on the Mionas form snippets.
{%- enddoc -%}
{%- comment -%}
  Horizon's native blocks/email-signup.liquid, rebuilt on the Mionas form snippets: a single
  {% raw %}{% form 'customer' %}{% endraw %} with contact[email]. The native block's appearance
  settings are dropped in favor of design-system tokens.

  Not a preset of blocks/mionas-form.liquid, because that block's children can't read the
  tag-scoped `form` object and so can only show a banner error -- owning the form tag here instead
  routes the email error into snippets/mionas-text-field.liquid's `error` param. mionas-form also
  hardcodes the contact form type; making that a setting would let a merchant point it at the
  customer endpoint, where only contact[email] means anything.

  No heading/description setting -- wrap this in a mionas-text block instead, as mionas-form and
  mionas-contact-form do. `consent_text` is the one exception: fine print the form itself owns (see
  NO CONSENT CHECKBOX below).

  `field_surface` wears the Card classes around the field only, so the button sits outside the
  card. Turn it off if already inside a Card.

  Errors are validated client-side via assets/mionas-form-validation.js (`validate: true`), which
  sets `novalidate` from JavaScript rather than in the tag, so a no-JS visitor keeps native browser
  validation.

  `type="email"` alone accepts malformed addresses ("a@b") that Shopify then rejects on submit,
  which looks like a silently ignored button click. snippets/mionas-text-field.liquid adds a
  stricter `pattern` for email fields to catch these before submit.

  No consent checkbox: Shopify records nothing from a client-side checkbox, so `consent_text` (fine
  print linking to the privacy policy) is the auditable equivalent.

  The customer endpoint leaves form.id blank, so the multi-instance guard below matches every
  signup on the page and all of them show the post's result, same as the native block.
  assets/mionas-newsletter-dialog.js tells its own post apart in the browser.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign form_id = block.id | prepend: 'MionasEmailSignup-'
  assign email_field_id = form_id | append: '-email'
  assign layout_classes = 'mionas-email-signup'
  if block_settings.layout == 'inline'
    assign layout_classes = layout_classes | append: ' mionas-email-signup--inline'
  endif
  if block_settings.button_width == 'fit'
    assign layout_classes = layout_classes | append: ' mionas-email-signup--button-fit'
  endif

  # mionas-submit-button has no fallback of its own -- a merchant who clears "Button label" would
  # otherwise ship a button with no accessible name, announced by screen readers as just "button".
  assign button_label = block_settings.button_label
  if button_label == blank
    assign button_label = 'blocks.email_signup.button' | t
  endif
%}

<div
  class="{{ layout_classes }} spacing-style"
  style="
    {%- render 'spacing-style', settings: block_settings -%}
    {%- if block_settings.width == 'custom' -%}
      --mionas-email-signup-width: {{ block_settings.custom_width }}%;
    {%- endif -%}
    {%- if block_settings.width_mobile == 'custom' -%}
      --mionas-email-signup-width-mobile: {{ block_settings.custom_width_mobile }}%;
    {%- endif -%}
  "
  {{ block.shopify_attributes }}
>
  {%- form 'customer', id: form_id -%}
    <input name="contact[id]" type="hidden" value="{{ form_id }}">
    {%- render 'mionas-honeypot' -%}

    {%- if block_settings.customer_tag != blank -%}
      <input name="contact[tags]" type="hidden" value="{{ block_settings.customer_tag | escape }}">
    {%- endif -%}

    {% liquid
      # Two signups on a page would otherwise fire each other's messages, since every form object
      # sees the same posted data after Shopify re-renders the page. See the header comment for
      # the customer-endpoint caveat.
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif

      # Routed into the field's own `error` param rather than a banner, so the underline, label
      # colour and message all come from the design system's FormField/FormLabel/FormError.
      # Kept on one line: inside a liquid tag a newline ends the statement, so a wrapped filter
      # chain would be a syntax error.
      assign email_error = ''
      if form.errors and form_matches
        assign email_error = form.errors.translated_fields.email | capitalize | append: ' ' | append: form.errors.messages.email
      endif

      # Assigned inside the form tag since `form` is scoped to it -- reading form.email outside
      # would leave the field empty after a failed submit. Unconfirmed whether the customer
      # endpoint echoes email back at all; if not, this is simply blank.
      assign email_value = form.email

      # The field's own error messages, read by assets/mionas-form-validation.js before the
      # form-wide fallback, plus each password manager's opt-out (see below).
      assign email_required = 'mionas.form.email_required' | t | escape | prepend: 'data-message-required="' | append: '"'
      assign email_invalid = 'mionas.form.email_invalid' | t | escape | prepend: ' data-message-invalid="' | append: '"'
      assign email_attributes = 'data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" data-protonpass-ignore="true" ' | append: email_required | append: email_invalid
    %}

    {%- assign signup_posted = false -%}
    {%- if form.posted_successfully? and form_matches -%}
      {%- liquid
        assign signup_posted = true
        assign success_title = 'mionas.newsletter_success.title' | t
        assign success_text = 'mionas.newsletter_success.text' | t
      -%}
      {%- render 'mionas-form-success', title: success_title, text: success_text, class: 'mionas-email-signup__success' -%}
      <script>
        try {
          localStorage.setItem('mionas-newsletter-subscribed', '1');
        } catch {}
      </script>
    {%- else -%}
    {%- capture email_field_markup -%}
      {%- comment -%}
        The data-* attributes are each password manager's opt-out: this field is not a login, and
        autocomplete="email" alone still lets them offer saved identities over it.
      {%- endcomment -%}
      {%- render 'mionas-text-field',
        label: block_settings.email_label,
        name: 'contact[email]',
        id: email_field_id,
        type: 'email',
        value: email_value,
        placeholder: block_settings.email_placeholder,
        autocomplete: 'email',
        spellcheck: 'false',
        autocapitalize: 'off',
        error: email_error,
        attributes: email_attributes
      -%}
    {%- endcapture -%}

    {%- capture email_signup_fields -%}
      {%- if block_settings.field_surface -%}
        <div class="{% render 'mionas-card-class' %} mionas-email-signup__surface">{{ email_field_markup }}</div>
      {%- else -%}
        {{ email_field_markup }}
      {%- endif -%}

      {%- render 'mionas-submit-button',
        label: button_label,
        variant: block_settings.submit_variant,
        size: block_settings.submit_size
      -%}
    {%- endcapture -%}

    {%- liquid
      # The render tag does not accept filters on its arguments, so the px suffix has to be applied
      # here first.
      assign field_gap_css = block_settings.field_gap | append: 'px'
    -%}
    {%- render 'mionas-form', content: email_signup_fields, validate: true, gap: field_gap_css -%}

    {%- comment -%}
      Rendered as a sibling after mionas-form, not folded into email_signup_fields, so it doesn't
      pick up the form's flex gap or inline row treatment -- it reads as a caption, not a third
      row item.
    {%- endcomment -%}
    {%- capture consent_content -%}{% render 'mionas-inline-richtext', value: block_settings.consent_text %}{%- endcapture -%}
    {%- assign consent_visible_text = consent_content | strip_html | strip -%}
    {%- if consent_visible_text != blank -%}
      {%- liquid
        # The inverse button only sits on a primary surface, where default text is unreadable.
        assign consent_color = 'default'
        if block_settings.submit_variant == 'inverse-primary'
          assign consent_color = 'inverse-primary'
        endif
      -%}
      {%- render 'mionas-text',
        content: consent_content,
        variant: 'note',
        color: consent_color,
        tag: 'p',
        class: 'mionas-email-signup__consent'
      -%}
    {%- endif -%}
    {%- endif -%}
  {%- endform -%}

  {%- if signup_posted and request.design_mode == false -%}
    <script
      src="{{ 'mionas-dialog.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    <script
      src="{{ 'mionas-signup-success.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
    {%- liquid
      assign success_dialog_id = form_id | append: '-success'
      assign success_close_label = 'mionas.newsletter_dialog.close' | t
    -%}
    {%- capture success_content -%}
      <div class="mionas-signup-success__content">
        {%- render 'mionas-signup-done' -%}
      </div>
    {%- endcapture -%}
    {%- render 'mionas-dialog',
      element: 'mionas-signup-success-component',
      id: success_dialog_id,
      section_id: section.id,
      label: success_title,
      close_label: success_close_label,
      content: success_content
    -%}
    {%- comment -%}
      Every signup on the page renders the post's result, so only the form whose submit left the mark
      below opens the dialog; it moves to <body> first because a dialog in a hidden section never
      shows. Without the mark (blocked storage) the section stays and shows the message in place.
    {%- endcomment -%}
    <script>
      (() => {
        const script = document.currentScript;
        const dialog = document.getElementById({{ success_dialog_id | json }});

        let posted = false;
        try {
          posted = sessionStorage.getItem('mionas-signup-posted') === {{ form_id | json }};
          if (posted) sessionStorage.removeItem('mionas-signup-posted');
        } catch {}
        if (!posted || script.closest('mionas-newsletter-dialog-component')) {
          dialog.remove();
          return;
        }

        dialog.dataset.open = '';
        document.body.append(dialog);
        {%- if block_settings.hide_section_for_subscribers %}
          script.closest('.shopify-section')?.style.setProperty('display', 'none');
        {%- endif %}
      })();
    </script>
  {%- endif -%}

  {%- if signup_posted == false and request.design_mode == false -%}
    <script>
      (() => {
        if (document.currentScript.closest('mionas-newsletter-dialog-component')) return;
        // A failed post leaves its mark behind, which a later signup elsewhere on the page would match.
        try {
          if (sessionStorage.getItem('mionas-signup-posted') === {{ form_id | json }}) {
            sessionStorage.removeItem('mionas-signup-posted');
          }
        } catch {}
        document.getElementById({{ form_id | json }})?.addEventListener('submit', () => {
          try {
            sessionStorage.setItem('mionas-signup-posted', {{ form_id | json }});
          } catch {}
        });
      })();
    </script>
  {%- endif -%}

  {%- if block_settings.hide_section_for_subscribers and signup_posted == false and request.design_mode == false -%}
    {%- comment -%}
      Inline and at the end of the block, so the section hides as the page parses, before it paints.
      The browser mark covers visitors who are not logged in; it stays in the browser where they
      signed up.
    {%- endcomment -%}
    <script>
      (() => {
        let subscribed = {{ customer.accepts_marketing | default: false | json }};
        try {
          subscribed ||= localStorage.getItem('mionas-newsletter-subscribed') === '1';
        } catch {}
        if (subscribed) document.currentScript.closest('.shopify-section')?.style.setProperty('display', 'none');
      })();
    </script>
  {%- endif -%}
</div>

{% stylesheet %}
  /* The dialog sizes itself to its content. Phones keep room at the top for the sheet's handle. */
  .mionas-signup-success__content {
    box-sizing: border-box;
    width: 480px;
    max-width: 100%;
    padding: calc(2 * var(--space-lg));
  }

  @media screen and (max-width: 749px) {
    .mionas-signup-success__content {
      width: auto;
      padding: calc(var(--space-lg) + var(--space-md));
    }
  }

  /* The block itself has no surface -- see the header comment.

     flex: 1 1 auto with width: 100% keeps the block from collapsing when a parent section stacks to
     a column on mobile; the desktop override zeroes flex-basis so a row splits by sibling widths
     instead. blocks/mionas-form.liquid and blocks/mionas-contact-form.liquid share this pattern --
     check all three when tuning it. */
  .mionas-email-signup {
    flex: 1 1 auto;
    min-width: 0;
    width: var(--mionas-email-signup-width, 100%);
    font-family: var(--font-family-archivo);
  }

  @media screen and (max-width: 749px) {
    .mionas-email-signup {
      width: var(--mionas-email-signup-width-mobile, var(--mionas-email-signup-width, 100%));
    }
  }

  @media screen and (min-width: 750px) {
    .mionas-email-signup {
      flex-basis: 0;
    }
  }

  .mionas-email-signup__surface {
    padding: var(--card-base-padding);
  }

  /* The field's underline bleeds to the surface's full width, so the label's own start padding is
     the only inset and matches the surface's top and bottom padding. width: auto overrides
     .mionas-form-field's fixed width: 100%, which only shifts under negative margins rather than
     growing to fill them. */
  .mionas-email-signup__surface .mionas-form-field {
    width: auto;
    margin-inline: calc(-1 * var(--card-base-padding));
  }

  /* The label is uppercase, so the space below its baseline is always empty and reads as extra
     padding above the input. Browsers without text-box support keep that space. */
  .mionas-email-signup .mionas-form-label {
    text-box: trim-end cap alphabetic;
  }

  /* No design-system token for muted fine print, so this dims the default role colour directly. */
  .mionas-email-signup__consent {
    margin-top: var(--space-xs);
    opacity: 0.7;
  }

  /* align-self is required alongside width: fit-content -- snippets/mionas-form.liquid's flex
     column stretches children by default, so without it the button would still span full width.

     The inline layout overrides width regardless, since a full-width button in a row would leave
     no space for the field; this setting becoming a no-op there is intended. */
  .mionas-email-signup--button-fit .mionas-button.mionas-submit-button {
    width: fit-content;
    align-self: flex-start;
  }

  /* The inline layout is a modifier of snippets/mionas-form.liquid's flex column, not a second
     markup path -- only direction, field flex-grow, and button width change.

     align-items: flex-start, not flex-end: the field's wrapper grows downward on a validation
     error, so bottom-aligning would shove the button down with it.

     Below 750px this rule doesn't apply, so inline falls back to stacked -- a phone-width row
     leaves neither input nor button usable. */
  @media screen and (min-width: 750px) {
    .mionas-email-signup--inline .mionas-form {
      flex-direction: row;
      align-items: flex-start;
    }

    .mionas-email-signup--inline .mionas-form-field,
    .mionas-email-signup--inline .mionas-email-signup__surface {
      flex: 1 1 auto;
    }

    .mionas-email-signup--inline .mionas-button.mionas-submit-button {
      width: auto;
      flex: 0 0 auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Email Signup",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Signups create a customer profile with marketing consent, the same as Shopify's built-in email signup."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave empty to use the theme's own wording, which stays translated per language."
    },
    {
      "type": "select",
      "id": "button_width",
      "label": "Button width",
      "options": [
        { "value": "fill", "label": "Fill" },
        { "value": "fit", "label": "Fit to text" }
      ],
      "default": "fill",
      "info": "Applies to the stacked layout. The inline layout always fits the button to its text, so the card has room."
    },
    {
      "type": "select",
      "id": "submit_variant",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" },
        { "value": "danger", "label": "Danger" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-ghost", "label": "Inverse ghost" },
        { "value": "inverse-outline", "label": "Inverse outline" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "submit_size",
      "label": "Button size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "checkbox",
      "id": "field_surface",
      "label": "Card-style field surface",
      "default": true,
      "info": "Wraps just the email field in the design system's card surface, with the button rendered outside it. Turn off if you're already wrapping this whole block in a Mionas: Card, to avoid boxing the field twice."
    },
    {
      "type": "checkbox",
      "id": "hide_section_for_subscribers",
      "label": "Hide the section for subscribers",
      "default": false,
      "info": "Hides the whole section that holds this form from logged-in customers who accept marketing, and from visitors who signed up in this browser. The theme editor always shows it."
    },
    {
      "type": "text",
      "id": "customer_tag",
      "label": "Customer tag",
      "info": "Optional. Tags every signup in Shopify admin so they can be segmented, e.g. \"newsletter\". Leave blank to match Shopify's built-in block, which adds no tag. Separating values with commas creates multiple tags."
    },
    {
      "type": "richtext",
      "id": "consent_text",
      "label": "Consent text",
      "info": "Optional fine print under the button, e.g. a link to the privacy policy. Left blank, nothing renders -- there is no consent checkbox, since Shopify records nothing from one."
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Gap between field and button",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "16px matches the design system's own Form spacing (--space-md)."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "inline", "label": "Inline" }
      ],
      "default": "stacked",
      "info": "Inline puts the field and the button on one row on screens 750px and wider. Below that it stacks either way."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill",
      "info": "Fill lets the block share a row with its siblings and split the space between them. A custom width overrides that."
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width on mobile",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Width on mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Email Signup",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
