{%- comment -%}
  The summary row under sections/mionas-google-reviews.liquid -- "4,9 · 128 reseñas en Google ·
  Verlas todas".

  This block is a *container*, not the line itself. It renders through snippets/group.liquid exactly
  as blocks/_product-list-content.liquid does, so every piece of the line is an independently
  editable child block that the merchant can restyle, reorder, remove or add to: the score, the
  separator, the count, and the link are four separate blocks, not one baked-in string.

  Why the children are private (`_`-prefixed): the score and the count read
  metaobjects.google_review_summary, written by the sync-google-reviews skill. Outside a Google
  reviews section they would render a summary of nothing, so they are whitelisted here and nowhere
  else. The link and the separator have no such tie and are therefore ordinary public Mionas blocks
  -- blocks/mionas-link.liquid and blocks/mionas-text.liquid -- reached through `@theme` below. That
  is the whole reason a native `group` could not be used as the slot directly: `@theme` covers
  public theme blocks only, so a native group cannot accept the two private children.

  This block owns the typography the data children spend
  (.mionas-google-reviews-summary__part--*), declared once here rather than duplicated in each
  child. That is safe under Shopify's stylesheet subsetting -- which drops the stylesheet CSS of
  any file not in the page's render tree -- because the children only ever render inside this
  container, so this file is in the render tree whenever they are.

  The reverse would NOT be safe: having the children spend blocks/mionas-text.liquid's `.text-role`
  classes instead would break the moment a summary row contains no mionas-text block, since that
  file would then be absent from the render tree and its CSS subsetted away. The role and colour
  vocabularies mirror mionas-text's anyway, so a merchant switching Role on a score block gets the
  same size they get on a text block.

  Colours come from --text-color-* and the star from --review-card-* tokens; no new token is
  introduced and neither assets/design-tokens.css nor ../design-system is touched.
{%- endcomment -%}

{%- capture children -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

{%- render 'group',
  children: children,
  settings: block.settings,
  shopify_attributes: block.shopify_attributes,
  background_color: block.settings.background_color,
  block_id: block.id
-%}

{% stylesheet %}
  .mionas-google-reviews-summary__part {
    margin: 0;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-family-archivo);
  }

  /* The same --text-role-* vocabulary blocks/mionas-text.liquid spends, restricted to the sizes a
     summary line plausibly wants. A Role option with no rule here renders at the inherited size, so
     keep the schema's Role options and the rules below in sync by hand. */
  .mionas-google-reviews-summary__part--caption {
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    font-weight: var(--text-role-label-lg-font-weight);
    letter-spacing: var(--text-role-label-lg-letter-spacing);
  }

  .mionas-google-reviews-summary__part--label {
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
  }

  .mionas-google-reviews-summary__part--body {
    font-size: var(--text-role-body-md-font-size);
    line-height: var(--text-role-body-md-line-height);
    font-weight: var(--text-role-body-md-font-weight);
    letter-spacing: var(--text-role-body-md-letter-spacing);
  }

  .mionas-google-reviews-summary__part--lead {
    font-size: var(--text-role-body-lg-font-size);
    line-height: var(--text-role-body-lg-line-height);
    font-weight: var(--text-role-body-lg-font-weight);
    letter-spacing: var(--text-role-body-lg-letter-spacing);
  }

  .mionas-google-reviews-summary__part--subheading {
    font-size: var(--text-role-title-sm-font-size);
    line-height: var(--text-role-title-sm-line-height);
    font-weight: var(--text-role-title-sm-font-weight);
    letter-spacing: var(--text-role-title-sm-letter-spacing);
  }

  /* Text.tsx's variant vocabulary, minus the inverse ones -- this row sits on the section's own
     background, and snippets/contrast-override.liquid already handles a dark section. */
  .mionas-google-reviews-summary__part--default {
    color: var(--text-color-default);
  }

  .mionas-google-reviews-summary__part--primary {
    color: var(--text-color-primary);
  }

  .mionas-google-reviews-summary__part--accent {
    color: var(--text-color-accent);
  }

  .mionas-google-reviews-summary__part--tint {
    color: var(--text-color-tint);
  }

  /* One star beside a number, not five: the average is fractional, and a five-star row would need
     partial-fill clipping that snippets/mionas-google-review-card.liquid never had to solve. */
  .mionas-google-reviews-summary__star {
    width: var(--review-card-rating-icon-size);
    height: var(--review-card-rating-icon-size);
    fill: var(--review-card-rating-filled-color);
    flex-shrink: 0;
  }

  /* Tabular figures so the score doesn't shift width as the average moves. */
  .mionas-google-reviews-summary__score {
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Reviews summary",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    },
    {
      "type": "_mionas-google-reviews-score"
    },
    {
      "type": "_mionas-google-reviews-count"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "row"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": false,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
