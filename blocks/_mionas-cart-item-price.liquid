{%- doc -%}
  Renders a cart line's price per item, with the original price struck through when it's lower than
  before. Used inside blocks/_mionas-cart-item.liquid.

  @param {object} line - The cart line item.
{%- enddoc -%}

{%- liquid
  assign compare_price = line.original_price
  if line.variant.compare_at_price > line.original_price
    assign compare_price = line.variant.compare_at_price
  endif
  assign final_price = line.final_price | money
-%}

{%- capture unit_price -%}
  {%- if line.final_price < compare_price -%}
    <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
    {{ 'mionas.cart.unit_price' | t: price: final_price }}
    <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
    <s>{{ compare_price | money }}</s>
  {%- else -%}
    <span class="visually-hidden">{{ 'content.price' | t }}</span>
    {{ 'mionas.cart.unit_price' | t: price: final_price }}
  {%- endif -%}
{%- endcapture -%}

{% render 'mionas-text',
  content: unit_price,
  variant: 'body',
  color: 'secondary',
  tag: 'p',
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Mionas: Cart Item Price",
  "tag": null,
  "settings": []
}
{% endschema %}
