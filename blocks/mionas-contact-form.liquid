{%- doc -%}
  Renders a contact form built from the Mionas form snippets, wrapping a single {% form 'contact' %}.
  Owns only fields, submit button and validation/success state, with a card-style surface around the
  fields -- no heading or divider of its own.

  Reads `customer` (to prefill name/email) and Shopify's `form`/`request` objects directly; it takes no render-time parameters.
{%- enddoc -%}

{%- comment -%}
  Composes the Mionas form snippets around a single {% form 'contact' %}. Forks rather than
  reskinning blocks/contact-form.liquid because that block hard-codes its fields onto one row with
  hidden labels and no per-field slots to restyle.

  Owns only the fields, submit button and validation/success state -- no heading, CTA or divider;
  those are composed in the page template instead (wrap this block in a Mionas: Card, etc.).

  The fields surface duplicates Mionas: Card's own --card-* tokens onto the wrapping `<div>` rather
  than reusing the Card component -- see blocks/mionas-email-signup.liquid's header comment for why.
  `field_gap` spaces the fields inside that surface; `button_gap` spaces the surface from the submit
  button via the outer mionas-form gap.

  Every field except email can be hidden or made optional (`show_*`/`require_*` below) -- email
  stays permanently visible and required since Shopify's contact endpoint depends on it. Phone
  defaults to optional -- Shopify's contact endpoint doesn't require it, same as
  blocks/corporate-quote-form.liquid.

  Field names must stay contact[name], contact[email], contact[phone], contact[body] -- Shopify
  recognises these and titles/echoes them in the merchant email and error messages.

  Client-side errors are JS-driven (assets/mionas-form-validation.js, via `validate: true` below),
  so a visitor without JS still gets native browser validation.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign form_id = block.id | prepend: 'MionasContactForm-'

  assign layout_classes = 'mionas-contact-form'

  # Derived here, not inline at the render call -- render doesn't accept filters on its arguments.
  assign name_field_id = form_id | append: '-name'
  assign email_field_id = form_id | append: '-email'
  assign phone_field_id = form_id | append: '-phone'
  assign body_field_id = form_id | append: '-body'
%}

<div
  class="{{ layout_classes }} spacing-style"
  style="{%- render 'spacing-style', settings: block_settings -%}"
  {{ block.shopify_attributes }}
>
  {%- form 'contact', id: form_id -%}
    {% liquid
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif

      # Shopify only reports an error against email, routed into the field's own `error` param so
      # the underline/label/message all come from FormField/FormLabel/FormError.
      assign email_error = ''
      if form.errors and form_matches
        assign email_error = form.errors.translated_fields.email | capitalize | append: ' ' | append: form.errors.messages.email
      endif

      # form.name doesn't exist on the contact form object, so it can't repopulate after a failed
      # submit -- customer.name is just the logged-in default.
      assign name_value = customer.name
      assign email_value = form.email | default: customer.email
      assign phone_value = form.phone | default: customer.phone
    %}

    {%- if form.posted_successfully? and form_matches -%}
      <div class="mionas-contact-form__success" tabindex="-1" autofocus>
        <span class="mionas-contact-form__success-icon">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
        </span>
        {%- render 'mionas-text',
          content: block_settings.success_title,
          variant: 'title',
          size: 'md',
          tag: 'p',
          class: 'mionas-contact-form__success-title'
        -%}
        {%- if block_settings.success_text != blank -%}
          {%- render 'mionas-text',
            content: block_settings.success_text,
            variant: 'body',
            size: 'md',
            tag: 'p',
            class: 'mionas-contact-form__success-text'
          -%}
        {%- endif -%}
      </div>
    {%- else -%}
    {%- capture contact_form_fields -%}
      {%- if block_settings.show_name -%}
        {%- render 'mionas-text-field',
          label: block_settings.label_name,
          name: 'contact[name]',
          id: name_field_id,
          value: name_value,
          placeholder: block_settings.placeholder_name,
          autocomplete: 'name',
          required: block_settings.require_name,
          optional_text: 'opcional'
        -%}
      {%- endif -%}

      {%- render 'mionas-text-field',
        label: block_settings.label_email,
        name: 'contact[email]',
        id: email_field_id,
        type: 'email',
        value: email_value,
        placeholder: block_settings.placeholder_email,
        autocomplete: 'email',
        spellcheck: 'false',
        autocapitalize: 'off',
        error: email_error
      -%}

      {%- if block_settings.show_phone -%}
        {%- render 'mionas-text-field',
          label: block_settings.label_phone,
          name: 'contact[phone]',
          id: phone_field_id,
          type: 'tel',
          value: phone_value,
          placeholder: block_settings.placeholder_phone,
          autocomplete: 'tel',
          inputmode: 'tel',
          required: block_settings.require_phone,
          optional_text: 'opcional'
        -%}
      {%- endif -%}

      {%- if block_settings.show_message -%}
        {%- render 'mionas-text-field',
          label: block_settings.label_message,
          name: 'contact[body]',
          id: body_field_id,
          value: form.body,
          placeholder: block_settings.placeholder_message,
          rows: 5,
          required: block_settings.require_message,
          optional_text: 'opcional'
        -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- liquid
      assign field_gap_css = block_settings.field_gap | append: 'px'
      assign button_gap_css = block_settings.button_gap | append: 'px'
    -%}
    {%- capture contact_form_content -%}
      <div class="mionas-contact-form__surface" style="--mionas-contact-form-field-gap: {{ field_gap_css }};">{{ contact_form_fields }}</div>

      {%- render 'mionas-submit-button',
        label: block_settings.submit_label,
        variant: block_settings.submit_variant,
        size: block_settings.submit_size
      -%}
    {%- endcapture -%}

    {%- render 'mionas-form', content: contact_form_content, validate: true, gap: button_gap_css -%}
    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .mionas-contact-form {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    font-family: var(--font-family-archivo);
  }

  @media screen and (min-width: 750px) {
    .mionas-contact-form {
      flex-basis: 0;
    }
  }

  /* Duplicates Mionas: Card's own surface tokens -- see the header comment's fields-surface note. */
  .mionas-contact-form__surface {
    background: var(--card-base-background);
    border: var(--card-base-border-width) solid var(--card-base-border-color);
    border-radius: var(--card-base-radius);
    box-shadow: var(--card-base-shadow);
    padding: var(--card-base-padding);
    display: flex;
    flex-direction: column;
    gap: var(--mionas-contact-form-field-gap, var(--space-md));
  }

  /* Each field's underline bleeds to the surface's full width; padding-inline keeps the label/input
     at their previous inset. width: auto overrides .mionas-form-field's own fixed width: 100%, which
     otherwise leaves the right edge short under negative margins -- same fix as
     blocks/mionas-email-signup.liquid's identical rule. */
  .mionas-contact-form__surface .mionas-form-field {
    width: auto;
    margin-inline: calc(-1 * var(--card-base-padding));
    padding-inline: var(--card-base-padding);
  }

  .mionas-contact-form__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
    padding-block: var(--space-md);
  }

  /* No design-system token for success green -- deliberate one-off. */
  .mionas-contact-form__success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-2xs);
    border-radius: 50%;
    background: #4a7c59;
    color: var(--color-white, #fff);
  }

  .mionas-contact-form__success-icon svg {
    width: 24px;
    height: 24px;
  }

  /* Higher specificity than .text-role--<color> so the muted colour always wins. */
  .text-role.mionas-contact-form__success-text {
    color: var(--card-description-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Contact form",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show name field",
      "default": true
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "Nombre",
      "visible_if": "{{ block.settings.show_name }}"
    },
    {
      "type": "text",
      "id": "placeholder_name",
      "label": "Name placeholder",
      "visible_if": "{{ block.settings.show_name }}"
    },
    {
      "type": "checkbox",
      "id": "require_name",
      "label": "Require name",
      "default": true,
      "visible_if": "{{ block.settings.show_name }}"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email",
      "info": "Email is always shown and required -- Shopify's contact endpoint and the merchant notification both depend on it."
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Email placeholder"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": true
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone label",
      "default": "Teléfono",
      "visible_if": "{{ block.settings.show_phone }}"
    },
    {
      "type": "text",
      "id": "placeholder_phone",
      "label": "Phone placeholder",
      "visible_if": "{{ block.settings.show_phone }}"
    },
    {
      "type": "checkbox",
      "id": "require_phone",
      "label": "Require phone",
      "default": false,
      "visible_if": "{{ block.settings.show_phone }}"
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "Show message field",
      "default": true
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Mensaje",
      "visible_if": "{{ block.settings.show_message }}"
    },
    {
      "type": "text",
      "id": "placeholder_message",
      "label": "Message placeholder",
      "default": "¿En qué te ayudamos?",
      "visible_if": "{{ block.settings.show_message }}"
    },
    {
      "type": "checkbox",
      "id": "require_message",
      "label": "Require message",
      "default": true,
      "visible_if": "{{ block.settings.show_message }}"
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Gap between fields",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16,
      "info": "16px matches the design system's own Form spacing (--space-md)."
    },
    {
      "type": "range",
      "id": "button_gap",
      "label": "Gap before submit button",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24,
      "info": "Gap between the field card and the submit button."
    },
    {
      "type": "select",
      "id": "submit_variant",
      "label": "Submit button style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "submit_size",
      "label": "Submit button size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Enviar"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success title",
      "default": "¡Mensaje enviado!"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Te respondemos en 24–48h laborables."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Contact form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
