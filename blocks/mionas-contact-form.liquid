{%- doc -%}
  Renders a contact form built from the Mionas form snippets, wrapping a single {% form 'contact' %}.
  Owns only fields, submit button and validation/success state -- no card, heading, or divider.

  Reads `customer` (to prefill name/email) and Shopify's `form`/`request` objects directly; it takes no render-time parameters.
{%- enddoc -%}

{%- comment -%}
  Composes the Mionas form snippets around a single {% form 'contact' %}. Forks rather than
  reskinning blocks/contact-form.liquid because that block hard-codes its fields onto one row with
  hidden labels and no per-field slots to restyle.

  Owns only the fields, submit button and validation/success state -- no card, heading, CTA or
  divider. Those are composed in the page template instead (wrap this block in a Mionas: Card,
  etc.); do not add a surface (background/border/shadow) here.

  Field names must stay contact[name], contact[email], contact[body] -- Shopify recognises these
  and titles/echoes them in the merchant email and error messages. Renaming breaks that.

  Client-side errors are JS-driven (assets/mionas-form-validation.js, via `validate: true` below)
  so a visitor without JS still gets native browser validation.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign form_id = block.id | prepend: 'MionasContactForm-'

  assign layout_classes = 'mionas-contact-form'

  # Derived here, not inline at the render call -- render doesn't accept filters on its arguments.
  assign name_field_id = form_id | append: '-name'
  assign email_field_id = form_id | append: '-email'
  assign body_field_id = form_id | append: '-body'
%}

<div
  class="{{ layout_classes }} spacing-style"
  style="
    {%- render 'spacing-style', settings: block_settings -%}
    {%- if block_settings.width == 'custom' -%}
      --mionas-contact-form-width: {{ block_settings.custom_width }}%;
    {%- endif -%}
    {%- if block_settings.width_mobile == 'custom' -%}
      --mionas-contact-form-width-mobile: {{ block_settings.custom_width_mobile }}%;
    {%- endif -%}
  "
  {{ block.shopify_attributes }}
>
  {%- form 'contact', id: form_id -%}
    {%- comment -%}
      No contact[id] field: the form tag's `id:` param already sets form.id, and an extra
      contact[...] field would leak an "Id: ..." line into the merchant email.

      Shopify's contact form always posts to /contact, not this page -- return_to sends the
      visitor back here after submit instead of wherever /contact resolves to.
    {%- endcomment -%}
    <input name="return_to" type="hidden" value="{{ request.path }}">

    {% liquid
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif

      # Shopify only reports an error against email, routed into the field's own `error` param so
      # the underline/label/message all come from FormField/FormLabel/FormError.
      assign email_error = ''
      if form.errors and form_matches
        assign email_error = form.errors.translated_fields.email | capitalize | append: ' ' | append: form.errors.messages.email
      endif

      # form.name doesn't exist on the contact form object, so it can't repopulate after a failed
      # submit -- customer.name is just the logged-in default.
      assign name_value = customer.name
      assign email_value = form.email | default: customer.email
    %}

    {%- if form.posted_successfully? and form_matches -%}
      <div class="mionas-contact-form__success" tabindex="-1" autofocus>
        <span class="mionas-contact-form__success-icon">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
        </span>
        {%- render 'mionas-text',
          content: block_settings.success_title,
          variant: 'title',
          size: 'md',
          tag: 'p',
          class: 'mionas-contact-form__success-title'
        -%}
        {%- if block_settings.success_text != blank -%}
          {%- render 'mionas-text',
            content: block_settings.success_text,
            variant: 'body',
            size: 'md',
            tag: 'p',
            class: 'mionas-contact-form__success-text'
          -%}
        {%- endif -%}
      </div>
    {%- else -%}
    {%- capture contact_form_fields -%}
      {%- render 'mionas-text-field',
        label: block_settings.label_name,
        name: 'contact[name]',
        id: name_field_id,
        value: name_value,
        autocomplete: 'name'
      -%}

      {%- render 'mionas-text-field',
        label: block_settings.label_email,
        name: 'contact[email]',
        id: email_field_id,
        type: 'email',
        value: email_value,
        placeholder: block_settings.placeholder_email,
        autocomplete: 'email',
        spellcheck: 'false',
        autocapitalize: 'off',
        error: email_error
      -%}

      {%- render 'mionas-text-field',
        label: block_settings.label_message,
        name: 'contact[body]',
        id: body_field_id,
        value: form.body,
        placeholder: block_settings.placeholder_message,
        rows: 5
      -%}

      {%- render 'mionas-submit-button',
        label: block_settings.submit_label,
        variant: block_settings.submit_variant
      -%}
    {%- endcapture -%}

    {%- liquid
      assign field_gap_css = block_settings.field_gap | append: 'px'
    -%}
    {%- render 'mionas-form', content: contact_form_fields, validate: true, gap: field_gap_css -%}
    {%- endif -%}
  {%- endform -%}
</div>

{% stylesheet %}
  .mionas-contact-form {
    flex: 1 1 auto;
    min-width: 0;
    width: var(--mionas-contact-form-width, 100%);
    font-family: var(--font-family-archivo);
  }

  @media screen and (max-width: 749px) {
    .mionas-contact-form {
      width: var(--mionas-contact-form-width-mobile, var(--mionas-contact-form-width, 100%));
    }
  }

  @media screen and (min-width: 750px) {
    .mionas-contact-form {
      flex-basis: 0;
    }
  }

  .mionas-contact-form__success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    text-align: center;
    padding-block: var(--space-md);
  }

  /* No design-system token for success green -- deliberate one-off. */
  .mionas-contact-form__success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-2xs);
    border-radius: 50%;
    background: #4a7c59;
    color: var(--color-white, #fff);
  }

  .mionas-contact-form__success-icon svg {
    width: 24px;
    height: 24px;
  }

  /* Higher specificity than .text-role--<color> so the muted colour always wins. */
  .text-role.mionas-contact-form__success-text {
    color: var(--card-description-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Contact form",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "Nombre"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "placeholder_email",
      "label": "Email placeholder",
      "default": "tu@email.com"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Mensaje"
    },
    {
      "type": "text",
      "id": "placeholder_message",
      "label": "Message placeholder",
      "default": "¿En qué te ayudamos?"
    },
    {
      "type": "range",
      "id": "field_gap",
      "label": "Gap between fields",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24,
      "info": "24px matches the design system's own Form spacing (--space-lg)."
    },
    {
      "type": "select",
      "id": "submit_variant",
      "label": "Submit button style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Enviar"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success title",
      "default": "¡Mensaje enviado!"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Te respondemos en 24–48h laborables."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill",
      "info": "Fill lets the block share a row with its siblings and split the space between them. A custom width overrides that."
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width on mobile",
      "options": [
        { "value": "fill", "label": "Fill available space" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Width on mobile",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Contact form",
      "category": "t:categories.forms"
    }
  ]
}
{% endschema %}
