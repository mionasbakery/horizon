{%- comment -%}
  The average score in the summary row -- "★ 4,9".

  Private (`_`-prefixed) and whitelisted only by blocks/_mionas-google-reviews-summary.liquid: it
  reads metaobjects.google_review_summary, written by the sync-google-reviews skill, so anywhere
  else it would render a score of nothing. It renders nothing at all when that metaobject is absent
  (a store that has never synced).

  The typography classes it emits (.mionas-google-reviews-summary__part--*) are declared once by its
  container, which is always present when this block is -- see the comment there.

  The score is formatted with a comma decimal separator to match es-ES conventions, the same way the
  section's copy defaults are Spanish.
{%- endcomment -%}

{% liquid
  assign summary = metaobjects.google_review_summary.default
%}

{%- if summary != blank -%}
  {%- liquid
    assign score = summary.average_rating.value | round: 1 | append: '' | replace: '.', ','
  -%}
  <p
    class="
      mionas-google-reviews-summary__part
      mionas-google-reviews-summary__part--{{ block.settings.role }}
      mionas-google-reviews-summary__part--{{ block.settings.variant }}
    "
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_star -%}
      <svg viewBox="0 0 20 20" aria-hidden="true" class="mionas-google-reviews-summary__star">
        <path d="M10 1.6l2.47 5.34 5.87.58-4.38 4.05 1.24 5.76L10 14.6l-5.2 2.73 1.24-5.76-4.38-4.05 5.87-.58L10 1.6z" />
      </svg>
    {%- endif -%}
    <span class="mionas-google-reviews-summary__score">{{ score }}</span>
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Mionas: Reviews score",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_star",
      "label": "Show star",
      "default": true
    },
    {
      "type": "select",
      "id": "role",
      "label": "Role",
      "options": [
        {
          "value": "caption",
          "label": "Caption"
        },
        {
          "value": "label",
          "label": "Label"
        },
        {
          "value": "body",
          "label": "Body"
        },
        {
          "value": "lead",
          "label": "Lead"
        },
        {
          "value": "subheading",
          "label": "Subheading"
        }
      ],
      "default": "caption"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "tint",
          "label": "Tint"
        }
      ],
      "default": "primary"
    }
  ]
}
{% endschema %}
