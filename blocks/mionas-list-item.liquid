{%- comment -%}
  Mirrors ../design-system/src/react/List/ListItem.tsx: a row (icon/text/whatever content, laid out
  horizontally and vertically centred, `p="md"`) that becomes pressable when it has a destination.

  ListItem.tsx's `onClick` is a JS callback with no navigation semantics of its own; a static theme
  block has no equivalent, so this follows the same substitution mionas-button.liquid/
  mionas-link.liquid make elsewhere in this theme -- an optional `link` setting turns the row into an
  <a>, with the same `:active` dimming ListItem.tsx's `pressed` class provides via Box's `onPress`.

  The divider-before-every-item-except-the-first behaviour lives in blocks/mionas-list.liquid's
  stylesheet (a `:not(:first-child)` rule on this block's own class), not here -- see that file's
  header comment for why.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.link != blank -%}
  <a
    href="{{ block_settings.link }}"
    class="mionas-list-item mionas-list-item--pressable"
    {%- if block_settings.open_in_new_tab -%} target="_blank" rel="noopener noreferrer"{%- endif -%}
    {{ block.shopify_attributes }}
  >
    {{- block_settings.content -}}
  </a>
{%- else -%}
  <div class="mionas-list-item" {{ block.shopify_attributes }}>
    {{- block_settings.content -}}
  </div>
{%- endif -%}

{% stylesheet %}
  .mionas-list-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: var(--space-md);
    font-family: var(--font-family-archivo);
  }

  .mionas-list:not([data-separator="false"]) .mionas-list-item:not(:first-child) {
    border-top: var(--list-base-border-width) solid var(--list-base-border-color);
  }

  .mionas-list-item--pressable {
    background: none;
    border: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: inherit;
    text-decoration: none;
    cursor: pointer;
    width: 100%;
  }

  .mionas-list-item--pressable:active {
    opacity: var(--list-item-state-pressed-opacity);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: List item",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>List item</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the entire row clickable."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Mionas: List item",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
