{%- doc -%}
  An inline text link, distinct from Button's CTA vocabulary.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system/src/react/Link/Link.tsx's inline-text vocabulary, distinct from Button's
  CTA styling (no background, underline only on hover). Horizon's native "button-unstyled" style
  renders a plain <a> too, but still carries Button's width settings rather than this vocabulary.

  Only covers Link.tsx's `as="a"` case -- its `as="span"` mode rides along on a parent's own click
  (e.g. inside a Card), which has no equivalent for a standalone, independently insertable block.

  --link-base-font-weight is 500, a weight none of the theme's font settings load on their own;
  design-system-bridge.liquid emits the Archivo 500 face so it renders medium instead of falling
  back to 400.

  Markup lives in snippets/mionas-link.liquid so snippets/mionas-language-links.liquid can render
  the same classes/tokens as a <button> -- a block can't {% render %} another block.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
%}
{% render 'mionas-link',
  content: block_settings.label,
  link: block_settings.link,
  open_in_new_tab: block_settings.open_in_new_tab,
  variant: block_settings.variant,
  size: block_settings.size,
  icon: block_settings.icon,
  text_wrap: block_settings.text_wrap,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Mionas: Link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "phone", "label": "Phone" },
        { "value": "mail", "label": "Mail" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "text_wrap",
      "label": "Text wrapping",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "nowrap", "label": "No wrap" }
      ],
      "default": "normal"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Link",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
