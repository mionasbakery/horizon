{%- doc -%}
  An inline text link, distinct from Button's CTA vocabulary.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system/src/react/Link/Link.tsx's inline-text vocabulary, distinct from Button's
  CTA styling (no background, underline only on hover). Horizon's native "button-unstyled" style
  renders a plain <a> too, but still carries Button's width settings rather than this vocabulary.

  Only covers Link.tsx's `as="a"` case -- its `as="span"` mode rides along on a parent's own click
  (e.g. inside a Card), which has no equivalent for a standalone, independently insertable block.

  --link-base-font-weight is 500, a weight none of the theme's font settings load on their own;
  design-system-bridge.liquid emits the Archivo 500 face so it renders medium instead of falling
  back to 400.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign variant = block_settings.variant | default: 'primary'
  assign size = block_settings.size | default: 'md'
%}

{%- comment -%}
  The if/else tags below deliberately carry no whitespace-stripping hyphens -- the same shape as
  snippets/button.liquid. A stripping hyphen on the opening tag eats the newline between the anchor
  and its first attribute, emitting arole="link" as a single glued token: an unknown element rather
  than an anchor, with no link semantics and no styling. Whitespace inside a tag is harmless;
  removing it is not.
{%- endcomment -%}
<a
  {% if block_settings.link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ block_settings.link }}"
  {% endif %}
  class="mionas-link mionas-link--{{ variant }}{% unless size == 'md' %} mionas-link--{{ size }}{% endunless %}{% if block_settings.icon != blank and block_settings.icon != 'none' %} mionas-link--with-icon{% endif %}"
  {% if block_settings.open_in_new_tab %}
    target="_blank"
    rel="noopener noreferrer"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block_settings.icon != blank and block_settings.icon != 'none' -%}
    <svg class="mionas-link__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      {%- render 'icon', icon: block_settings.icon -%}
    </svg>
  {%- endif -%}
  {{- block_settings.label -}}
</a>

{% stylesheet %}
  .mionas-link {
    font-family: var(--link-base-font-family);
    font-weight: var(--link-base-font-weight);
    font-size: var(--link-size-md-font-size);
    text-decoration: none;
    cursor: pointer;
  }

  .mionas-link:hover {
    text-decoration: underline;
  }

  .mionas-link[aria-disabled="true"] {
    cursor: default;
    pointer-events: none;
  }

  .mionas-link--with-icon {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .mionas-link__icon {
    flex: none;
    width: 16px;
    height: 16px;
  }

  .mionas-link--sm {
    font-size: var(--link-size-sm-font-size);
  }

  .mionas-link--primary {
    color: var(--link-base-foreground);
  }

  .mionas-link--inverse-primary {
    color: var(--link-inverse-primary-foreground);
  }

  .mionas-link--inverse-primary-muted {
    color: var(--link-inverse-primary-muted-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" }
      ],
      "default": "md"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "phone", "label": "Phone" },
        { "value": "mail", "label": "Mail" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Link",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
