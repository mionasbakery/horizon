{%- comment -%}
  The review count in the summary row -- "128 reseñas en Google".

  Private (`_`-prefixed) and whitelisted only by blocks/_mionas-google-reviews-summary.liquid, for
  the same reason the score block is: it reads metaobjects.google_review_summary and renders nothing
  without it.

  The label is plain merchant text on purpose -- rebuilding Google's wordmark in another typeface
  breaks their brand guidelines, so the block offers no logo and no styled "Google".

  The typography classes it emits (.mionas-google-reviews-summary__part--*) are declared once by its
  container, which is always present when this block is -- see the comment there.
{%- endcomment -%}

{% liquid
  assign summary = metaobjects.google_review_summary.default
%}

{%- if summary != blank -%}
  <p
    class="
      mionas-google-reviews-summary__part
      mionas-google-reviews-summary__part--{{ block.settings.role }}
      mionas-google-reviews-summary__part--{{ block.settings.variant }}
    "
    {{ block.shopify_attributes }}
  >
    {{ summary.total_count.value }} {{ block.settings.label }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "Mionas: Reviews count",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "reseñas en Google",
      "info": "Shown after the count. Plain text on purpose — rebuilding Google's wordmark in another typeface breaks their brand guidelines."
    },
    {
      "type": "select",
      "id": "role",
      "label": "Role",
      "options": [
        {
          "value": "label-lg",
          "label": "Label large"
        },
        {
          "value": "label-md",
          "label": "Label medium"
        },
        {
          "value": "body-md",
          "label": "Body medium"
        },
        {
          "value": "body-lg",
          "label": "Body large"
        },
        {
          "value": "title-sm",
          "label": "Title small"
        }
      ],
      "default": "label-lg"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "tint",
          "label": "Tint"
        }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
