{%- doc -%}
  Renders a product's price as a Mionas text role, with an optional struck-through compare-at price.

  @param {product} [closest.product] - The product whose price to render. Renders nothing if absent.
{%- enddoc -%}

{%- comment -%}
  Renders through snippets/mionas-text.liquid, the same snippet blocks/mionas-text.liquid uses, so
  typography and colour follow the variant, as ProductCardPrice.tsx takes Text's `title` unmodified.

  Color was renamed from `variant` because the Variant setting needed that id, and a block schema
  can't have two settings share one.

  A dedicated block rather than mionas-text.liquid: price needs `| money` formatting, the compare-at
  comparison and an accessible label on the struck-through original -- none of which a literal
  richtext setting can produce -- and the product card reuses one fixed block id across every
  product in the grid (see sections/mionas-collection.liquid), so a literal string would repeat one
  figure.

  Not in the design system as a standalone component -- ../design-system/src/react/ has Text and
  ProductCardPrice but no Price, so the plumbing is Text's.

  The compare-at price is opt-in and off by default: ProductCardPrice.tsx shows a single price, but
  a bakery running a promotion needs somewhere to show the original. It renders only when the
  product is genuinely discounted.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign selected_variant = product.selected_or_first_available_variant

  assign on_sale = false
  if selected_variant.compare_at_price > selected_variant.price
    assign on_sale = true
  endif
-%}

{%- if product != blank -%}
  {%- liquid
    comment
      Same store-level conditions as native blocks/price.liquid's tax note, so both blocks state the
      same thing wherever they appear.
    endcomment
    capture tax_note
      if block_settings.show_tax_info
        if cart.duties_included and cart.taxes_included
          echo 'content.duties_and_taxes_included' | t
        elsif cart.taxes_included
          echo 'content.taxes_included' | t
        elsif cart.duties_included
          echo 'content.duties_included' | t
        endif
        if shop.shipping_policy.body != blank
          echo ' '
          echo 'content.shipping_policy' | t
        endif
      endif
    endcapture

    comment
      Built as a string and handed to the snippet as `content`, which the snippet outputs unfiltered.
      Everything concatenated here is either `| money` output or a translated string, so there is no
      merchant-authored HTML in it.

      The tax note rides inside the text role rather than as a sibling element, so a parent
      container's flex/grid gap can't open up between the price and its note -- the distance is the
      note's own margin, nothing else. It lands on its own line via flex-basis: 100%.
    endcomment
    capture price_content
      echo '<span class="mionas-price__current">'
      echo selected_variant.price | money
      echo '</span>'

      if block_settings.show_compare_at_price and on_sale
        echo '<s class="mionas-price__compare">'
        echo '<span class="visually-hidden">'
        echo 'content.price_regular' | t
        echo '&nbsp;</span>'
        echo selected_variant.compare_at_price | money
        echo '</s>'
      endif

      if tax_note != blank
        render 'mionas-text', content: tax_note, variant: 'note', color: 'secondary', tag: 'span', class: 'mionas-price__tax-note'
      endif
    endcapture
  -%}

  {%- comment -%}
    `spacing-style` is Horizon's own class (base.css:1352-1381): it turns the four --padding-*
    custom properties the snippet writes into real padding, with 0px fallbacks, and scales anything
    above 20px responsively. Same mechanism blocks/mionas-add-to-cart.liquid uses in this card.
  {%- endcomment -%}
  {%- capture price_style -%}
    {%- render 'spacing-style', settings: block_settings -%}
  {%- endcapture -%}

  <product-price
    data-block-id="{{ block.id }}"
    data-product-id="{{ product.id }}"
    {{ block.shopify_attributes }}
  >
    <div ref="priceContainer">
      {%- render 'mionas-text',
        content: price_content,
        variant: block_settings.variant,
        color: block_settings.color,
        tag: 'p',
        class: 'mionas-price spacing-style',
        style: price_style
      -%}
    </div>
  </product-price>
{%- endif -%}

{% stylesheet %}
  /* The variant owns the typography and colour. This adds display/align-items/gap, since the price
     is a row of two figures when a compare-at is shown.

     No padding is declared here on purpose -- it's four range settings via spacing-style,
     defaulting to 0, same mechanism as blocks/mionas-add-to-cart.liquid and Horizon's own
     blocks/_product-card.liquid, so the block imposes no inset and the composition decides. The
     horizontal inset the card needs is set per instance in the theme editor (templates/index.json,
     templates/collection.json, sections/mionas-collection.liquid's preset). */
  /* Row-gap is zero on purpose: the tax note wraps onto a second line inside this element, and its
     vertical distance must come only from its own margin -- a row-gap would silently add to it. */
  .text-role.mionas-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-xs);
  }

  /* The struck-through original uses the price colour at reduced opacity rather than a colour of
     its own, since the design system has no compare-at token -- that keeps it on-palette whatever
     Color resolves to. */
  .mionas-price__compare {
    opacity: 0.6;
    font-weight: var(--text-role-body-font-weight, 400);
  }

  /* The note is always the note variant in the secondary colour, whatever Variant the price
     uses. flex-basis: 100% puts it on its own line inside the price's wrapping flex row. Two classes
     deep to beat .text-role's margin: 0, which sits in another stylesheet. */
  .text-role.mionas-price__tax-note {
    flex-basis: 100%;
    margin-top: var(--space-3xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Price",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "display", "label": "Display" },
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "title", "label": "Title" },
        { "value": "lead", "label": "Lead" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" },
        { "value": "note", "label": "Note" }
      ],
      "default": "body",
      "info": "The same text variants as Mionas: Text. Product cards use Title."
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "Show compare-at price",
      "default": false,
      "info": "Shows the original price struck through, only on products that are actually discounted."
    },
    {
      "type": "checkbox",
      "id": "show_tax_info",
      "label": "Tax information",
      "default": false,
      "info": "Shows the store's tax and shipping note under the price."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Price",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
