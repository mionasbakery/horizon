{%- doc -%}
  Renders a product's price as a Mionas text role, with an optional struck-through compare-at price.

  @param {product} [closest.product] - The product whose price to render. Renders nothing if absent.
{%- enddoc -%}

{%- comment -%}
  Renders through snippets/mionas-text.liquid, the same snippet blocks/mionas-text.liquid uses, so
  size, line-height, letter-spacing, family and colour follow the role. Only the weight is the
  price's own -- see the stylesheet.

  Variant/size mirror mionas-text.liquid's band x size grid. Color was renamed from `variant`
  because the new band setting needed that id, and a block schema can't have two settings share one.

  A dedicated block rather than mionas-text.liquid: price needs `| money` formatting, the compare-at
  comparison and an accessible label on the struck-through original -- none of which a literal
  richtext setting can produce -- and the product card reuses one fixed block id across every
  product in the grid (see sections/mionas-collection.liquid), so a literal string would repeat one
  figure.

  Not in the design system as a standalone component -- ../design-system/src/react/ has Text and
  ProductCardPrice but no Price, so the tokens below are ProductCardPrice's while the role plumbing
  is Text's.

  The compare-at price is opt-in and off by default: ProductCardPrice.tsx shows a single price, but
  a bakery running a promotion needs somewhere to show the original. It renders only when the
  product is genuinely discounted.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign selected_variant = product.selected_or_first_available_variant

  assign on_sale = false
  if selected_variant.compare_at_price > selected_variant.price
    assign on_sale = true
  endif
-%}

{%- if product != blank -%}
  {%- liquid
    comment
      Same store-level conditions as native blocks/price.liquid's tax note, so both blocks state the
      same thing wherever they appear.
    endcomment
    capture tax_note
      if block_settings.show_tax_info
        if cart.duties_included and cart.taxes_included
          echo 'content.duties_and_taxes_included' | t
        elsif cart.taxes_included
          echo 'content.taxes_included' | t
        elsif cart.duties_included
          echo 'content.duties_included' | t
        endif
        if shop.shipping_policy.body != blank
          echo ' '
          echo 'content.shipping_policy' | t
        endif
      endif
    endcapture

    comment
      Built as a string and handed to the snippet as `content`, which the snippet outputs unfiltered.
      Everything concatenated here is either `| money` output or a translated string, so there is no
      merchant-authored HTML in it.

      The tax note rides inside the text role rather than as a sibling element, so a parent
      container's flex/grid gap can't open up between the price and its note -- the distance is the
      note's own margin, nothing else. It lands on its own line via flex-basis: 100%.
    endcomment
    capture price_content
      echo '<span class="mionas-price__current">'
      echo selected_variant.price | money
      echo '</span>'

      if block_settings.show_compare_at_price and on_sale
        echo '<s class="mionas-price__compare">'
        echo '<span class="visually-hidden">'
        echo 'content.price_regular' | t
        echo '&nbsp;</span>'
        echo selected_variant.compare_at_price | money
        echo '</s>'
      endif

      if tax_note != blank
        echo '<span class="mionas-price__tax-note">'
        echo tax_note
        echo '</span>'
      endif
    endcapture
  -%}

  {%- comment -%}
    `spacing-style` is Horizon's own class (base.css:1352-1381): it turns the four --padding-*
    custom properties the snippet writes into real padding, with 0px fallbacks, and scales anything
    above 20px responsively. Same mechanism blocks/mionas-add-to-cart.liquid uses in this card.
  {%- endcomment -%}
  {%- capture price_style -%}
    {%- render 'spacing-style', settings: block_settings -%}
  {%- endcapture -%}

  <product-price
    data-block-id="{{ block.id }}"
    data-product-id="{{ product.id }}"
    {{ block.shopify_attributes }}
  >
    <div ref="priceContainer">
      {%- render 'mionas-text',
        content: price_content,
        variant: block_settings.variant,
        size: block_settings.size,
        color: block_settings.color,
        tag: 'p',
        class: 'mionas-price spacing-style',
        style: price_style
      -%}
    </div>
  </product-price>
{%- endif -%}

{% stylesheet %}
  /* The role owns size, line-height, letter-spacing, family and colour. This adds
     display/align-items/gap, since the price is a row of two figures when a compare-at is shown,
     and font-weight, since ProductCardPrice's weight token is always 600 regardless of size.

     Colour is deliberately not overridden: --product-card-price-foreground maps to the same token
     .text-role--default already applies, so overriding it here would make the Color setting below
     do nothing.

     No padding is declared here on purpose -- it's four range settings via spacing-style,
     defaulting to 0, same mechanism as blocks/mionas-add-to-cart.liquid and Horizon's own
     blocks/_product-card.liquid, so the block imposes no inset and the composition decides. The
     horizontal inset the card needs is set per instance in the theme editor (templates/index.json,
     templates/collection.json, sections/mionas-collection.liquid's preset).

     The selector is two classes deep on purpose: every .text-role--<role> declares font-weight from
     a single-class selector in this bundle, so equal specificity would leave the winner to bundle
     order. .text-role.mionas-price is (0,2,0) and must stay that way -- padding doesn't need the
     same trick, since no .text-role rule declares padding at all. */
  /* Row-gap is zero on purpose: the tax note wraps onto a second line inside this element, and its
     vertical distance must come only from its own margin -- a row-gap would silently add to it. */
  .text-role.mionas-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-xs);
    font-weight: var(--product-card-price-font-weight);
  }

  /* The struck-through original uses the price colour at reduced opacity rather than a colour of
     its own, since the design system has no compare-at token -- that keeps it on-palette whatever
     Color resolves to. */
  .mionas-price__compare {
    opacity: 0.6;
    font-weight: var(--text-role-body-md-font-weight, 400);
  }

  /* The note is deliberately not a text role of its own: it always reads as the label-md role in
     the secondary colour, whatever Variant/Size the price uses, matching the form-label treatment.

     flex-basis: 100% forces it onto its own line inside the price's wrapping flex row, which is why
     it lives inside the text role at all: as a sibling element, a parent container's gap would open
     up between price and note. */
  .mionas-price__tax-note {
    flex-basis: 100%;
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
    color: var(--text-color-secondary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Price",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "display", "label": "Display" },
        { "value": "headline", "label": "Headline" },
        { "value": "title", "label": "Title" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" }
      ],
      "default": "body",
      "info": "The same text variants as Mionas: Text. The price keeps its own weight."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "lg", "label": "Large" },
        { "value": "md", "label": "Medium" },
        { "value": "sm", "label": "Small" }
      ],
      "default": "md",
      "info": "The step within the Variant band."
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "Show compare-at price",
      "default": false,
      "info": "Shows the original price struck through, only on products that are actually discounted."
    },
    {
      "type": "checkbox",
      "id": "show_tax_info",
      "label": "Tax information",
      "default": false,
      "info": "Shows the store's tax and shipping note under the price."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Price",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
