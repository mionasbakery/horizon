{%- doc -%}
  Renders an uppercase eyebrow/kicker in the Stamp face (Oswald, wide tracking, uppercase).
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Stamp/Stamp.tsx: an uppercase Oswald eyebrow that owns the
  typeface, tracking and uppercasing a bundled `text-role` token can't carry. Everything else still
  comes from Text -- Stamp.tsx renders `<Text variant="label" size={size}>`, so this block declares
  no font-size, line-height or colour of its own; the Size setting just picks a label-band role.

  Size defaults to `lg`, not Stamp.tsx's own `md`, matching every Stamp call site in the design
  system and the stamps already live in this theme.
{%- endcomment -%}
{%- liquid
  assign block_settings = block.settings
  assign size = block_settings.size | default: 'lg'
-%}
{%- capture content %}{% render 'mionas-inline-richtext', value: block_settings.text %}{% endcapture -%}
{%- liquid
  assign content = content | strip
  assign visible_text = content | strip_html | strip
-%}

{%- if visible_text != blank -%}
  {%- comment -%}
    block_settings.variant here is Stamp's own Color setting, not Text's band -- the id stayed
    `variant` to avoid re-migrating existing stored settings like footer-group.json's.
  {%- endcomment -%}
  {%- render 'mionas-text',
    content: content,
    variant: 'label',
    size: size,
    color: block_settings.variant,
    tag: block_settings.tag,
    class: 'mionas-stamp',
    shopify_attributes: block.shopify_attributes
  -%}
{%- endif -%}

{% stylesheet %}
  /* The selector is two classes deep on purpose, same as .text-role.mionas-price: a single-class
     selector would tie in specificity with .text-role--<role> and leave the winner to bundle order.
     Font-size, line-height and color are deliberately absent -- they must come from the
     .text-role--label-<size>/--<variant> classes the Size/Color settings pick. */
  .text-role.mionas-stamp {
    font-family: var(--stamp-base-font-family);
    font-weight: var(--stamp-base-font-weight);
    letter-spacing: var(--stamp-base-letter-spacing);
    text-transform: var(--stamp-base-text-transform);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Stamp",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Stamp</p>",
      "info": "Press Enter for a line break; it renders inside the same element, not as a new paragraph."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "lg", "label": "Large" },
        { "value": "md", "label": "Medium" },
        { "value": "sm", "label": "Small" }
      ],
      "default": "lg",
      "info": "The label-band size the stamp renders at, the same ladder as Mionas: Text."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
      ],
      "default": "p",
      "info": "Pick the semantic level; it doesn't have to match Size."
    }
  ],
  "presets": [
    {
      "name": "Mionas: Stamp",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
