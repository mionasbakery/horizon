{%- doc -%}
  Renders an uppercase eyebrow/kicker in the Stamp face (Oswald, wide tracking, uppercase).
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/components/Stamp/Stamp.tsx: an uppercase Oswald eyebrow sized to the
  text it labels. The Size setting holds that text's variant; the id stayed `size` so stored
  instances kept their key.
{%- endcomment -%}
{%- assign block_settings = block.settings -%}
{%- capture content %}{% render 'mionas-inline-richtext', value: block_settings.text %}{% endcapture -%}
{%- liquid
  assign content = content | strip
  assign visible_text = content | strip_html | strip
-%}

{%- if visible_text != blank -%}
  {%- render 'mionas-stamp', content: content, settings: block_settings, shopify_attributes: block.shopify_attributes -%}
{%- endif -%}


{% schema %}
{
  "name": "Mionas: Stamp",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Stamp</p>",
      "info": "Press Enter for a line break; it renders inside the same element, not as a new paragraph."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "display", "label": "Display" },
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "title", "label": "Title" },
        { "value": "lead", "label": "Lead" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" }
      ],
      "default": "heading",
      "info": "Match the variant of the text this stamp labels. Lead, body and label stamps sit beside their text, the others above it."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
      ],
      "default": "p",
      "info": "Pick the semantic level; it doesn't have to match Size."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Stamp",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
