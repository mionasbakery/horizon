{%- doc -%}
  Renders an uppercase eyebrow/kicker in the Stamp face (Oswald, wide tracking, uppercase).
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Stamp/Stamp.tsx: an uppercase Oswald eyebrow that owns the
  typeface, tracking and uppercasing a bundled `text-role` token can't carry. Everything else still
  comes from Text -- Stamp.tsx renders `<Text variant="label" size={size}>`, so this block declares
  no font-size, line-height or colour of its own; the Size setting just picks a label-band role.

  Size defaults to `lg`, not Stamp.tsx's own `md`, matching every Stamp call site in the design
  system and the stamps already live in this theme.
{%- endcomment -%}
{%- assign block_settings = block.settings -%}
{%- capture content %}{% render 'mionas-inline-richtext', value: block_settings.text %}{% endcapture -%}
{%- liquid
  assign content = content | strip
  assign visible_text = content | strip_html | strip
-%}

{%- if visible_text != blank -%}
  {%- render 'mionas-stamp', content: content, settings: block_settings, shopify_attributes: block.shopify_attributes -%}
{%- endif -%}


{% schema %}
{
  "name": "Mionas: Stamp",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Stamp</p>",
      "info": "Press Enter for a line break; it renders inside the same element, not as a new paragraph."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "lg", "label": "Large" },
        { "value": "md", "label": "Medium" },
        { "value": "sm", "label": "Small" }
      ],
      "default": "lg",
      "info": "The label-band size the stamp renders at, the same ladder as Mionas: Text."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "accent"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
      ],
      "default": "p",
      "info": "Pick the semantic level; it doesn't have to match Size."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Stamp",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
