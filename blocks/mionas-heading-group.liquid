{%- doc -%}
  Renders a heading with an optional stamp above it, blocks beside it and description below, as one <hgroup>.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system/src/components/HeadingGroup/HeadingGroup.tsx. One block, not a group of
  a Stamp and a Text, so the eyebrow size and the gap stay fixed in one place, as the component
  intends. The eyebrow is a <p>, so a screen reader does not announce it as a heading.

  Child blocks (a Mionas: Badge, a link) sit beside the heading in a wrapping row but outside the
  heading element, so the title is read on its own -- the component's `after`; the description is a lead paragraph whose extra top margin turns the group's
  8px gap into the component's 12px description gap.
{%- endcomment -%}
{%- liquid
  assign block_settings = block.settings
  capture eyebrow
    render 'mionas-inline-richtext', value: block_settings.eyebrow
  endcapture
  assign eyebrow = eyebrow | strip
  capture heading
    render 'mionas-inline-richtext', value: block_settings.heading
  endcapture
  assign heading = heading | strip
  assign heading_text = heading | strip_html | strip
  capture description
    render 'mionas-inline-richtext', value: block_settings.description
  endcapture
  assign description = description | strip
  assign description_text = description | strip_html | strip
-%}

{%- if heading_text != blank -%}
  <hgroup class="mionas-heading-group" {{ block.shopify_attributes }}>
    {%- assign eyebrow_text = eyebrow | strip_html | strip -%}
    {%- if eyebrow_text != blank -%}
      {%- render 'mionas-stamp', content: eyebrow, size: 'body', color: block_settings.eyebrow_color, tag: 'p' -%}
    {%- endif -%}
    {%- capture heading_markup -%}
      {%- render 'mionas-text',
        content: heading,
        variant: block_settings.heading_variant,
        color: block_settings.heading_color,
        transform: block_settings.heading_transform,
        tag: block_settings.heading_tag
      -%}
    {%- endcapture -%}
    {%- capture beside -%}{% content_for 'blocks' %}{%- endcapture -%}
    {%- if beside != blank -%}
      <div class="mionas-heading-group__row">
        {{- heading_markup -}}
        {{- beside -}}
      </div>
    {%- else -%}
      {{- heading_markup -}}
    {%- endif -%}
    {%- if description_text != blank -%}
      {%- render 'mionas-text',
        content: description,
        variant: 'lead',
        color: block_settings.description_color,
        tag: 'p',
        class: 'mionas-heading-group__description'
      -%}
    {%- endif -%}
  </hgroup>
{%- endif -%}

{% stylesheet %}
  .mionas-heading-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0;
    gap: var(--heading-group-base-gap);
  }

  /* As HeadingGroup.module.css explains: the heading's line box is trimmed to its baseline, so
     flex-end puts the badge's bottom edge on the bottom of the heading's letters. */
  .mionas-heading-group__row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--heading-group-after-gap);
  }

  .mionas-heading-group__row > :first-child {
    text-box: trim-end cap alphabetic;
  }

  /* Without text-box (Firefox), baselines line up instead, so the badge doesn't drop below the letters. */
  @supports not (text-box: trim-end cap alphabetic) {
    .mionas-heading-group__row {
      align-items: last baseline;
    }
  }

  .text-role.mionas-heading-group__description {
    margin-block-start: calc(var(--heading-group-description-gap) - var(--heading-group-base-gap));
  }
{% endstylesheet %}

