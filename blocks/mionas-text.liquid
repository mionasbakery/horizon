{%- doc -%}
  Renders a single text node styled by the design system's role/size/color vocabulary.
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Text/Text.tsx's role/size/color vocabulary directly, unlike
  Horizon's native blocks/text.liquid, which bridges its own preset typography instead.

  The Text setting is richtext, flattened to inline HTML by mionas-inline-richtext.liquid to keep
  bold/italic/link support -- the tradeoff is that the editor re-renders the section on every
  keystroke instead of live-previewing, since Shopify only live-previews a setting output raw and
  alone in its own element.

  A div is the one tag allowed to hold paragraphs, so it keeps them as rte content instead.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign tag = block_settings.tag | default: 'p'
  assign text_class = 'spacing-style'
  if tag == 'div'
    assign text_class = 'spacing-style rte'
  endif
%}
{%- capture content -%}
  {%- if tag == 'div' -%}
    {{- block_settings.text -}}
  {%- else -%}
    {%- render 'mionas-inline-richtext', value: block_settings.text -%}
  {%- endif -%}
{%- endcapture -%}
{% liquid
  assign content = content | strip

  # An "empty" richtext value is `<p></p>` or `<p><br></p>` -- not blank -- so gate on the visible
  # text, the same way snippets/text.liquid does, or the block emits an empty element.
  assign visible_text = content | strip_html | strip
%}

{%- if visible_text != blank -%}
  {%- comment -%}
    `spacing-style` is Horizon's own class (base.css): it turns the --padding-* custom properties
    the snippet writes into real padding, the same mechanism blocks/mionas-price.liquid and
    blocks/mionas-add-to-cart.liquid use, so a merchant insets this block the way they inset any
    other one rather than reaching for a group wrapper.
  {%- endcomment -%}
  {%- capture text_style -%}
    {%- render 'spacing-style', settings: block_settings -%}
    {%- if block_settings.text_wrap == 'nowrap' -%}
      white-space: nowrap;
    {%- endif -%}
  {%- endcapture -%}

  {%- render 'mionas-text',
    content: content,
    variant: block_settings.variant,
    size: block_settings.size,
    color: block_settings.color,
    tag: tag,
    class: text_class,
    style: text_style,
    shopify_attributes: block.shopify_attributes
  -%}
{%- endif -%}


{% schema %}
{
  "name": "Mionas: Text role",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>",
      "info": "Press Enter for a line break; it renders inside the same element. With the div tag, paragraphs, lists and images stay as written."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "display", "label": "Display" },
        { "value": "headline", "label": "Headline" },
        { "value": "title", "label": "Title" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" }
      ],
      "default": "body",
      "info": "The typography band, same as Text.tsx's `variant` prop."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "lg", "label": "Large" },
        { "value": "md", "label": "Medium" },
        { "value": "sm", "label": "Small" }
      ],
      "default": "md",
      "info": "The step within the Variant band."
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
      ],
      "default": "p",
      "info": "Pick the semantic level; it doesn't have to match Variant. Use div for text with several paragraphs."
    },
    {
      "type": "select",
      "id": "text_wrap",
      "label": "Text wrapping",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "nowrap", "label": "No wrap" }
      ],
      "default": "normal",
      "info": "No wrap keeps the text on one line (still breaks at an explicit line break). Useful for an address or a schedule squeezed into a narrow column."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Text",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
