{%- comment -%}
  Mirrors ../design-system/src/react/Text/Text.tsx: a single text node whose typography role and
  colour variant come straight from the design system's --text-role-* / --text-color-* tokens.

  A different file, blocks/text.liquid, is Horizon's built-in "Text" block (t:names.text) -- an
  editorial rich-text block with its own custom-size typography system flowing through
  snippets/design-system-bridge.liquid. This block does not touch that one -- it exposes the
  design system's fixed role/variant vocabulary directly, rather than bridging it onto Horizon's
  own presets. This block is named "Mionas: Text" in the block picker to
  distinguish it from "Text" (Role/Color/HTML tag settings here, vs. Type preset there). See
  docs/superpowers/specs/2026-07-20-text-role-block-design.md (written when this block was still
  named "Mionas: Text role").

  The CSS class prefix (`text-role`) and the --text-role-*/--text-color-* tokens keep their names --
  they mirror the design system's own Text.tsx `role` vocabulary, not this block's editor label.

  `tag` and `role` are independent settings, same as Text.tsx's `as` and `role` props -- a
  label-styled span or an h2 with hero styling are both valid.

  The Text setting is `richtext` so copy can span several lines, but its block-level markup is
  flattened to `<br>` before output: `tag` allows `span` and h1-h6, which may only contain inline
  content, so a raw `<p>` (or `<li>`) from the richtext toolbar inside an `<h1>` would be invalid
  HTML and get broken apart by the browser. One paragraph break becomes one `<br>` -- this block
  stays a single text node, matching Text.tsx's `children` (a ReactNode that may hold `<br/>`).
  Paragraph *spacing* is blocks/text.liquid's job (richtext rendered through `rte`), not this one's.

  Trade-off of that flattening: the theme editor only live-previews a text setting when it's output
  unfiltered and alone inside its element, so typing here re-renders the section instead of updating
  instantly. Keeping bold/italic/link on existing copy is worth that -- the alternative (a plain
  `textarea` output unfiltered, with `white-space: pre-line`) would drop inline formatting.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign tag = block_settings.tag | default: 'p'

  # Every block-level close becomes a line break, every block-level open disappears -- so a paragraph
  # or list-item boundary anywhere (including `</p><ul>`) turns into exactly one <br>, and the
  # trailing one from the last close is dropped.
  assign content = block_settings.text | strip_newlines
  assign content = content | replace: '</p>', '<br>' | replace: '</li>', '<br>'
  assign content = content | replace: '<p>', '' | replace: '<li>', ''
  assign content = content | replace: '<ul>', '' | replace: '</ul>', ''
  assign content = content | replace: '<ol>', '' | replace: '</ol>', ''
  assign content = content | strip | remove_last: '<br>' | strip

  # An "empty" richtext value is `<p></p>` or `<p><br></p>` -- not blank -- so gate on the visible
  # text, the same way snippets/text.liquid does, or the block emits an empty element.
  assign visible_text = content | strip_html | strip
%}

{%- if visible_text != blank -%}
  {%- case tag -%}
    {%- when 'span' -%}
      <span class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</span>
    {%- when 'div' -%}
      <div class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</div>
    {%- when 'h1' -%}
      <h1 class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</h1>
    {%- when 'h2' -%}
      <h2 class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</h2>
    {%- when 'h3' -%}
      <h3 class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</h3>
    {%- when 'h4' -%}
      <h4 class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</h4>
    {%- when 'h5' -%}
      <h5 class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</h5>
    {%- when 'h6' -%}
      <h6 class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</h6>
    {%- else -%}
      <p class="text-role text-role--{{ block_settings.role }} text-role--{{ block_settings.variant }}" {{ block.shopify_attributes }}>{{- content -}}</p>
  {%- endcase -%}
{%- endif -%}

{% stylesheet %}
  .text-role {
    margin: 0;
    font-family: var(--font-family-archivo);
  }

  .text-role--hero {
    font-size: var(--text-role-hero-font-size);
    line-height: var(--text-role-hero-line-height);
    font-weight: var(--text-role-hero-font-weight);
    letter-spacing: var(--text-role-hero-letter-spacing);
  }

  .text-role--title {
    font-size: var(--text-role-title-font-size);
    line-height: var(--text-role-title-line-height);
    font-weight: var(--text-role-title-font-weight);
    letter-spacing: var(--text-role-title-letter-spacing);
  }

  .text-role--subtitle {
    font-size: var(--text-role-subtitle-font-size);
    line-height: var(--text-role-subtitle-line-height);
    font-weight: var(--text-role-subtitle-font-weight);
    letter-spacing: var(--text-role-subtitle-letter-spacing);
  }

  .text-role--heading {
    font-size: var(--text-role-heading-font-size);
    line-height: var(--text-role-heading-line-height);
    font-weight: var(--text-role-heading-font-weight);
    letter-spacing: var(--text-role-heading-letter-spacing);
  }

  .text-role--subheading {
    font-size: var(--text-role-subheading-font-size);
    line-height: var(--text-role-subheading-line-height);
    font-weight: var(--text-role-subheading-font-weight);
    letter-spacing: var(--text-role-subheading-letter-spacing);
  }

  .text-role--caption {
    font-size: var(--text-role-caption-font-size);
    line-height: var(--text-role-caption-line-height);
    font-weight: var(--text-role-caption-font-weight);
    letter-spacing: var(--text-role-caption-letter-spacing);
  }

  .text-role--lead {
    font-size: var(--text-role-lead-font-size);
    line-height: var(--text-role-lead-line-height);
    font-weight: var(--text-role-lead-font-weight);
    letter-spacing: var(--text-role-lead-letter-spacing);
  }

  .text-role--body {
    font-size: var(--text-role-body-font-size);
    line-height: var(--text-role-body-line-height);
    font-weight: var(--text-role-body-font-weight);
    letter-spacing: var(--text-role-body-letter-spacing);
  }

  .text-role--label {
    font-size: var(--text-role-label-font-size);
    line-height: var(--text-role-label-line-height);
    font-weight: var(--text-role-label-font-weight);
    letter-spacing: var(--text-role-label-letter-spacing);
  }

  /* Family and transform, not just size/weight/spacing, because Text.module.css's .stamp is the one
     role that departs from the shared .root font-family. --font-family-oswald is spent directly,
     as Text.module.css does; snippets/design-system-bridge.liquid repoints it at the theme's
     loaded accent font, which is what actually puts a font file behind it. See
     docs/superpowers/specs/2026-07-20-text-role-block-design.md, "Typography". */
  .text-role--stamp {
    font-size: var(--text-role-stamp-font-size);
    line-height: var(--text-role-stamp-line-height);
    font-weight: var(--text-role-stamp-font-weight);
    letter-spacing: var(--text-role-stamp-letter-spacing);
    font-family: var(--font-family-oswald);
    text-transform: uppercase;
  }

  .text-role--default {
    color: var(--text-color-default);
  }

  .text-role--primary {
    color: var(--text-color-primary);
  }

  .text-role--inverse-primary {
    color: var(--text-color-inverse-primary);
  }

  .text-role--inverse-primary-muted {
    color: var(--text-color-inverse-primary-muted);
  }

  .text-role--accent {
    color: var(--text-color-accent);
  }

  .text-role--accent-inverse {
    color: var(--text-color-accent-inverse);
  }

  .text-role--tint {
    color: var(--text-color-tint);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Text role",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Text</p>",
      "info": "Press Enter for a line break; it renders inside the same element, not as a new paragraph."
    },
    {
      "type": "select",
      "id": "role",
      "label": "Role",
      "options": [
        { "value": "hero", "label": "Hero" },
        { "value": "title", "label": "Title" },
        { "value": "subtitle", "label": "Subtitle" },
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "caption", "label": "Caption" },
        { "value": "lead", "label": "Lead" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" },
        { "value": "stamp", "label": "Stamp" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML tag",
      "options": [
        { "value": "p", "label": "p" },
        { "value": "span", "label": "span" },
        { "value": "div", "label": "div" },
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" },
        { "value": "h3", "label": "h3" },
        { "value": "h4", "label": "h4" },
        { "value": "h5", "label": "h5" },
        { "value": "h6", "label": "h6" }
