{%- doc -%}
  Renders a header menu block.

  @param {string} [variant] - What version of the menu to render. Defaults to header menu.
  @param {string} [transparent] - Show a transparent menu
{%- enddoc -%}

{% comment %}
  Forked from blocks/_header-menu.liquid @ cd022a3 (Horizon v4.1.3, 2026-07-16). Git won't conflict
  on a separate file, so upstream changes land silently -- diff against that sha after an upstream
  merge and replay any hunks, then bump the sha here.

  Keep this a near-verbatim copy of the native file: `diff blocks/_header-menu.liquid
  blocks/mionas-header-menu.liquid` should show only these deltas.

    1. The drawer branch renders 'mionas-header-drawer' instead of 'header-drawer'.
    2. The desktop submenu renders 'mionas-header-menu-panel' instead of 'mega-menu-list'.
    3. <header-menu> -> <mionas-header-menu>, loading mionas-header-menu.js.
    4. Submenu activation is click-driven: on:click="/toggle" replaces the pointerenter /
       pointerleave / focus / blur bindings.
    5. Added panel styles at the end of the {% stylesheet %} block. The panel paints no surface of
       its own, so the native submenu keeps its own padding and scrolling.
    5b. Parent links render a disclosure chevron inside .menu-list__link-title, mirroring
       ../design-system's NavbarItem; the native file has none since upstream's menu opens on hover.
    5c. The top-level bar's font-size and font-weight are pinned to the design system's Link tokens
       (16px / 500) instead of the merchant's type_font_primary_* settings (18px/800). Family stays
       on the Shopify setting -- see the rule below for why.
    6. Schema name is "Mionas: Header menu", capitalised to match the other block/section labels.
    7. Added a "Mionas panel" settings group (panel_max_width, panel_gap, panel_columns) appended
       at the end of the settings array, and passed block_settings to the panel snippet. Appended
       rather than interleaved so an upstream settings change stays an easy replay.

  The panel CSS lives here rather than in the snippet because Liquid's {% stylesheet %} tag is only
  valid in sections and blocks. Both the desktop panel and the drawer render under this block (the
  drawer via variant: 'mobile'), so one stylesheet covers both.
{% endcomment %}

{% liquid
  assign block_settings = block.settings
  assign effective_submenu_color = block_settings.background_color | default: settings.page_background_color
%}

{% case variant %}
  {% when 'mobile' %}
    <div
      class="header__drawer"
      ref="headerDrawerContainer"
      data-hydration-key="header-drawer-mobile"
      {{ block.shopify_attributes }}
    >
      {% render 'mionas-header-drawer',
        linklist: block_settings.menu,
        data_header_drawer_type: 'mobile-drawer',
        block: block,
        section: section
      %}
    </div>

  {% when 'navigation_bar' %}
    {% if block_settings.navigation_bar == true %}
      {% render 'contrast-override',
        background_color: block_settings.background_color_navigation_bar,
        text_color: block_settings.text_color_navigation_bar,
        section_id: block.id
      %}
      <div
        class="menu-list menu-list--mobile{% if transparent == blank %} color-custom-{{ block.id }}{% endif %}"
        style="--menu-horizontal-gap: 15px; --mobile-nav-margin: auto;"
        data-hydration-key="header-menu-mobile-navigation-bar"
      >
        <div class="menu-list__scroll-container">
          <ul
            class="menu-list__list list-unstyled"
            role="list"
          >
            {% for link in block_settings.menu.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  id="MenuItem-{{ link.handle }}"
                  class="menu-list__item"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% else %}
    {% liquid
      assign block_settings = block.settings
      assign menu_content_type = block_settings.menu_style | default: 'text'
      assign image_border_radius = block_settings.image_border_radius

      render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id

      assign background_color_classes = ''
      assign background_color_setting_id = 'background_color_' | append: section.settings.menu_row
      assign current_background_color = block_settings.background_color | default: settings.page_background_color
      assign parent_background_color = section.settings[background_color_setting_id] | default: settings.page_background_color

      if parent_background_color != current_background_color or block_settings.text_color != blank
        assign background_color_classes = ' color-custom-' | append: block.id
      endif

      # Check if header and menu colors match. This is used to apply different padding styles in css
      if parent_background_color.rgb == current_background_color.rgb
        assign background_color_classes = background_color_classes | append: ' background-matches-parent'
      endif

      if block_settings.menu_style == 'featured_collections'
        assign ratio = block_settings.featured_collections_aspect_ratio
      elsif block_settings.menu_style == 'featured_products'
        assign ratio = block_settings.featured_products_aspect_ratio
      endif
    %}

    {% capture children %}
      {% for link in block_settings.menu.links %}
        <li
          role="presentation"
          class="menu-list__list-item"
          on:click="/toggle"
        >
          <a
            href="{{ link.url }}"
            data-skip-node-update="true"
            class="menu-list__link{% if link.active %} menu-list__link--active{% endif %}"
            {%- if link.links != blank -%}
              aria-controls="submenu-{{ forloop.index }}"
              aria-haspopup="true"
              aria-expanded="false"
            {%- endif -%}
            {% if link.current %}
              aria-current="page"
            {% endif %}
            ref="menuitem"
          >
            <span class="menu-list__link-title">
              {{- link.title -}}
              {%- comment -%}
                The disclosure chevron, mirroring ../design-system's NavbarItem. Rendered inside
                .menu-list__link-title, since that span carries the padding-inline setting the
                nav's horizontal rhythm -- a sibling would sit outside it and shift item spacing.
                Gated on link.links so only items that open a panel get one.
              {%- endcomment -%}
              {%- if link.links != blank -%}
                <span class="svg-wrapper icon-caret mionas-header-menu__chevron" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </span>
          </a>
          {%- if link.links != blank -%}
            <div class="menu-list__submenu{{ background_color_classes }}" ref="submenu[]">
              <div
                id="submenu-{{ forloop.index }}"
                class="menu-list__submenu-inner"
                style="{% render 'submenu-font-styles', settings: block_settings %}"
              >
                {% assign list_id = 'MegaMenuList-' | append: forloop.index %}
                <div class="mega-menu section section--full-width-margin section--{{ section.settings.section_width }}">
                  <div
                    class="mega-menu__grid"
                    data-menu-grid-id="{{ list_id }}"
                  >
                    {% render 'mionas-header-menu-panel',
                      parent_link: link,
                      id: list_id,
                      settings: block_settings
                    %}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {% endfor %}
      <li
        class="menu-list__list-item"
        role="presentation"
        slot="more"
        on:click="/toggle"
      >
        <button
          role="listitem"
          class="menu-list__link button-unstyled"
          aria-haspopup="true"
          aria-expanded="false"
          ref="menuitem"
        >
          <span class="menu-list__link-title">{{ 'actions.more' | t }}</span>
        </button>
      </li>
    {% endcapture %}

    <mionas-header-menu
      ref="headerMenu"
      class="header-menu"
      {{ block.shopify_attributes }}
      data-hydration-key="header-menu"
    >
      <div class="header-menu__inner">
        <nav
          class="menu-list"
          aria-label="{{ 'accessibility.header_navigation_label' | t }}"
          style="{% render 'menu-font-styles', settings: block_settings, menu_type: 'mega_menu' %}"
        >
          {% assign class = 'overflow-menu' | append: background_color_classes %}
          {% render 'overflow-list',
            class: class,
            ref: 'overflowMenu',
            children: children,
            minimum-items: 2,
            data-testid: 'header-menu-overflow-list',
            attributes: 'data-skip-node-update'
          %}
        </nav>
      </div>

      <script
        src="{{ 'mionas-header-menu.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
    </mionas-header-menu>
{% endcase %}

{% style %}
  .header__underlay {
    --color-submenu: rgb({{effective_submenu_color.rgb}});
  }
{% endstyle %}
{% stylesheet %}
  .header__drawer {
    --header-drawer-min-height: 60px;
    display: flex;
    min-height: var(--header-drawer-min-height);
    align-items: center;
  }

  #header-component[data-menu-style='drawer'] .header__drawer {
    display: flex;
    min-height: var(--header-drawer-min-height);
  }

  @media screen and (min-width: 750px) {
    #header-component[data-menu-style='menu'] .header__drawer {
      display: none;
      min-height: 0;
    }
  }

  .header--compact .header__drawer {
    min-height: var(--minimum-touch-target);
  }

  .menu-list--mobile {
    &.menu-list {
      display: grid;
    }

    & .menu-list__list {
      width: max-content;
      margin-inline: auto;
      gap: var(--menu-horizontal-gap);
    }

    & li {
      width: max-content;
      padding-block: var(--padding-sm);
    }

    & li:first-of-type {
      padding-inline-start: var(--menu-horizontal-gap);
    }

    & li:last-of-type {
      padding-inline-end: var(--menu-horizontal-gap);
    }

    & a {
      color: var(--color-foreground);
    }
  }

  .menu-list__scroll-container {
    position: relative;
    overflow-x: auto;
    mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 20px), transparent);
    padding-block: var(--padding-2xs);
  }

  .menu-list {
    --menu-horizontal-gap: var(--gap-xl);
    --menu-vertical-gap: var(--gap-xl);

    display: flex;
    height: 100%;
  }

  .menu-list__list {
    display: flex;
    justify-content: var(--grid-area-alignment);
  }

  .menu-list__list-item {
    flex-shrink: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .menu-list__list-item[aria-hidden='true'] {
    visibility: hidden;
  }

  .menu-list__link {
    font-family: var(--menu-top-level-font-family);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    font-size: var(--menu-top-level-font-size);
    line-height: var(--menu-top-level-font-line-height);
    text-transform: var(--menu-top-level-font-case);
    color: var(--menu-top-level-font-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    height: 100%;
    margin-block: 0;

    &::after {
      content: '';
      position: absolute;
      display: none;
      top: var(--header-padding);
      height: var(--box-height);
      left: 0;
      right: 0;
    }

    &[data-safety-box='true']::after {
      display: block;
    }

    &:hover,
    &:focus {
      color: var(--menu-top-level-font-color);
    }

    @media screen and (min-width: 750px) {
      font-size: var(--menu-top-level-font-size-desktop);
    }
  }

  .menu-list__link-title {
    padding-inline: calc(var(--gap-xl) / 2);
  }
  [slot='overflow'] .menu-list__link-title {
    padding-inline: 0;
  }

  .menu-list__list-item:not([slot='overflow']) {
    flex-direction: column;
  }
  .menu-list__list-item[slot='more']:has(.menu-list__link[aria-expanded='true'])::after {
    content: '';
    width: 100%;
    height: var(--header-padding);
    margin-bottom: calc(-1 * var(--header-padding));
  }

  [slot='overflow'] > .menu-list__link::after {
    content: none;
  }

  /*
    High specificity selectors to subdue non-hovered links without javascript.
    If the need for js-generated `hovered` and `focused` classes arises for another reason we can simplify these.
  */
  .menu-list:where(:has(.menu-list__list-item:hover)),
  .menu-list:where(:has(.menu-list__list-item:focus-within)),
  .menu-list:where(:has(.menu-list__list-item:not([aria-hidden='true']) .menu-list__link--active)) {
    .menu-list__link {
      color: rgb(var(--menu-top-level-font-color-rgb) / var(--opacity-subdued-text));
    }
  }

  /* stylelint-disable-next-line selector-max-specificity */
  .menu-list:not(:has(.menu-list__list-item:hover)) .menu-list__link--active,
  .menu-list .menu-list__list-item:where(:hover, :focus-within) .menu-list__link,
  .menu-list .menu-list__list-item:is([slot='more'], [slot='overflow']) .menu-list__link[aria-expanded='true'] {
    color: var(--menu-top-level-font-color);
  }

  .overflow-menu::part(list) {
    /* Make sure focus outline is not cut off by overflow hidden */
    --focus-outline-size: calc(var(--focus-outline-offset) + var(--focus-outline-width));

    gap: 0;
    margin-inline: calc(-1 * var(--menu-horizontal-gap) / 2);
  }

  .overflow-menu {
    /* stylelint-disable-next-line declaration-no-important */
    background-color: transparent !important;
    padding: var(--focus-outline-size);
    margin: calc(-1 * var(--focus-outline-size));
  }

  /** mega menu **/
  .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-padding-block-start: var(--padding-3xl);
    --submenu-padding-block-end: var(--padding-3xl);

    background-color: transparent;
  }

  .header__row[style*='--border-bottom-width: 0px'] {
    .menu-list__submenu.background-matches-parent,
    .overflow-menu.background-matches-parent::part(overflow) {
      --submenu-padding-block-start: 0px;
    }
  }

  .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-content-opacity: 0;
    --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.75) var(--animation-easing);

    visibility: hidden;
    position: absolute;
    width: 100%;
    left: 0;
    top: calc(100% - 1px + var(--border-bottom-width) - (var(--full-open-header-height) - var(--submenu-height)));
    z-index: var(--layer-header-menu);
    padding-inline: var(--padding-inline);
    /* Clip path starts at header height so it doesn't mess with the pointer events in the header */
    clip-path: rect(var(--header-height) 100% var(--full-open-header-height) 0); /* stylelint-disable-line */
    transition: clip-path var(--submenu-animation-speed) var(--ease-out-cubic); /* stylelint-disable-line */
  }

  [data-submenu-overlap-bottom-row] {
    .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
    .overflow-menu::part(overflow) {
      clip-path: rect(var(--top-row-height) 100% var(--full-open-header-height) 0); /* stylelint-disable-line */
    }
  }

  /* Show the submenus on hover */
  .menu-list__list-item:has([aria-expanded='true']) > .menu-list__submenu,
  /* Show the overflow menu when a menu item is hovered */
  .overflow-menu:has([slot="overflow"] [aria-expanded='true'])::part(overflow-list),
  /* Keep the submenus open when they are hovered */
  .menu-list__submenu:is(:hover),
  .overflow-menu::part(overflow):hover {
    --submenu-content-opacity: 1;

    visibility: visible;
  }

  .overflow-menu::part(overflow) {
    --menu-top-level-font-size: var(--font-size--xlarge);

    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .overflow-menu::part(overflow-list) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(auto, 200px) 1fr;
    grid-template-areas: 'left right';
    grid-template-rows: max-content;
    grid-gap: 0;
    grid-column: 2;
  }

  .menu-list__list-item:is([slot='overflow']) {
    --menu-top-level-font-color: var(--color-foreground);
    --menu-top-level-font-color-rgb: var(--color-foreground-rgb);

    display: contents;
    white-space: normal;

    .menu-list__link {
      grid-area: left;
      grid-row: auto;
      height: min-content;
      font-size: var(--font-size--xl);
      transition: var(--submenu-content-animation);
    }

    .menu-list__submenu {
      visibility: hidden;
      grid-row: 1;
      grid-area: right;
      grid-row-end: span calc(var(--overflow-count) + 1);
      padding-inline-start: var(--menu-horizontal-gap);
    }

    .menu-list__submenu-inner {
      transform: none;
      grid-column: unset;
      padding-block: 0;
    }

    .menu-list__link[aria-expanded='true'] + .menu-list__submenu {
      visibility: visible;
    }
  }

  .header-menu {
    height: 100%;
  }

  .menu-list__submenu-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .menu-list__submenu-inner,
  .overflow-menu::part(overflow-list) {
    padding-block-start: var(--submenu-padding-block-start);
    padding-block-end: var(--submenu-padding-block-end);
    padding-inline: var(--section-padding-inline);
    opacity: var(--submenu-content-opacity);
    transition: var(--submenu-content-animation);
    transform: translateY(calc(var(--full-open-header-height) - var(--submenu-height)));

    /* Make overflow menu scrollable when content exceeds viewport */
    max-height: calc(80vh - var(--header-height));
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-40)) transparent;
  }

  .mega-menu__link {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);
    white-space: normal;
    text-decoration: none;
    display: inline-flex;
    padding: var(--padding-2xs) 0;

    &:hover {
      color: var(--menu-child-active-font-color);
    }
  }

  .mega-menu__link--parent {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);

    &:hover {
      color: var(--menu-parent-active-font-color);
    }
  }

  @media screen and (max-width: 989px) {
    .mega-menu__content-list-item--hidden-tablet {
      display: none;
    }
  }

  .mega-menu__link:has(.mega-menu__link-image) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__link-image {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    object-fit: cover;
    border-radius: var(--menu-image-border-radius);
  }

  /* Fix alignment for collection image mode links without images */

  /* Target only top-level links (direct children of column > div) in collection image mode */
  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image)) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image))::before {
    content: '';
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    background-color: var(--color-foreground-muted);
    opacity: 0.1;
    border-radius: var(--menu-image-border-radius);
  }

  .mega-menu__grid {
    display: grid;
    grid-template-columns: repeat(var(--menu-columns-tablet), minmax(0, 1fr));
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
    width: 100%;

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__column {
    grid-column: span 1;
  }

  .mega-menu__column--span-2 {
    grid-column: span 2;
  }

  .mega-menu__column--span-3 {
    grid-column: span 3;
  }

  .mega-menu__column--span-4 {
    grid-column: span 4;
  }

  .mega-menu__column--wide-collection-image {
    grid-column: span 1;

    @media screen and (min-width: 990px) {
      grid-column: span 2;
    }
  }

  .mega-menu__submenu .mega-menu__column--wide-collection-image {
    grid-column: span 1;
  }

  .mega-menu__content-list {
    display: grid;
    justify-content: end;
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
  }

  .mega-menu__content-list--products {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 1fr));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__content-list--collections {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 300px));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 300px));
    }
  }

  .mega-menu__list {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: span var(--menu-columns-tablet);
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-columns-desktop);
    }
  }

  .mega-menu__content {
    grid-column: span var(--menu-content-columns-tablet) / -1;

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-content-columns-desktop) / -1;
    }
  }

  .menu-list__list-item[slot='overflow'] .section {
    grid-template-columns: 1fr;
  }

  .menu-list__list-item[slot='overflow'] .section .mega-menu__grid {
    grid-column: 1;
  }

  .mega-menu__content-list li {
    white-space: normal;
  }

  /* mega more menu */
  .mega-menu__more-list {
    --menu-child-font-size: var(--font-size--xl);

    width: 200px;
  }

  .mega-menu__submenu {
    /* preserves the inherited grid layout when this submenu wrapper is used */
    display: contents;
  }

  /* Hide product cards in collapsed submenus from the IntersectionObserver that fires product view events */
  .menu-list__list-item:not(:has([aria-expanded='true'])) > .menu-list__submenu product-component {
    display: none;
  }

  /** mionas header menu panel **/

  /* The disclosure chevron, mirroring ../design-system's NavbarItem. Scoped with :has() so only
     parent links get one; childless links and the native "More" trigger keep a plain title.

     No base rotation: assets/icon-caret.svg already points down (NavbarItem's closed state), so
     only the open state needs a transform. Using the SVG rather than the design system's rotated
     '›' glyph matches what the drawer and native mega menu already render, and its shape doesn't
     change with the merchant's font setting.

     Rotates the inner svg, not the wrapper, and declares no transition of its own: assets/base.css
     already gives `.icon-caret svg` the theme's transform transition via its --forward/--backward
     modifiers, so this inherits the theme's animation speed, easing and reduced-motion handling.

     Colour comes from the svg's own `stroke="currentColor"`, tracking the link's hover/active state.

     No label-to-chevron gap token is spent: the icon box is already wider than the glyph it draws,
     so a gap token reads as too much space on screen. Check a future gap token against the
     rendered nav before adopting it. */
  /* Top-level nav type pinned to the design system: the bar was rendering at 18px/800 (the
     merchant's type_font_primary_size plus the heading role's weight); NavbarItem composes Link at
     16px/500, so Link's tokens are the correct source, not a --navbar-item-* one.

     The 500 weight has to be pinned in CSS, not the theme editor: the theme's four font settings
     load 400/600/700/800 and no 500 -- snippets/design-system-bridge.liquid emits an extra Archivo
     500 face for exactly this. Family is left untouched on --menu-top-level-font-family so Shopify
     keeps hosting/preloading it; only size and weight move here.

     Consequence: type_font_primary_size and type_font_primary_link no longer affect the desktop
     bar's size or weight (still drives family) -- an intended trade so the nav tracks the design
     system rather than a merchant setting.

     Specificity (0,2,0) via the parent <li>, not a bare .menu-list__link (0,1,0): the base rule's
     font-size sits inside a media query, which adds no specificity, so a bare class would only tie
     and depend on source order. */
  .menu-list__list-item > .menu-list__link {
    font-size: var(--link-size-md-font-size);
    font-weight: var(--link-base-font-weight);
  }

  /* Centred, with no gap -- settled by eye against the rendered nav rather than derived: baseline
     alignment plus a 4px gap were both tried and looked wrong on screen despite the math seeming
     to favor them.

     align-items: center, not baseline: uppercase text has no descenders, so centring reads
     correctly; the residual optical offset is corrected on the chevron itself instead.

     No gap: .svg-wrapper's icon box is already wider than the caret glyph it draws (~13.6px box,
     ~8px glyph), so any gap would stack on top of that built-in space. To adjust spacing, change
     the box size or the asset, not this gap. */
  .menu-list__link-title:has(.mionas-header-menu__chevron) {
    display: inline-flex;
    align-items: center;
  }

  /* base.css gives both .svg-wrapper and .svg-wrapper > svg the same --icon-size-sm (20px), taller
     than this label's line box, so the chevron read oversized and knocked the text off centre.
     .svg-wrapper--small only resizes the wrapper and leaves `> svg` at --icon-size-sm, so both
     selectors are overridden here.

     Compounded with .svg-wrapper to reach (0,2,0)/(0,2,1), beating base.css's (0,1,0)/(0,1,1) on
     specificity rather than relying on source order.

     (Never write a Liquid tag name in braces inside this stylesheet, even in a comment: theme
     check's StaticStylesheetAndJavascriptTags rule parses the block for Liquid and errors on it.)

     flex: none keeps the title's flex layout from stretching or shrinking it.

     The translate corrects the SVG asset, not the layout: icon-caret.svg's path sits half a unit
     below the box's vertical centre in its 14-unit viewBox, so it always draws 0.5/14 of the box
     height low. Expressed as that ratio so it stays correct if the size token changes. */
  .svg-wrapper.mionas-header-menu__chevron,
  .svg-wrapper.mionas-header-menu__chevron > svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    flex: none;
  }

  .svg-wrapper.mionas-header-menu__chevron {
    transform: translateY(calc(-0.5 / 14 * var(--icon-size-xs)));
  }

  .menu-list__link[aria-expanded='true'] .mionas-header-menu__chevron svg {
    transform: rotate(180deg);
  }

  /* No `.mionas-header-menu-panel` surface rule here on purpose: the dropdown already sits on the
     header's own background, so painting a second surface behind it would double it. That also
     means no full-bleed breakout is needed, so the native .menu-list__submenu-inner keeps its own
     padding and scroll behaviour (overflow-x: hidden + max-height) unclipped.

     If a full-bleed painted panel is ever wanted again, it needs a background/shadow rule here plus
     matching :has() overrides on .mega-menu__grid and .menu-list__submenu-inner to cancel native
     padding and overflow -- they only work together as a set. */

  /* Centres and caps the content. No background, no shadow, no padding: the native
     .menu-list__submenu-inner already supplies the panel's padding, so declaring it here too
     would double it.

     max-width stays a literal: the design system doesn't tokenise layout geometry either --
     MegaMenu.module.css hard-codes the same max-width: 1240px. */
  .mionas-header-menu-panel__inner {
    max-width: var(--mionas-header-menu-panel-max-width, 1240px);
    margin-inline: auto;
  }

  /* One column below 750px (the same card as desktop, stacked vertically), then 3, then the
     configured count. Card internals are identical at every width - only the track count
     changes, which is what lets one snippet serve both the desktop panel and the drawer. */
  .mionas-header-menu-panel__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--mionas-header-menu-panel-gap, var(--mega-menu-base-gap));
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .mionas-header-menu-panel__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .mionas-header-menu-panel__grid {
      grid-template-columns: repeat(var(--mionas-header-menu-panel-columns, 6), minmax(0, 1fr));
    }
  }

  /* Spends MegaMenuItem's own tokens rather than raw --space-xs/--radius-lg primitives. Radius and
     padding resolve to the same 12px/8px as before; the gap is a real change -- MegaMenuItem asks
     for space.sm (12px) between media and text, not space.xs (8px).

     :active mirrors MegaMenuItem's own pressed state. */
  .mionas-header-menu-panel__card {
    display: flex;
    flex-direction: column;
    gap: var(--mega-menu-item-base-gap);
    padding: var(--mega-menu-item-base-padding);
    border-radius: var(--mega-menu-item-base-radius);
    text-decoration: none;
  }

  .mionas-header-menu-panel__card:active {
    opacity: var(--mega-menu-item-state-pressed-opacity);
  }

  /* Not drawer-scoped: the desktop mega menu's cards get the same hover treatment (label colour +
     image zoom). --mega-menu-item-state-hover-foreground is MegaMenuItem's own label-hover token.

     The drawer usually runs on a touch device, where :hover rarely fires -- this is polish for
     pointer/keyboard users; the caret is what signals a row is tappable there. */
  .mionas-header-menu-panel__card:hover .mionas-header-menu-panel__label,
  .mionas-header-menu-panel__card:focus-visible .mionas-header-menu-panel__label {
    color: var(--mega-menu-item-state-hover-foreground);
  }

  .mionas-header-menu-panel__card:hover .mionas-header-menu-panel__image,
  .mionas-header-menu-panel__card:focus-visible .mionas-header-menu-panel__image {
    transform: scale(var(--mega-menu-item-state-hover-scale));
  }

  /* Colour always transitions; the zoom is motion, so it only runs when motion is welcome. */
  .mionas-header-menu-panel__label {
    transition: color 200ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mionas-header-menu-panel__image {
      transition: transform 200ms ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mionas-header-menu-panel__card:hover .mionas-header-menu-panel__image,
    .mionas-header-menu-panel__card:focus-visible .mionas-header-menu-panel__image {
      transform: none;
    }
  }

  /* Fixed media height keeps rows aligned when some cards have no tagline; 110px is single-sourced
     from the design system's own value.

     The radius is a real change: MegaMenuItem splits card radius (lg, 12px) from media radius
     (md, 8px), rather than reusing one radius for both as before. */
  .mionas-header-menu-panel__media {
    display: block;
    height: var(--mega-menu-item-base-media-height);
    border-radius: var(--mega-menu-item-base-media-radius);
    overflow: hidden;
  }

  .mionas-header-menu-panel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Size, line-height and letter-spacing come from the caption type role; MegaMenuItem's label only
     overrides weight and colour, so those two move here, now from MegaMenuItem's own tokens
     (previously borrowed from Card, at the identical values).

     Weight is a genuine change: label asks for 700, not the caption role's 500. Confirmed 700 is
     one of the four Archivo weights already loaded (per snippets/design-system-bridge.liquid), so
     it renders on a real face rather than a synthesised faux-bold. */
  .mionas-header-menu-panel__label {
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    font-weight: var(--mega-menu-item-label-font-weight);
    letter-spacing: var(--text-role-label-lg-letter-spacing);
    color: var(--mega-menu-item-label-foreground);
  }

  .mionas-header-menu-panel__tagline {
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
    color: var(--mega-menu-item-description-foreground);
  }

  /* The card's label and tagline live in this wrapper for the drawer's row grid (thumb | text |
     caret) -- without it they're separate grid items and can't share a column.

     No gap on desktop: MegaMenuItem's .text declares no gap and Text sets margin: 0, so label and
     description sit flush as one block.

     The drawer variant re-adds --space-3xs below since its rows are taller and touch-targeted,
     unlike the dense desktop grid. */
  .mionas-header-menu-panel__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ── Drawer variant ── */
  .mionas-header-menu-panel.mionas-header-menu-panel--drawer {
    /* width: 100%, not auto -- this is the only thing giving the panel a width in the drawer. The
       flat branch's <li> uses align-items: flex-start (snippets/mionas-header-drawer.liquid:850-855),
       which cancels the default stretch, so a width:auto child sizes to fit-content and the card
       group renders narrower than the top-level rows, with carets out of line. */
    width: 100%;
  }

  /* __inner caps and centres the desktop content at 1240px, neither of which is wanted inside a
     ~400px drawer. */
  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__inner {
    max-width: none;
    margin-inline: 0;
  }

  /* The panel's grid rules above are width-based, but the drawer is not width-gated (see the doc
     block in snippets/mionas-header-menu-panel.liquid), so those rules would otherwise fire inside
     the drawer at tablet width. Pinning one column here at specificity (0,2,0) wins regardless of
     source order -- don't replace with a max-width media query, since width isn't what selects the
     drawer. */
  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs);
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__card {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;

    /* Same token the desktop card spends, so the drawer row tracks the design system too --
       MegaMenuItem uses one gap for both column and row layout. */
    gap: var(--mega-menu-item-base-gap);

    /* Zeroed so the thumbnail's left edge lines up with the section heading and the childless
       top-level rows (.menu-drawer__menu-item, no inline padding). Nothing paints behind the card,
       so inline padding here would only misalign. */
    padding-inline: 0;
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__text {
    gap: var(--space-3xs);
  }

  /* A fixed square, not the desktop card's full-width 110px band. The warm background shows
     through for links with no image (page/blog links, imageless collections), so rows stay aligned.

     Stays 56px rather than MegaMenuItem's --mega-menu-item-base-media-size (40px): that token sizes
     a viewport breakpoint, while this drawer is selected by touch or nav overflow at any width (see
     the doc block in snippets/mionas-header-menu-panel.liquid). 56px is also load-bearing beyond
     the CSS -- the snippet requests `sizes: 56px` and it's a 44px-plus touch target.

     The background fill is swapped for MegaMenuItem's warm-200 (#ece8e2), replacing an eyeballed
     --color-warm-100. */
  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__media {
    width: 56px;
    height: 56px;
    border-radius: var(--mega-menu-item-base-media-radius);
    background: var(--mega-menu-item-base-media-background);
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__label {
    font-size: var(--text-role-title-sm-font-size);
    line-height: var(--text-role-title-sm-line-height);
    font-weight: var(--text-role-title-sm-font-weight);
    letter-spacing: var(--text-role-title-sm-letter-spacing);
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__caret {
    display: flex;
    align-items: center;
    color: var(--color-neutral-400);
  }

  /* The parent-with-children row, rendered as a <span> by snippets/mionas-header-drawer.liquid. It
     keeps .menu-drawer__menu-item and --mainlist for the font family and layout they still supply
     (snippets/mionas-header-drawer.liquid:898-905, :965-972, :888-892) once the link affordances
     are undone below. Those base rules live in the drawer snippet's own stylesheet, so these
     overrides must win on specificity -- source order between two separate stylesheet tags isn't
     guaranteed. */
  /* Four classes deliberately: snippets/mionas-header-drawer.liquid's divider rule is (0,3,0) and
     re-imposes a ~48px min-height on this inert heading when drawer_dividers is on. A (0,3,0)
     selector here would only tie and fall back to unguaranteed source order; (0,4,0) wins outright. */
  /* A Stamp mirror: weight, tracking and transform from Stamp's component tokens, size from the
     label-lg band Stamp renders Text at. No --stamp-base-font-family on purpose -- this row
     inherits --mainlist's --menu-top-level-font-* family (see just above), and switching it to
     Oswald would be a new design decision rather than part of the design-system sync. */
  .menu-drawer__menu .menu-drawer__menu-item.menu-drawer__menu-item--mainlist.menu-drawer__menu-item--mionas-heading {
    min-height: 0;
    padding-block: var(--space-sm) var(--space-xs);
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    font-weight: var(--stamp-base-font-weight);
    letter-spacing: var(--stamp-base-letter-spacing);
    text-transform: var(--stamp-base-text-transform);
    color: var(--color-vermell-segell);
    justify-content: flex-start;
    cursor: default;
  }

  /* Currently redundant -- the heading rule above is (0,4,0) and already beats --mainlist's
     &:hover at (0,2,0). Kept as a forward guard in case that specificity relationship changes;
     don't delete it for "doing nothing today". */
  .menu-drawer__menu .menu-drawer__menu-item--mionas-heading:hover {
    color: var(--color-vermell-segell);
  }

  /* The drawer's top-level rows are sentence case while the section heading stays uppercase.
     Overridden here rather than flipping type_case_primary_link, which would also affect the
     desktop nav. :not() excludes the heading, which sets its own uppercase above. */
  .menu-drawer__menu .menu-drawer__menu-item--mainlist:not(.menu-drawer__menu-item--mionas-heading) {
    text-transform: none;
  }

  /* One hairline after each card group, separating it from the plain rows beneath. Independent of
     the block's drawer_dividers setting, which applies to every item. :not(:last-child) so a group
     that's the menu's final item doesn't draw a rule with nothing under it. */
  .menu-drawer__list-item--flat:has(.mionas-header-menu-panel):not(:last-child) {
    border-block-end: 1px solid var(--color-warm-200);
    padding-block-end: var(--space-md);
    margin-block-end: var(--space-2xs);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Header menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "paragraph",
      "content": "t:content.menu_appearance_paragraph"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_font_primary_size",
      "label": "t:settings.top_level_size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "1rem"
    },
    {
      "type": "select",
      "id": "menu_font_style",
      "label": "t:settings.submenu_size",
      "options": [
        {
          "value": "regular",
          "label": "t:options.small"
        },
        {
          "value": "inverse",
          "label": "t:options.medium"
        },
        {
          "value": "inverse_large",
          "label": "t:options.large"
        }
      ],
      "default": "inverse"
    },
    {
      "type": "select",
      "id": "type_font_primary_link",
      "label": "t:settings.font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "accent",
          "label": "t:options.accent"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "type_case_primary_link",
      "label": "t:settings.text_case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "t:content.submenu_feature"
    },
    {
      "type": "select",
      "id": "menu_style",
      "label": "t:settings.media_type",
      "info": "t:info.media_type_info",
      "options": [
        {
          "value": "text",
          "label": "t:options.none"
        },
        {
          "value": "collection_images",
          "label": "t:options.collection_images"
        },
        {
          "value": "featured_products",
          "label": "t:options.featured_products"
        },
        {
          "value": "featured_collections",
          "label": "t:options.featured_collections"
        }
      ],
      "default": "collection_images"
    },
    {
      "type": "select",
      "id": "featured_products_aspect_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "4 / 5",
          "label": "t:options.portrait"
        },
        {
          "value": "1 / 1",
          "label": "t:options.square"
        }
      ],
      "default": "4 / 5",
      "visible_if": "{{ block.settings.menu_style == 'featured_products' }}"
    },
    {
      "type": "select",
      "id": "featured_collections_aspect_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "16 / 9",
          "label": "t:options.landscape"
        },
        {
          "value": "1 / 1",
          "label": "t:options.square"
        }
      ],
      "default": "16 / 9",
      "visible_if": "{{ block.settings.menu_style == 'featured_collections' }}"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "t:settings.image_border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.menu_style != 'text' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "checkbox",
      "id": "navigation_bar",
      "label": "t:settings.navigation_bar"
    },
    {
      "type": "color",
      "id": "background_color_navigation_bar",
      "label": "t:settings.navigation_bar_background_color",
      "default": "{{ settings.color_palette.background }}",
      "visible_if": "{{ block.settings.navigation_bar }}"
    },
    {
      "type": "color",
      "id": "text_color_navigation_bar",
      "label": "t:settings.navigation_bar_text_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.navigation_bar }}"
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion",
      "label": "t:settings.accordion",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "drawer_accordion_expand_first",
      "label": "t:settings.expand_first_group",
      "default": false,
      "visible_if": "{{ block.settings.drawer_accordion == true }}"
    },
    {
      "type": "checkbox",
      "id": "drawer_dividers",
      "label": "t:settings.dividers",
      "default": false
    },
    {
      "type": "header",
      "content": "Mionas panel"
    },
    {
      "type": "paragraph",
      "content": "Layout of the card panel shown under a menu item with children. The panel has no surface of its own — it sits on the header's background and takes its padding from the dropdown."
    },
    {
      "type": "range",
      "id": "panel_max_width",
      "label": "Content max width",
      "min": 800,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "panel_columns",
      "label": "Columns on desktop",
      "info": "Applies from 990px. Below that the panel is 3 columns, then 1 column under 750px.",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 6
    }
  ]
}
{% endschema %}
