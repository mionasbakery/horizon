{%- doc -%}
  Renders a header menu block.

  @param {string} [variant] - What version of the menu to render. Defaults to header menu.
  @param {string} [transparent] - Show a transparent menu
{%- enddoc -%}

{% comment %}
  FORKED FROM: blocks/_header-menu.liquid @ cd022a3 (Horizon v4.1.3, 2026-07-16)

  RE-SYNC AFTER EVERY UPSTREAM MERGE. Git will never conflict here - this is a separate file,
  so upstream's changes to _header-menu.liquid land silently and this copy quietly goes stale.
  That file saw 13 upstream commits in the last 12 months, so assume it moved.

      git log  cd022a3..HEAD -- blocks/_header-menu.liquid   # empty? nothing to do
      git diff cd022a3..HEAD -- blocks/_header-menu.liquid   # else: replay these hunks here

  Then bump the sha above. The delta list below tells you which lines are intentionally ours
  and must survive the replay.

  FORK OF blocks/_header-menu.liquid. Keep this a near-verbatim copy: the ONLY intended deltas
  are listed here, and `diff blocks/_header-menu.liquid blocks/mionas-header-menu.liquid` should
  show nothing else. Do not tidy or reformat the copied code.

    1. The drawer branch renders 'mionas-header-drawer' instead of 'header-drawer'.
    2. The desktop submenu renders 'mionas-header-menu-panel' instead of 'mega-menu-list'.
    3. <header-menu> -> <mionas-header-menu>, loading mionas-header-menu.js.
    4. Submenu activation is click-driven: on:click="/toggle" replaces the pointerenter /
       pointerleave / focus / blur bindings.
    5. Added panel styles at the end of the {% stylesheet %} block, laying out the card panel.
       These used to include a 100vw full-bleed breakout and :has()-scoped overrides cancelling
       the native ancestors' padding and overflow, all so the panel could paint an edge-to-edge
       surface. The panel paints nothing now, so all of that is gone and the native submenu keeps
       its own padding and scrolling - see the long note where the panel's own rule used to be.
    5b. Parent links render a disclosure chevron inside .menu-list__link-title, with its rules at
       the top of the added styles. Mirrors ../design-system's NavbarItem; the native file has no
       chevron because upstream's menu opens on hover.
    5c. The top-level bar's font-size and font-weight are pinned to the design system's Link tokens
       (16px / 500) instead of the merchant's type_font_primary_* settings, which rendered 18px/800.
       Family is deliberately left on the Shopify setting. See the rule for the full reasoning.
    6. Schema name is "Mionas: Header menu" (capitalised to match the other 19 "Mionas: X" block
       and section labels; it read "Mionas: header menu" until the mega menu design sync).
    7. Added a "Mionas panel" settings group (panel_max_width, panel_gap, panel_columns) at the END
       of the settings array, and passed block_settings to the panel snippet. Appended rather than
       interleaved so an upstream change to the native settings stays an easy replay. The group also
       carried panel_background, panel_shadow, panel_padding_block and panel_padding_inline until
       the panel stopped painting a surface of its own; they were removed rather than left inert.

  WHY THE PANEL CSS LIVES HERE AND NOT IN THE SNIPPET: Liquid's {% stylesheet %} tag is only
  valid in sections and blocks, never in snippets. Both the desktop panel and the drawer are
  rendered under this same block (the drawer via variant: 'mobile'), so one stylesheet here
  covers both contexts.
{% endcomment %}

{% liquid
  assign block_settings = block.settings
  assign effective_submenu_color = block_settings.background_color | default: settings.page_background_color
%}

{% case variant %}
  {% when 'mobile' %}
    <div
      class="header__drawer"
      ref="headerDrawerContainer"
      data-hydration-key="header-drawer-mobile"
      {{ block.shopify_attributes }}
    >
      {% render 'mionas-header-drawer',
        linklist: block_settings.menu,
        data_header_drawer_type: 'mobile-drawer',
        block: block,
        section: section
      %}
    </div>

  {% when 'navigation_bar' %}
    {% if block_settings.navigation_bar == true %}
      {% render 'contrast-override',
        background_color: block_settings.background_color_navigation_bar,
        text_color: block_settings.text_color_navigation_bar,
        section_id: block.id
      %}
      <div
        class="menu-list menu-list--mobile{% if transparent == blank %} color-custom-{{ block.id }}{% endif %}"
        style="--menu-horizontal-gap: 15px; --mobile-nav-margin: auto;"
        data-hydration-key="header-menu-mobile-navigation-bar"
      >
        <div class="menu-list__scroll-container">
          <ul
            class="menu-list__list list-unstyled"
            role="list"
          >
            {% for link in block_settings.menu.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  id="MenuItem-{{ link.handle }}"
                  class="menu-list__item"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% else %}
    {% liquid
      assign block_settings = block.settings
      assign menu_content_type = block_settings.menu_style | default: 'text'
      assign image_border_radius = block_settings.image_border_radius

      render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id

      assign background_color_classes = ''
      assign background_color_setting_id = 'background_color_' | append: section.settings.menu_row
      assign current_background_color = block_settings.background_color | default: settings.page_background_color
      assign parent_background_color = section.settings[background_color_setting_id] | default: settings.page_background_color

      if parent_background_color != current_background_color or block_settings.text_color != blank
        assign background_color_classes = ' color-custom-' | append: block.id
      endif

      # Check if header and menu colors match. This is used to apply different padding styles in css
      if parent_background_color.rgb == current_background_color.rgb
        assign background_color_classes = background_color_classes | append: ' background-matches-parent'
      endif

      if block_settings.menu_style == 'featured_collections'
        assign ratio = block_settings.featured_collections_aspect_ratio
      elsif block_settings.menu_style == 'featured_products'
        assign ratio = block_settings.featured_products_aspect_ratio
      endif
    %}

    {% capture children %}
      {% for link in block_settings.menu.links %}
        <li
          role="presentation"
          class="menu-list__list-item"
          on:click="/toggle"
        >
          <a
            href="{{ link.url }}"
            data-skip-node-update="true"
            class="menu-list__link{% if link.active %} menu-list__link--active{% endif %}"
            {%- if link.links != blank -%}
              aria-controls="submenu-{{ forloop.index }}"
              aria-haspopup="true"
              aria-expanded="false"
            {%- endif -%}
            {% if link.current %}
              aria-current="page"
            {% endif %}
            ref="menuitem"
          >
            <span class="menu-list__link-title">
              {{- link.title -}}
              {%- comment -%}
                The disclosure chevron, mirroring ../design-system's NavbarItem. Rendered INSIDE
                .menu-list__link-title on purpose: that span carries the padding-inline that
                creates the top-level nav's horizontal rhythm, so a sibling of it would sit half a
                --gap-xl away from the word and moving that padding would change item spacing (and
                the overflow-list height measurement that reads these links). Gated on
                link.links so only items that actually open a panel get one.
              {%- endcomment -%}
              {%- if link.links != blank -%}
                <span class="svg-wrapper icon-caret mionas-header-menu__chevron" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              {%- endif -%}
            </span>
          </a>
          {%- if link.links != blank -%}
            <div class="menu-list__submenu{{ background_color_classes }}" ref="submenu[]">
              <div
                id="submenu-{{ forloop.index }}"
                class="menu-list__submenu-inner"
                style="{% render 'submenu-font-styles', settings: block_settings %}"
              >
                {% assign list_id = 'MegaMenuList-' | append: forloop.index %}
                <div class="mega-menu section section--full-width-margin section--{{ section.settings.section_width }}">
                  <div
                    class="mega-menu__grid"
                    data-menu-grid-id="{{ list_id }}"
                  >
                    {% render 'mionas-header-menu-panel',
                      parent_link: link,
                      id: list_id,
                      settings: block_settings
                    %}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {% endfor %}
      <li
        class="menu-list__list-item"
        role="presentation"
        slot="more"
        on:click="/toggle"
      >
        <button
          role="listitem"
          class="menu-list__link button-unstyled"
          aria-haspopup="true"
          aria-expanded="false"
          ref="menuitem"
        >
          <span class="menu-list__link-title">{{ 'actions.more' | t }}</span>
        </button>
      </li>
    {% endcapture %}

    <mionas-header-menu
      ref="headerMenu"
      class="header-menu"
      {{ block.shopify_attributes }}
      data-hydration-key="header-menu"
    >
      <div class="header-menu__inner">
        <nav
          class="menu-list"
          aria-label="{{ 'accessibility.header_navigation_label' | t }}"
          style="{% render 'menu-font-styles', settings: block_settings, menu_type: 'mega_menu' %}"
        >
          {% assign class = 'overflow-menu' | append: background_color_classes %}
          {% render 'overflow-list',
            class: class,
            ref: 'overflowMenu',
            children: children,
            minimum-items: 2,
            data-testid: 'header-menu-overflow-list',
            attributes: 'data-skip-node-update'
          %}
        </nav>
      </div>

      <script
        src="{{ 'mionas-header-menu.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
    </mionas-header-menu>
{% endcase %}

{% style %}
  .header__underlay {
    --color-submenu: rgb({{effective_submenu_color.rgb}});
  }
{% endstyle %}
{% stylesheet %}
  .header__drawer {
    --header-drawer-min-height: 60px;
    display: flex;
    min-height: var(--header-drawer-min-height);
    align-items: center;
  }

  #header-component[data-menu-style='drawer'] .header__drawer {
    display: flex;
    min-height: var(--header-drawer-min-height);
  }

  @media screen and (min-width: 750px) {
    #header-component[data-menu-style='menu'] .header__drawer {
      display: none;
      min-height: 0;
    }
  }

  .header--compact .header__drawer {
    min-height: var(--minimum-touch-target);
  }

  .menu-list--mobile {
    &.menu-list {
      display: grid;
    }

    & .menu-list__list {
      width: max-content;
      margin-inline: auto;
      gap: var(--menu-horizontal-gap);
    }

    & li {
      width: max-content;
      padding-block: var(--padding-sm);
    }

    & li:first-of-type {
      padding-inline-start: var(--menu-horizontal-gap);
    }

    & li:last-of-type {
      padding-inline-end: var(--menu-horizontal-gap);
    }

    & a {
      color: var(--color-foreground);
    }
  }

  .menu-list__scroll-container {
    position: relative;
    overflow-x: auto;
    mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 20px), transparent);
    padding-block: var(--padding-2xs);
  }

  .menu-list {
    --menu-horizontal-gap: var(--gap-xl);
    --menu-vertical-gap: var(--gap-xl);

    display: flex;
    height: 100%;
  }

  .menu-list__list {
    display: flex;
    justify-content: var(--grid-area-alignment);
  }

  .menu-list__list-item {
    flex-shrink: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .menu-list__list-item[aria-hidden='true'] {
    visibility: hidden;
  }

  .menu-list__link {
    font-family: var(--menu-top-level-font-family);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    font-size: var(--menu-top-level-font-size);
    line-height: var(--menu-top-level-font-line-height);
    text-transform: var(--menu-top-level-font-case);
    color: var(--menu-top-level-font-color);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    height: 100%;
    margin-block: 0;

    &::after {
      content: '';
      position: absolute;
      display: none;
      top: var(--header-padding);
      height: var(--box-height);
      left: 0;
      right: 0;
    }

    &[data-safety-box='true']::after {
      display: block;
    }

    &:hover,
    &:focus {
      color: var(--menu-top-level-font-color);
    }

    @media screen and (min-width: 750px) {
      font-size: var(--menu-top-level-font-size-desktop);
    }
  }

  .menu-list__link-title {
    padding-inline: calc(var(--gap-xl) / 2);
  }
  [slot='overflow'] .menu-list__link-title {
    padding-inline: 0;
  }

  .menu-list__list-item:not([slot='overflow']) {
    flex-direction: column;
  }
  .menu-list__list-item[slot='more']:has(.menu-list__link[aria-expanded='true'])::after {
    content: '';
    width: 100%;
    height: var(--header-padding);
    margin-bottom: calc(-1 * var(--header-padding));
  }

  [slot='overflow'] > .menu-list__link::after {
    content: none;
  }

  /*
    High specificity selectors to subdue non-hovered links without javascript.
    If the need for js-generated `hovered` and `focused` classes arises for another reason we can simplify these.
  */
  .menu-list:where(:has(.menu-list__list-item:hover)),
  .menu-list:where(:has(.menu-list__list-item:focus-within)),
  .menu-list:where(:has(.menu-list__list-item:not([aria-hidden='true']) .menu-list__link--active)) {
    .menu-list__link {
      color: rgb(var(--menu-top-level-font-color-rgb) / var(--opacity-subdued-text));
    }
  }

  /* stylelint-disable-next-line selector-max-specificity */
  .menu-list:not(:has(.menu-list__list-item:hover)) .menu-list__link--active,
  .menu-list .menu-list__list-item:where(:hover, :focus-within) .menu-list__link,
  .menu-list .menu-list__list-item:is([slot='more'], [slot='overflow']) .menu-list__link[aria-expanded='true'] {
    color: var(--menu-top-level-font-color);
  }

  .overflow-menu::part(list) {
    /* Make sure focus outline is not cut off by overflow hidden */
    --focus-outline-size: calc(var(--focus-outline-offset) + var(--focus-outline-width));

    gap: 0;
    margin-inline: calc(-1 * var(--menu-horizontal-gap) / 2);
  }

  .overflow-menu {
    /* stylelint-disable-next-line declaration-no-important */
    background-color: transparent !important;
    padding: var(--focus-outline-size);
    margin: calc(-1 * var(--focus-outline-size));
  }

  /** mega menu **/
  .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-padding-block-start: var(--padding-3xl);
    --submenu-padding-block-end: var(--padding-3xl);

    background-color: transparent;
  }

  .header__row[style*='--border-bottom-width: 0px'] {
    .menu-list__submenu.background-matches-parent,
    .overflow-menu.background-matches-parent::part(overflow) {
      --submenu-padding-block-start: 0px;
    }
  }

  .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-content-opacity: 0;
    --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.75) var(--animation-easing);

    visibility: hidden;
    position: absolute;
    width: 100%;
    left: 0;
    top: calc(100% - 1px + var(--border-bottom-width) - (var(--full-open-header-height) - var(--submenu-height)));
    z-index: var(--layer-header-menu);
    padding-inline: var(--padding-inline);
    /* Clip path starts at header height so it doesn't mess with the pointer events in the header */
    clip-path: rect(var(--header-height) 100% var(--full-open-header-height) 0); /* stylelint-disable-line */
    transition: clip-path var(--submenu-animation-speed) var(--ease-out-cubic); /* stylelint-disable-line */
  }

  [data-submenu-overlap-bottom-row] {
    .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
    .overflow-menu::part(overflow) {
      clip-path: rect(var(--top-row-height) 100% var(--full-open-header-height) 0); /* stylelint-disable-line */
    }
  }

  /* Show the submenus on hover */
  .menu-list__list-item:has([aria-expanded='true']) > .menu-list__submenu,
  /* Show the overflow menu when a menu item is hovered */
  .overflow-menu:has([slot="overflow"] [aria-expanded='true'])::part(overflow-list),
  /* Keep the submenus open when they are hovered */
  .menu-list__submenu:is(:hover),
  .overflow-menu::part(overflow):hover {
    --submenu-content-opacity: 1;

    visibility: visible;
  }

  .overflow-menu::part(overflow) {
    --menu-top-level-font-size: var(--font-size--xlarge);

    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .overflow-menu::part(overflow-list) {
    position: relative;
    display: grid;
    grid-template-columns: minmax(auto, 200px) 1fr;
    grid-template-areas: 'left right';
    grid-template-rows: max-content;
    grid-gap: 0;
    grid-column: 2;
  }

  .menu-list__list-item:is([slot='overflow']) {
    --menu-top-level-font-color: var(--color-foreground);
    --menu-top-level-font-color-rgb: var(--color-foreground-rgb);

    display: contents;
    white-space: normal;

    .menu-list__link {
      grid-area: left;
      grid-row: auto;
      height: min-content;
      font-size: var(--font-size--xl);
      transition: var(--submenu-content-animation);
    }

    .menu-list__submenu {
      visibility: hidden;
      grid-row: 1;
      grid-area: right;
      grid-row-end: span calc(var(--overflow-count) + 1);
      padding-inline-start: var(--menu-horizontal-gap);
    }

    .menu-list__submenu-inner {
      transform: none;
      grid-column: unset;
      padding-block: 0;
    }

    .menu-list__link[aria-expanded='true'] + .menu-list__submenu {
      visibility: visible;
    }
  }

  .header-menu {
    height: 100%;
  }

  .menu-list__submenu-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .menu-list__submenu-inner,
  .overflow-menu::part(overflow-list) {
    padding-block-start: var(--submenu-padding-block-start);
    padding-block-end: var(--submenu-padding-block-end);
    padding-inline: var(--section-padding-inline);
    opacity: var(--submenu-content-opacity);
    transition: var(--submenu-content-animation);
    transform: translateY(calc(var(--full-open-header-height) - var(--submenu-height)));

    /* Make overflow menu scrollable when content exceeds viewport */
    max-height: calc(80vh - var(--header-height));
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-40)) transparent;
  }

  .mega-menu__link {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);
    white-space: normal;
    text-decoration: none;
    display: inline-flex;
    padding: var(--padding-2xs) 0;

    &:hover {
      color: var(--menu-child-active-font-color);
    }
  }

  .mega-menu__link--parent {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);

    &:hover {
      color: var(--menu-parent-active-font-color);
    }
  }

  @media screen and (max-width: 989px) {
    .mega-menu__content-list-item--hidden-tablet {
      display: none;
    }
  }

  .mega-menu__link:has(.mega-menu__link-image) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__link-image {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    object-fit: cover;
    border-radius: var(--menu-image-border-radius);
  }

  /* Fix alignment for collection image mode links without images */

  /* Target only top-level links (direct children of column > div) in collection image mode */
  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image)) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image))::before {
    content: '';
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    background-color: var(--color-foreground-muted);
    opacity: 0.1;
    border-radius: var(--menu-image-border-radius);
  }

  .mega-menu__grid {
    display: grid;
    grid-template-columns: repeat(var(--menu-columns-tablet), minmax(0, 1fr));
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
    width: 100%;

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__column {
    grid-column: span 1;
  }

  .mega-menu__column--span-2 {
    grid-column: span 2;
  }

  .mega-menu__column--span-3 {
    grid-column: span 3;
  }

  .mega-menu__column--span-4 {
    grid-column: span 4;
  }

  .mega-menu__column--wide-collection-image {
    grid-column: span 1;

    @media screen and (min-width: 990px) {
      grid-column: span 2;
    }
  }

  .mega-menu__submenu .mega-menu__column--wide-collection-image {
    grid-column: span 1;
  }

  .mega-menu__content-list {
    display: grid;
    justify-content: end;
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
  }

  .mega-menu__content-list--products {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 1fr));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__content-list--collections {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 300px));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 300px));
    }
  }

  .mega-menu__list {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: span var(--menu-columns-tablet);
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-columns-desktop);
    }
  }

  .mega-menu__content {
    grid-column: span var(--menu-content-columns-tablet) / -1;

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-content-columns-desktop) / -1;
    }
  }

  .menu-list__list-item[slot='overflow'] .section {
    grid-template-columns: 1fr;
  }

  .menu-list__list-item[slot='overflow'] .section .mega-menu__grid {
    grid-column: 1;
  }

  .mega-menu__content-list li {
    white-space: normal;
  }

  /* mega more menu */
  .mega-menu__more-list {
    --menu-child-font-size: var(--font-size--xl);

    width: 200px;
  }

  .mega-menu__submenu {
    /* preserves the inherited grid layout when this submenu wrapper is used */
    display: contents;
  }

  /* Hide product cards in collapsed submenus from the IntersectionObserver that fires product view events */
  .menu-list__list-item:not(:has([aria-expanded='true'])) > .menu-list__submenu product-component {
    display: none;
  }

  /** mionas header menu panel **/

  /* THE DISCLOSURE CHEVRON, mirroring ../design-system's NavbarItem.
     Scoped with :has() so only parent links are affected - childless top-level links and the
     native "More" overflow trigger keep their plain inline title.

     NO BASE ROTATION, deliberately. assets/icon-caret.svg already points DOWN, which is
     NavbarItem's closed state, so only the open state needs a transform. The design system rotates
     a '›' glyph 90deg/-90deg to reach the same two positions; using the SVG instead is a theme
     choice - it is what the drawer rows and the native mega menu already render, and unlike a text
     glyph its shape does not change with the merchant's font setting.

     Rotating the inner svg, not the wrapper, and declaring no transition of our own: assets/base
     .css:1178 already gives `.icon-caret svg` the theme's transform transition, and its
     --forward/--backward modifiers rotate the svg at the same depth. Following that convention
     means this inherits the theme's animation speed and easing for free, and reduced-motion is
     handled wherever the theme handles it for every other caret.

     The chevron colour is the svg's own `stroke="currentColor"`, so it tracks the link's hover and
     active colours without this file restating either.

     NO LABEL-TO-CHEVRON GAP TOKEN IS SPENT, and none is wanted. This rule briefly carried
     NavbarItem's --navbar-item-base-gap, then --space-2xs when the design system removed that
     token; both read as too much space on screen, because the icon box is already wider than the
     glyph it draws. The reasoning is on the title rule below. So if a future design-system release
     ships a label-to-chevron gap token for the separated disclosure component, do not adopt it
     reflexively - check it against the rendered nav first. */
  /* TOP-LEVEL NAV TYPE, PINNED TO THE DESIGN SYSTEM.
     The bar was rendering at 18px/800 - the merchant's type_font_primary_size (1.125rem) and the
     `heading` font role, whose weight is 800 (archivo_n8). The design system's NavbarItem is 16px/
     500, and it gets there by composing Link: navbar-item.json carries only colours now, so
     NavbarItem.module.css overrides nothing but foreground and text-transform and lets Link supply
     the type. So Link's tokens are the correct source here, not a --navbar-item-* one.

     Both are already pinned in scripts/design-tokens-contract.mjs, and the 500 is the exact reason
     snippets/design-system-bridge.liquid emits an extra Archivo 500 face -- the theme's four font
     settings load 400/600/700/800 and no 500, so no Shopify font setting can express this weight.
     That is why the weight has to be pinned in CSS rather than dialled in the theme editor.

     FAMILY IS DELIBERATELY NOT TOUCHED. It stays on --menu-top-level-font-family so Shopify keeps
     hosting and preloading the face; only size and weight move here, which is the same split
     snippets/design-system-bridge.liquid makes for the six text roles.

     CONSEQUENCE: type_font_primary_size and type_font_primary_link no longer affect the desktop
     bar's size or weight (they still drive its family). That is the intended trade -- the nav
     tracks the design system instead of drifting with a merchant setting.

     Specificity (0,2,0) via the parent <li>, not a bare .menu-list__link (0,1,0). The base rule
     near the top of this stylesheet sets font-size inside a nested min-width:750px media query;
     media queries add no specificity, so a bare class here would tie it and win only on source
     order. Compounding removes the tie. */
  .menu-list__list-item > .menu-list__link {
    font-size: var(--link-size-md-font-size);
    font-weight: var(--link-base-font-weight);
  }

  /* CENTRE, AND NO GAP. Both settled by looking at the rendered nav, not by derivation - an
     earlier pass reasoned its way to `align-items: baseline` plus a 4px gap and both were wrong on
     screen. Recorded here so neither gets re-litigated from theory:

     align-items: center. Baseline alignment was tried because the maths for centring looked
     borderline (the nav line-height computes to ~1.67 via theme-styles-variables.liquid's
     calc(1.1 + 0.5 * min(16 / 14))), and because uppercase text has no descenders so its visual
     band runs from the baseline up. Centre is what actually reads correctly. The residual optical
     offset is handled where it belongs - on the chevron itself, as a correction for the ASSET's own
     geometry, which is documented on that rule.

     No gap. --space-2xs (4px) sat here and pushed the caret visibly far from the word. The spacing
     is already built into the icon: .svg-wrapper is a --icon-size-xs box (13.6px) but the caret
     path only occupies ~8px of its width, so the wrapper carries roughly 2.8px of empty space on
     each side before any gap is added. A gap property stacks on top of that. If the caret ever
     needs to sit closer or further from the label, change the box size or the asset - do not
     reintroduce a gap here. */
  .menu-list__link-title:has(.mionas-header-menu__chevron) {
    display: inline-flex;
    align-items: center;
  }

  /* SIZED DOWN, AND BOTH HALVES OF IT. assets/base.css gives `.svg-wrapper` AND
     `.svg-wrapper > svg` the same --icon-size-sm (1.25rem = 20px). That is taller than this
     label's own line box, so the chevron read as oversized AND knocked the text off centre: the
     title is a flex row, so a 20px child sets the row height and the text then centres against
     the chevron instead of the chevron centring against the text.

     The theme's own .svg-wrapper--small modifier is not sufficient - it resizes the wrapper only
     and leaves `> svg` at --icon-size-sm, so the glyph would overflow a smaller box. Hence both
     selectors here.

     Both are compounded with .svg-wrapper to reach (0,2,0)/(0,2,1) and beat base.css's (0,1,0)/
     (0,1,1) on specificity rather than on source order - this block's stylesheet output does win
     over base.css today, but a tie decided by load order is not something to leave load-bearing.

     (Do not write a Liquid tag name in braces anywhere in this stylesheet, not even inside a CSS
     comment: theme check's StaticStylesheetAndJavascriptTags rule parses the CSS block for Liquid
     and errors on it. The fork header above can say it because it sits inside a comment tag.)

     flex: none so the title's flex layout cannot stretch or shrink it.

     The translate corrects the ASSET, not the layout, and the number is measured rather than
     tuned: icon-caret.svg's path is `M11 5.5L7 9.5L3 5.5` in a 14-unit viewBox, so with the round
     caps its visible band runs y 4.75 -> 10.25 and is centred at y=7.5 - half a unit BELOW the
     box centre at y=7. The glyph therefore always draws 0.5/14 of the box height low, at every
     size. Expressing it as that ratio keeps the correction correct if the size token changes;
     a hardcoded px nudge would not. It goes on the wrapper because the rotation below owns
     `transform` on the svg. */
  .svg-wrapper.mionas-header-menu__chevron,
  .svg-wrapper.mionas-header-menu__chevron > svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    flex: none;
  }

  .svg-wrapper.mionas-header-menu__chevron {
    transform: translateY(calc(-0.5 / 14 * var(--icon-size-xs)));
  }

  .menu-list__link[aria-expanded='true'] .mionas-header-menu__chevron svg {
    transform: rotate(180deg);
  }

  /* THE PANEL PAINTS NOTHING, AND SO IT NEEDS NO SURFACE MACHINERY.
     There is deliberately no `.mionas-header-menu-panel` rule here at all any more. Everything
     that used to be on it existed to draw one edge-to-edge surface:

       - background / box-shadow / border-bottom -- removed. The dropdown already sits on the
         header's own surface, so painting a second one behind it was a doubled surface, not a
         design. --mionas-header-menu-panel-background/-shadow/-border are no longer emitted by
         snippets/mionas-header-menu-panel.liquid, and the panel_background / panel_shadow settings
         that fed them are gone from the schema rather than left as controls that do nothing.
       - width: 100vw + margin-inline: calc(50% - 50vw) -- removed. That breakout existed only so
         the background could reach the viewport edges. With no background there is nothing to
         stretch, and it took a known caveat with it (100vw counts the scrollbar, so the panel
         could overhang by a few px).
       - the three :has() ancestor overrides on .mega-menu__grid and .menu-list__submenu-inner --
         removed. They cancelled native padding and, critically, `overflow-x: hidden` + max-height
         on .menu-list__submenu-inner, which clipped the breakout. Nothing is breaking out now, so
         the native submenu keeps its own padding and its own scroll behaviour. That last part is a
         GAIN: those overrides had to drop max-height (you cannot mix overflow-x: visible with
         overflow-y: auto), which cost the native "scrollable when the submenu exceeds the
         viewport" behaviour. It is back.

     If a full-bleed painted panel is ever wanted again, restore it as one rule on this element
     plus those three overrides together -- they only ever worked as a set, and three separate
     attempts at partial versions are recorded in this file's history as having failed. */

  /* Centres and caps the content. No background, no shadow, no padding: the native
     .menu-list__submenu-inner supplies the panel's padding now that its overrides are gone, so
     declaring padding here too would double it.

     max-width stays a literal on purpose. The design system does not tokenise layout geometry -
     MegaMenu.module.css hard-codes the same max-width: 1240px, with a comment saying so - and
     inventing a token here would be the theme leading the design system rather than following. */
  .mionas-header-menu-panel__inner {
    max-width: var(--mionas-header-menu-panel-max-width, 1240px);
    margin-inline: auto;
  }

  /* One column below 750px (the same card as desktop, stacked vertically), then 3, then the
     configured count. Card internals are identical at every width - only the track count
     changes, which is what lets one snippet serve both the desktop panel and the drawer. */
  .mionas-header-menu-panel__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--mionas-header-menu-panel-gap, var(--mega-menu-base-gap));
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .mionas-header-menu-panel__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .mionas-header-menu-panel__grid {
      grid-template-columns: repeat(var(--mionas-header-menu-panel-columns, 6), minmax(0, 1fr));
    }
  }

  /* These four spent the raw spacing/radius primitives (--space-xs, --radius-lg) because when
     this card was built the design system had no MegaMenuItem to borrow from. It does now, so
     they spend MegaMenuItem's own tokens instead. Radius and padding are the same 12px/8px they
     resolved to before; the GAP is not - MegaMenuItem asks for space.sm (12px) between media and
     text where this card had space.xs (8px). That is the design system's call, not a rename.

     :active mirrors MegaMenuItem's own pressed state, which this card never had. */
  .mionas-header-menu-panel__card {
    display: flex;
    flex-direction: column;
    gap: var(--mega-menu-item-base-gap);
    padding: var(--mega-menu-item-base-padding);
    border-radius: var(--mega-menu-item-base-radius);
    text-decoration: none;
  }

  .mionas-header-menu-panel__card:active {
    opacity: var(--mega-menu-item-state-pressed-opacity);
  }

  /* HOVER IS DELIBERATELY NOT DRAWER-SCOPED. The desktop mega menu's cards change here
     too: the warm background is gone, replaced by a blue label and an image zoom.

     This used to spend --nav-link-state-hover-foreground, which the design system DELETED in
     b6bc96d when it replaced Nav/NavLink with Navbar + MegaMenu. That reference resolved to
     nothing after the token sync (the label silently kept its resting colour on hover), which
     is exactly the silent-fallback failure the contract cannot catch on its own. The
     replacement is not a guess at an equivalent: --mega-menu-item-state-hover-foreground is
     MegaMenuItem's own label-hover token, the same #0b078c, and this element is that label.

     Note the drawer is usually running on a touch device (see the doc block in
     snippets/mionas-header-menu-panel.liquid), where :hover never fires at all. This is
     polish for pointer and keyboard users - the caret is what signals a row is tappable. */
  .mionas-header-menu-panel__card:hover .mionas-header-menu-panel__label,
  .mionas-header-menu-panel__card:focus-visible .mionas-header-menu-panel__label {
    color: var(--mega-menu-item-state-hover-foreground);
  }

  .mionas-header-menu-panel__card:hover .mionas-header-menu-panel__image,
  .mionas-header-menu-panel__card:focus-visible .mionas-header-menu-panel__image {
    transform: scale(var(--mega-menu-item-state-hover-scale));
  }

  /* Colour always transitions; the zoom is motion, so it only runs when motion is welcome. */
  .mionas-header-menu-panel__label {
    transition: color 200ms ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mionas-header-menu-panel__image {
      transition: transform 200ms ease;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mionas-header-menu-panel__card:hover .mionas-header-menu-panel__image,
    .mionas-header-menu-panel__card:focus-visible .mionas-header-menu-panel__image {
      transform: none;
    }
  }

  /* Fixed media height is what keeps rows aligned when some cards have no tagline. The 110px
     was a literal here and is 110px in the design system too - now single-sourced from it.

     The radius is a real change: this borrowed --radius-lg (12px, the card's own radius) where
     MegaMenuItem splits the two deliberately - radius.lg for the card, radius.md (8px) for the
     media it crops. Adopting the split is the point of the sync. */
  .mionas-header-menu-panel__media {
    display: block;
    height: var(--mega-menu-item-base-media-height);
    border-radius: var(--mega-menu-item-base-media-radius);
    overflow: hidden;
  }

  .mionas-header-menu-panel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Size, line-height and letter-spacing still come from the caption type role - MegaMenuItem
     renders its label through <Text> and only overrides weight and colour on top, so those two
     are the ones that move here. Both were borrowed from Card (--card-title-foreground,
     --card-description-foreground) for want of a mega-menu equivalent; MegaMenuItem now has its
     own, at the identical #101413 / #687076.

     The WEIGHT is a genuine change: the caption role is 500, MegaMenuItem's label asks for 700.
     Checked, not assumed - 700 is one of the four Archivo weights the browser already has
     (400/600/700/800, per the inventory in snippets/design-system-bridge.liquid: 700 arrives as
     the font_modify'd bold of the 600 subheading setting). So this renders on a real face, not a
     synthesised faux-bold, and needs no new @font-face the way the design system's 500 tokens did. */
  .mionas-header-menu-panel__label {
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    font-weight: var(--mega-menu-item-label-font-weight);
    letter-spacing: var(--text-role-label-lg-letter-spacing);
    color: var(--mega-menu-item-label-foreground);
  }

  .mionas-header-menu-panel__tagline {
    font-size: var(--text-role-label-md-font-size);
    line-height: var(--text-role-label-md-line-height);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
    color: var(--mega-menu-item-description-foreground);
  }

  /* The card's label and tagline live in this wrapper for the drawer's row grid (thumb | text |
     caret): without it they are separate grid items and cannot share a column.

     NO GAP ON DESKTOP. It carried `gap: var(--space-xs)` (8px), inherited from the card's own gap
     before the two were split. That is not what the design system draws: MegaMenuItem's .text
     declares no gap at all and Text sets `margin: 0`, so the label and description sit flush and
     the pair reads as one block. The 8px was surviving inertia, and the mega menu design sync
     should have removed it - it was kept on the argument that "there is no token to adopt here",
     which confused "no token" with "no opinion". Zero IS the design system's value.

     The drawer variant re-adds a small --space-3xs below; that one is a real decision, because the
     drawer's rows are taller and touch-targeted rather than a dense desktop grid. */
  .mionas-header-menu-panel__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ── Drawer variant ──────────────────────────────────────────────────────────────────

     MOST OF THIS USED TO BE "UNDO THE DESKTOP CHROME" AND NO LONGER NEEDS TO BE. The desktop
     panel once broke out to 100vw and painted a background, a shadow and a hairline, all of which
     had to be neutralised here or the drawer showed a white card spilling past its own edges.
     None of that is declared any more (see the note where the panel rule used to be), so the
     neutralisations went with it. What remains is the one thing that was never about undoing:
     the width. */
  .mionas-header-menu-panel.mionas-header-menu-panel--drawer {
    /* 100%, NOT auto, and this rule must stay even though the desktop breakout is gone - it is
       now the ONLY thing giving the panel a width in the drawer. The flat branch's <li> is
       `display: flex; flex-direction: column; align-items: flex-start`
       (snippets/mionas-header-drawer.liquid:850-855), so the cross axis is horizontal and
       flex-start cancels the default stretch - a child with width:auto is sized fit-content, and
       the card group renders narrower than the top-level rows with its carets out of line. The
       heading <span> escapes this only because .menu-drawer__menu-item is in the width:100% list
       at :888-892; this div is not. */
    width: 100%;
  }

  /* Still needed: __inner caps the desktop content at 1240px and centres it, and neither is
     wanted inside a ~400px drawer. Its padding overrides are gone because __inner no longer has
     any padding to override. */
  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__inner {
    max-width: none;
    margin-inline: 0;
  }

  /* The panel's grid rules above are width-based (3 columns from 750px, then
     --mionas-header-menu-panel-columns from 990px). The drawer is NOT width-gated - see the doc
     block in snippets/mionas-header-menu-panel.liquid - so on a touch device those rules
     would fire inside the drawer and lay the rows three- or six-across at tablet width.
     Pinning one column here fixes that: at specificity (0,2,0) against the media queries'
     (0,1,0) this wins regardless of source order. Do not replace it with a max-width media
     query; width is not what selects the drawer. */
  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__grid {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2xs);
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__card {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;

    /* Same token as the desktop card now spends, and the same value it resolved to as
       --space-sm. MegaMenuItem uses one gap for both its column and its row layout, so keeping
       these two in one name is what makes the drawer row track the design system too. */
    gap: var(--mega-menu-item-base-gap);

    /* Zeroed so the thumbnail's left edge lines up with the section heading and the
       childless top-level rows, which are .menu-drawer__menu-item and carry no inline
       padding. The base card's 8px is kept on the block axis for touch-target height, and
       kept in full on desktop. Nothing paints behind the card any more - the hover
       background was removed - so inline padding here buys nothing but misalignment. */
    padding-inline: 0;
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__text {
    gap: var(--space-3xs);
  }

  /* A fixed square, not the desktop card's full-width 110px band. The warm background
     shows through for links that produce no image at all - page and blog links, and
     collections with neither a featured image nor any product - so rows stay aligned
     instead of collapsing.

     The 56px SQUARE STAYS 56px, and is deliberately not swapped for MegaMenuItem's
     --mega-menu-item-base-media-size (40px). That token sizes the design system's own
     max-width: 900px row, which is a VIEWPORT breakpoint; this drawer is selected by touch or
     nav overflow at any width, so the two are not the same state (see the doc block in
     snippets/mionas-header-menu-panel.liquid). 56px is also load-bearing beyond the CSS - the
     snippet requests `sizes: 56px` for these thumbnails, and it is a 44px-plus touch target.
     Adopting 40px would need both changed together and is a design decision, not a sync.

     The background fill IS swapped: it was --color-warm-100 (#f7f2e3) picked by eye, and
     MegaMenuItem names warm-200 (#ece8e2) for exactly this "link produced no image" fill. */
  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__media {
    width: 56px;
    height: 56px;
    border-radius: var(--mega-menu-item-base-media-radius);
    background: var(--mega-menu-item-base-media-background);
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__label {
    font-size: var(--text-role-title-sm-font-size);
    line-height: var(--text-role-title-sm-line-height);
    font-weight: var(--text-role-title-sm-font-weight);
    letter-spacing: var(--text-role-title-sm-letter-spacing);
  }

  .mionas-header-menu-panel--drawer .mionas-header-menu-panel__caret {
    display: flex;
    align-items: center;
    color: var(--color-neutral-400);
  }

  /* The parent-with-children row, rendered as a <span> by snippets/mionas-header-drawer.liquid.
     It keeps .menu-drawer__menu-item and --mainlist for what they still supply once the LINK
     affordances are undone below: --mainlist's --menu-top-level-font-* family
     (snippets/mionas-header-drawer.liquid:898-905), and .menu-drawer__menu-item's
     display:flex/position:relative/align-items (:965-972) plus width:100% (:888-892) - the
     latter is why this heading row never hit the fit-content sizing that the sibling panel
     <div> did (see the fix above). The rules being overridden live in the drawer snippet's
     own stylesheet, so these overrides have to win on specificity - source order between two
     separate stylesheet tags is not guaranteed. */
  /* Four classes deliberately. `.menu-drawer__list-item--divider .menu-drawer__menu-item:not(
     .menu-drawer__menu-item--child)` in snippets/mionas-header-drawer.liquid is (0,3,0) and
     re-imposes a ~48px min-height on this inert heading whenever the block's drawer_dividers
     setting is on. A (0,3,0) selector here would only tie with it and fall back to source
     order across two separate stylesheet tags, which is not something to rely on.
     (0,4,0) wins outright, dividers on or off. */
  /* A Stamp mirror: weight, tracking and transform from Stamp's component tokens, size from the
     label-lg band Stamp renders Text at. No --stamp-base-font-family on purpose -- this row
     inherits --mainlist's --menu-top-level-font-* family (see just above), and switching it to
     Oswald would be a new design decision rather than part of the design-system sync. */
  .menu-drawer__menu .menu-drawer__menu-item.menu-drawer__menu-item--mainlist.menu-drawer__menu-item--mionas-heading {
    min-height: 0;
    padding-block: var(--space-sm) var(--space-xs);
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    font-weight: var(--stamp-base-font-weight);
    letter-spacing: var(--stamp-base-letter-spacing);
    text-transform: var(--stamp-base-text-transform);
    color: var(--color-vermell-segell);
    justify-content: flex-start;
    cursor: default;
  }

  /* Currently redundant: the base heading rule above is (0,4,0) and not state-limited, so it
     already beats --mainlist's nested &:hover at (0,2,0) without this. Kept as a forward guard
     - if a future edit changes --mainlist's hover colour, or lowers this file's heading rule
     below (0,4,0), this is what stops a hover colour leaking onto inert text. Do not delete it
     on the grounds that it "does nothing today"; that is the point. */
  .menu-drawer__menu .menu-drawer__menu-item--mionas-heading:hover {
    color: var(--color-vermell-segell);
  }

  /* The design shows the drawer's top-level rows in sentence case while the section heading
     above stays uppercase. Overriding here rather than flipping the block's
     type_case_primary_link setting keeps the DESKTOP nav uppercase, which is intended.
     :not() excludes the heading, which sets its own uppercase a rule above. */
  .menu-drawer__menu .menu-drawer__menu-item--mainlist:not(.menu-drawer__menu-item--mionas-heading) {
    text-transform: none;
  }

  /* One hairline after each card group, separating it from the plain rows beneath.
     Independent of the block's drawer_dividers setting, which rules EVERY item.
     :not(:last-child) so a group that happens to be the menu's final item does not draw a
     rule with nothing under it. */
  .menu-drawer__list-item--flat:has(.mionas-header-menu-panel):not(:last-child) {
    border-block-end: 1px solid var(--color-warm-200);
    padding-block-end: var(--space-md);
    margin-block-end: var(--space-2xs);
  }

{% endstylesheet %}

