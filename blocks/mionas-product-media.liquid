{%- comment -%}
  Mirrors ../design-system/src/react/ProductCard/ProductCardMedia.tsx: the product's featured image,
  cropped to a fixed height and zoomed slightly on hover.

  This block exists because Horizon has no public product-image block. Its own
  blocks/_product-card-gallery.liquid is private to the native `_product-card`, so a composed Mionas
  card had nothing to put in the media slot. blocks/image.liquid takes a hand-picked image setting and
  never binds to the surrounding product.

  Reads closest.product, so it renders only inside a product context -- the card slot of
  sections/mionas-collection.liquid, a native product card, or a product page. Anywhere else it
  renders nothing rather than an empty box.

  Height comes from --product-card-base-media-height rather than a merchant setting on purpose: it is
  what makes every card in a row line up regardless of its image's proportions, and it is a design
  token, so exposing it as a px range in the theme editor would let it drift from the design system.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
-%}

{%- if product != blank and product.featured_image != blank -%}
  <div class="mionas-product-media" {{ block.shopify_attributes }}>
    {{
      product.featured_image
      | image_url: width: 640
      | image_tag:
        class: 'mionas-product-media__img',
        alt: product.featured_image.alt,
        loading: block.settings.image_loading,
        widths: '160, 220, 320, 440, 640',
        sizes: '(min-width: 750px) 25vw, 50vw'
    }}
  </div>
{%- endif -%}

{% stylesheet %}
  .mionas-product-media {
    /* ProductCard.module.css hardcodes both of these and the design system has no token behind
       either yet, so each is declared once here as a block-local custom property -- one line to
       swap the day a token appears, instead of a literal buried in a transform and a transition. */
    --product-card-media-hover-scale: 1.05;
    --product-card-media-hover-duration: 0.5s;

    height: var(--product-card-base-media-height);
    overflow: hidden;
  }

  .mionas-product-media__img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    transition: transform var(--product-card-media-hover-duration) ease;
  }

  /* Hovering anywhere on the card zooms the media, matching ProductCard.tsx, where the hover is on
     the card root rather than the image. Falls back to the media's own hover when this block is used
     outside a Mionas product card. */
  .mionas-product-card:hover .mionas-product-media__img,
  .mionas-product-media:hover .mionas-product-media__img {
    transform: scale(var(--product-card-media-hover-scale));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Product media",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "image_loading",
      "label": "Image loading",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "lazy",
      "info": "Use Eager only for cards above the fold; it disables lazy loading for every card in the list."
    }
  ],
  "presets": [
    {
      "name": "Mionas: Product media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
