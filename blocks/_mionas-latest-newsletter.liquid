{%- doc -%}
  Renders its child blocks for the newsletter blog's newest email, which they read as closest.article.

  @param {blog} [closest.blog] - The blog chosen on the section.
  @param {blog} [blog] - The global blog object, used when the section has no blog chosen.
{%- enddoc -%}
{%- comment -%}
  A parent's paginate does not reach a block, so this block pages the articles itself. By 250,
  not 1, so ?page=2 shows nothing instead of the second email as "latest".
{%- endcomment -%}
{%- assign newsletter_blog = closest.blog | default: blog -%}
{%- paginate newsletter_blog.articles by 250 -%}
  {%- if newsletter_blog.articles.size > 0 -%}
    {%- assign latest = newsletter_blog.articles.first -%}
    <div class="mionas-latest-newsletter" {{ block.shopify_attributes }}>
      {%- content_for 'blocks', closest.article: latest -%}
    </div>
  {%- endif -%}
{%- endpaginate -%}

{% stylesheet %}
  /* A connected title can't be retyped in capitals, and the design sets the latest title in uppercase. */
  .mionas-latest-newsletter .text-role--headline-lg {
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
{% endstylesheet %}

