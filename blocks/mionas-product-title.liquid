{%- comment -%}
  Mirrors the title line of ../design-system/src/react/ProductCard/ProductCard.tsx: the product name
  at the "body" text role, in --card-title-* weight and colour.

  Reads closest.product, so it renders only inside a product context -- the card slot of
  sections/mionas-collection.liquid, a native product card, or a product page.

  WHY IT EMITS NO LINK, unlike Horizon's blocks/product-title.liquid:
  inside blocks/_mionas-product-card.liquid the whole card is already an overlay link to the product,
  so a second anchor around the same text would give a screen reader two links to the same place and
  a keyboard user an extra stop. When this block is used outside that card the text is plain, which is
  the correct default for a heading. Horizon's own product-title is still available if a real link is
  wanted.

  The heading semantics (role/aria-level rather than a real <h*>) match snippets/text.liquid's
  product-title branch: a card title is a heading to assistive tech but its level depends on the page
  it lands in, so it is not hardcoded to <h3>.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
-%}

{%- if product != blank -%}
  {%- render 'mionas-text',
    content: product.title,
    role: block.settings.role,
    variant: block.settings.variant,
    tag: 'p',
    class: 'mionas-product-title',
    heading_level: block.settings.heading_level,
    shopify_attributes: block.shopify_attributes
  -%}
{%- endif -%}

{% stylesheet %}
  /* Size, line-height, letter-spacing and family now come from whichever .text-role--<role> the
     merchant picks, via snippets/mionas-text.liquid. Two things are left here.

     The edge inset, because ProductCard carries no padding of its own -- each subcomponent sets it,
     the convention CardTitle and ProductCardPrice already follow in ProductCard.module.css.

     And the weight, which stays --card-title-font-weight rather than the role's. That is not an
     oversight: the design system gives CardTitle a weight token of its own precisely because the card
     title is 600 whatever size it is set at, so the token outranks the role here.

     COLOUR IS DELIBERATELY NOT OVERRIDDEN. It used to be --card-title-foreground, but that resolves
     to the same #101413 as --text-color-default, which .text-role--default already applies. Keeping
     the override would have made the new Color setting do nothing, so it is gone: identical
     rendering at the default, and the setting now works.

     THE SELECTOR IS TWO CLASSES DEEP ON PURPOSE. Every .text-role--<role> also declares font-weight,
     and those are single-class selectors in the same compiled stylesheet as this rule, so matching
     their specificity would leave the winner to bundle order. .text-role.mionas-product-title is
     (0,2,0) and settles it. Do not flatten this selector. */
  .text-role.mionas-product-title {
    padding-inline: var(--product-card-base-padding-inline);
    font-weight: var(--card-title-font-weight);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Product title",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "role",
      "label": "Role",
      "options": [
        { "value": "hero", "label": "Hero" },
        { "value": "title", "label": "Title" },
        { "value": "subtitle", "label": "Subtitle" },
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "caption", "label": "Caption" },
        { "value": "lead", "label": "Lead" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" },
        { "value": "stamp", "label": "Stamp" }
      ],
      "default": "body",
      "info": "The same text roles as Mionas: Text. Weight and colour stay the card title's."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "options": [
        { "value": "2", "label": "H2" },
        { "value": "3", "label": "H3" },
        { "value": "4", "label": "H4" }
      ],
      "default": "3",
      "info": "Announced to screen readers. Pick the level that sits under the section's own heading."
    }
  ],
  "presets": [
    {
      "name": "Mionas: Product title",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
