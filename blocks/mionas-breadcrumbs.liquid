{%- doc -%}
  Renders a breadcrumb trail nested inside a Section, sharing that section's container width and
  spacing rather than spanning full-width.
{%- enddoc -%}

{%- comment -%}
  The breadcrumb trail as a theme block, so it can nest inside a section (usually Mionas: Page
  Heading) and share that container's width/background/spacing. snippets/mionas-breadcrumbs.liquid
  owns the crumb logic.

  Public (no leading underscore) on purpose: Horizon sections whitelist child blocks as "@theme",
  which resolves to exactly the public blocks in blocks/ -- the filename is the whole integration.

  Padding is the only layout setting here; width/background/alignment are deliberately left to the
  parent section, whose alignment places this block.
{%- endcomment -%}
{% liquid
  assign home_label = block.settings.home_label
  if home_label == blank
    assign home_label = 'content.breadcrumbs_home' | t
  endif

  assign landmark_label = block.settings.label
  if landmark_label == blank
    assign landmark_label = 'accessibility.breadcrumbs' | t
  endif
%}

<div
  class="mionas-breadcrumbs-block spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- render 'mionas-breadcrumbs',
    home_label: home_label,
    landmark_label: landmark_label,
    menu: block.settings.menu
  -%}
</div>

{% schema %}
{
  "name": "Mionas: Breadcrumbs",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "The trail follows this menu's hierarchy. Leave empty to use the header menu (Navigation Menu). Pages the menu doesn't contain fall back to their collection or blog."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "info": "Leave empty to use the theme's own wording, which stays translated per language."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Accessible name",
      "info": "Announced by screen readers to describe the trail. Not shown visually. Leave empty to use the theme's own wording, which stays translated per language."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Breadcrumbs",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
