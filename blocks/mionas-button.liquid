{%- comment -%}
  Mirrors ../design-system/src/react/Button/Button.tsx: a link styled as a button, in one of seven
  variants (primary, secondary, outline, ghost, danger, inverse-primary, inverse-ghost) and three
  sizes (sm, md, lg).

  Horizon's native blocks/button.liquid (t:names.button) only exposes four style_class options
  (button / button-secondary / button-unstyled / button-custom) via snippets/button.liquid -- there
  is no schema path to outline, ghost, danger, or either inverse variant, so this forks a new block
  per mionas-design-component's rule rather than trying to stretch the native one. blocks/button.liquid and
  snippets/button.liquid are untouched by this -- the native button still gets its current look from
  snippets/design-system-bridge.liquid's global `.button` override, unrelated to this block.

  Button.tsx is a discriminated union (`as="a"` has no `disabled`; `as="button"` does) -- this block
  only covers the `as="a"` case, the same way it's always used as a block inside static theme
  content, so there's no `:disabled` state to reproduce. `aria-disabled` stands in for it when no
  link is set, same convention as snippets/button.liquid.

  Every colour, radius, size metric and the family come from --button-* tokens
  (assets/design-tokens.css), exactly as Button.module.css spends them. --button-base-font-family
  resolves through --font-family-archivo, which snippets/design-system-bridge.liquid repoints at
  the theme's loaded body font -- so the family is the design system's decision, delivered by a
  face Shopify actually hosts.

  THIS BLOCK OWNS NEITHER THE CLASSES NOR THE CSS, and is no longer the only way to spend either.
  The class list comes from snippets/mionas-button-class.liquid and the rules from
  snippets/mionas-button-styles.liquid, which snippets/design-system-bridge.liquid renders on every
  page. Both were extracted from here because blocks/mionas-add-to-cart.liquid puts these classes on
  a <button> it has to build from Horizon's own snippet: it cannot render this block (an <a> driven
  by a `link` setting cannot submit a form), so it duplicated the class string, and the CSS -- a
  {% raw %}{% stylesheet %}{% endraw %} tag here -- was dropped by Shopify's block subsetting on every page without a
  Mionas: Button on it. See mionas-button-styles.liquid's header for what that broke.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
%}
{%- capture button_classes -%}
  {%- render 'mionas-button-class',
    variant: block_settings.variant,
    size: block_settings.size,
    full_width: block_settings.full_width
  -%}
{%- endcapture -%}

{%- comment -%}
  The if/else tags below deliberately carry no whitespace-stripping hyphens -- the same shape as
  snippets/button.liquid. A stripping hyphen on the opening tag eats the newline between the anchor
  and its first attribute, emitting arole="link" as a single glued token: an unknown element rather
  than an anchor, with no link semantics and no styling. Whitespace inside a tag is harmless;
  removing it is not.
{%- endcomment -%}
<a
  {% if block_settings.link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ block_settings.link }}"
  {% endif %}
  class="{{ button_classes }}"
  {% if block_settings.open_in_new_tab %}
    target="_blank"
    rel="noopener noreferrer"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {{- block_settings.label -}}
</a>

{% schema %}
{
  "name": "Mionas: Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" },
        { "value": "danger", "label": "Danger" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-ghost", "label": "Inverse ghost" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Mionas: Button",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
