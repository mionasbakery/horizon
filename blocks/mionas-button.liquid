{%- doc -%}
  Renders a link styled as a button, in one of seven variants, three sizes, and an optional
  leading/trailing icon.
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Button/Button.tsx. Horizon's native blocks/button.liquid only
  exposes four style_class options with no schema path to outline/ghost/danger/inverse variants, so
  this forks a new block per mionas-design-component's rule instead of stretching the native one.

  Covers only the `as="a"` case of Button.tsx's discriminated union, since it's always used as a
  static block with no `:disabled` state; `aria-disabled` stands in for that when no link is set.

  The class list and CSS live in snippets/mionas-button-class.liquid / mionas-button-styles.liquid
  rather than here, because blocks/mionas-add-to-cart.liquid needs the same classes on a `<button>`
  it builds itself (this block's `<a>` can't submit a form) -- keeping one shared implementation
  also avoids Shopify's block-subsetting dropping this block's own `{% raw %}{% stylesheet %}{% endraw %}` tag on pages
  with no Mionas: Button on them.

  `icon`/`icon_position` mirror Button.tsx's `icon`/`iconPosition` props, but the `icon` setting's
  value vocabulary (whatsapp, instagram, tiktok...) is this theme's own -- see snippets/icon.liquid
  -- since Button.tsx just takes an opaque ReactNode and has no icon registry of its own.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
%}
{%- capture button_classes -%}
  {%- render 'mionas-button-class',
    variant: block_settings.variant,
    size: block_settings.size,
    full_width: block_settings.full_width
  -%}
{%- endcapture -%}
{%- capture button_icon -%}
  {%- if block_settings.icon != 'none' -%}
    <svg class="mionas-button__icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      {%- render 'icon', icon: block_settings.icon -%}
    </svg>
  {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  The if/else tags below deliberately carry no whitespace-stripping hyphens -- the same shape as
  snippets/button.liquid. A stripping hyphen on the opening tag eats the newline between the anchor
  and its first attribute, emitting arole="link" as a single glued token: an unknown element rather
  than an anchor, with no link semantics and no styling. Whitespace inside a tag is harmless;
  removing it is not.
{%- endcomment -%}
<a
  {% if block_settings.link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ block_settings.link }}"
  {% endif %}
  class="{{ button_classes }}"
  {% if block_settings.open_in_new_tab %}
    target="_blank"
    rel="noopener noreferrer"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block_settings.icon_position == 'trailing' -%}
    {{ block_settings.label }}{{ button_icon }}
  {%- else -%}
    {{ button_icon }}{{ block_settings.label }}
  {%- endif -%}
</a>

{% schema %}
{
  "name": "Mionas: Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Button"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" },
        { "value": "danger", "label": "Danger" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-ghost", "label": "Inverse ghost" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "whatsapp", "label": "WhatsApp" },
        { "value": "instagram", "label": "Instagram" },
        { "value": "tiktok", "label": "TikTok" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "leading", "label": "Leading" },
        { "value": "trailing", "label": "Trailing" }
      ],
      "default": "leading"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Button",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
