{%- doc -%}
  Renders a Google Maps iframe embed for a configured address.
{%- enddoc -%}

{%- comment -%}
  A Google Maps embed for the Contacto page's location panel. Uses
  https://www.google.com/maps?q=<address>&output=embed, which needs no API key -- the trade-off is
  no styling control over the map itself, only its frame. Chosen over a custom-liquid block so the
  merchant edits an address field rather than raw iframe HTML.

  This is a third-party iframe and sets Google cookies on load.

  Border and radius come from --card-base-* so the map and the info card beneath it read as one
  stack.

  Height follows the same fit/fill/custom convention as group.liquid and mionas-card.liquid so it
  reads consistently in the editor. "Fill" needs flex-grow, not just height: 100% -- Horizon renders
  block content as a direct flex item of the parent group's content div, and a column-direction flex
  item won't grow along the main axis from a percentage height alone.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings

  # url_encode applies to the address alone, never the whole URL -- encoding the URL would escape
  # its own ':' and '/'. Without it, an address containing a space or an '&' produces a broken URL
  # and a blank map.
  assign address_param = block_settings.address | url_encode
  assign map_src = 'https://www.google.com/maps?q=' | append: address_param | append: '&amp;z=' | append: block_settings.zoom | append: '&amp;output=embed'
%}

<div
  class="mionas-map mionas-map--height-{{ block_settings.height }}"
  {% if block_settings.height == 'custom' %}
    style="--mionas-map-height: {{ block_settings.custom_height }}px;"
  {% elsif block_settings.height == 'fill' %}
    style="--mionas-map-min-height: {{ block_settings.min_height }}px;"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block_settings.address == blank -%}
    {%- comment -%} No address yet: render the frame so the editor shows the block's footprint. {%- endcomment -%}
    <div class="mionas-map__empty">{{ block_settings.title | escape }}</div>
  {%- else -%}
    <iframe
      class="mionas-map__frame"
      src="{{ map_src }}"
      title="{{ block_settings.title | escape }}"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
    ></iframe>
  {%- endif -%}
</div>

{% stylesheet %}
  .mionas-map {
    width: 100%;
    border: var(--card-base-border-width) solid var(--card-base-border-color);
    border-radius: var(--card-base-radius);
    overflow: hidden;
  }

  /* Fit: a sensible default height, no merchant input needed. */
  .mionas-map--height-fit {
    height: 240px;
  }

  /* Custom: height is a block setting, passed in as a custom property so the schema stays the
     single source of it. */
  .mionas-map--height-custom {
    height: var(--mionas-map-height);
  }

  /* Fill: grow to the remaining space in the parent flex column (e.g. matching a sibling contact
     form's height). min-height overrides the flex item's default auto floor (which would size to
     the iframe's intrinsic height and could overflow) and keeps the map from collapsing to nothing
     when the column itself is short, e.g. once columns stack on mobile. Block setting, passed in
     as a custom property so the schema stays the single source of it; the fallback matches the
     schema default. */
  .mionas-map--height-fill {
    flex: 1 1 auto;
    min-height: var(--mionas-map-min-height, 240px);
    height: 100%;
  }

  .mionas-map__frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mionas-map__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--space-md);
    /* Secondary text, so this spends Card's description token -- not a --form-label-* one, which
       would be borrowed from an unrelated component. */
    color: var(--card-description-foreground);
    font-family: var(--font-family-archivo);
    font-size: var(--font-size-13);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Map",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "Carrer Major, XX, 08870 Sitges, Barcelona",
      "info": "Searched on Google Maps. Replace the placeholder with the real street address."
    },
    {
      "type": "range",
      "id": "zoom",
      "label": "Zoom",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit",
      "info": "Fill grows the map to match a sibling's height, e.g. the contact form column."
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:settings.custom_height",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 240,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 240,
      "info": "Floor while Fill is stretching, e.g. once columns stack on mobile.",
      "visible_if": "{{ block.settings.height == 'fill' }}"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Accessible name",
      "default": "Mapa de la ubicación de Mionas Bakery",
      "info": "Announced by screen readers to describe the map. Not shown visually."
    }
  ],
  "presets": [
    {
      "name": "Mionas: Map",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
