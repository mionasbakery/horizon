{%- doc -%}
  Renders the cart's progress towards free shipping as a bar ending at the threshold. Renders nothing
  for an empty cart.

  @param {object} section - Reads free_shipping_threshold from sections/mionas-cart.liquid's settings.
{%- enddoc -%}

{%- comment -%}
  The threshold lives on the cart section because Liquid can't read shipping rates and three blocks
  need it. assets/mionas-product-upsells.js reads it from data-free-shipping-threshold.
{%- endcomment -%}

{%- if cart.item_count > 0 -%}
  {%- liquid
    assign threshold = section.settings.free_shipping_threshold | default: 30
    assign threshold_cents = threshold | times: 100
    assign total = cart.total_price
    assign progress = total | times: 1.0 | divided_by: threshold_cents
    assign complete = false
    if total >= threshold_cents
      assign complete = true
    endif
    assign threshold_text = threshold_cents | money_without_trailing_zeros
    assign label = 'mionas.free_shipping.progress' | t
    assign now = total | divided_by: 100.0 | round
  -%}
  <div
    class="mionas-free-shipping-bar"
    data-free-shipping-threshold="{{ threshold_cents }}"
    {{ block.shopify_attributes }}
  >
    {% render 'mionas-progress-bar',
      progress: progress,
      label: label,
      max: threshold,
      now: now,
      end_label: threshold_text,
      complete: complete
    %}
  </div>
{%- endif -%}

{% stylesheet %}
  /* A card lays its children out at their own width, which for a bar is none. */
  .mionas-free-shipping-bar {
    width: 100%;
    margin-block-start: var(--space-xs);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Free Shipping Bar",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "The threshold is the Mionas: Cart section's \"Free shipping from\" setting."
    }
  ],
  "presets": [{ "name": "Mionas: Free Shipping Bar" }]
}
{% endschema %}
