{%- doc -%}
  Footer-utilities block: renders the store's legal policies as inline text links.
{%- enddoc -%}
{% render 'mionas-policy-links', settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Mionas: Policy Links",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows one link per policy set under Settings > Policies. Hidden automatically if no policies are set."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-primary-muted", "label": "Inverse primary (muted)" },
        { "value": "accent", "label": "Accent" },
        { "value": "accent-inverse", "label": "Accent (inverse)" },
        { "value": "tint", "label": "Tint" },
        { "value": "inherit", "label": "Inherited" }
      ],
      "default": "inverse-primary-muted",
      "info": "Inverse primary (muted) matches the footer text."
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "inherit", "label": "Inherited" },
        { "value": "display", "label": "Display" },
        { "value": "headline", "label": "Headline" },
        { "value": "title", "label": "Title" },
        { "value": "body", "label": "Body" },
        { "value": "label", "label": "Label" }
      ],
      "default": "body",
      "info": "Inherited takes its size from the surrounding text and ignores Size."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "lg", "label": "Large" },
        { "value": "md", "label": "Medium" },
        { "value": "sm", "label": "Small" }
      ],
      "default": "sm"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Policy Links",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
