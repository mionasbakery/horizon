{%- doc -%}
  Renders a vertical list container that draws dividers between child blocks.
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/List/List.tsx's divider-between-children behaviour. Shopify's
  `{% content_for 'blocks' %}` renders children in order but gives the parent no way to inject markup
  between them, so each child draws its own top border via `:not(:first-child)` in CSS instead. The
  `separator` setting reaches those children through a `data-separator` attribute here, since child
  blocks don't inherit parent settings automatically.
{%- endcomment -%}
<div class="mionas-list" data-separator="{{ block.settings.separator }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .mionas-list {
    display: flex;
    flex-direction: column;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: List",
  "tag": null,
  "blocks": [
    { "type": "mionas-list-item" },
    { "type": "@theme" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "separator",
      "label": "Show dividers between items",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Mionas: List",
      "category": "t:categories.basic",
      "blocks": [
        { "type": "mionas-list-item" },
        { "type": "mionas-list-item" }
      ]
    }
  ]
}
{% endschema %}
