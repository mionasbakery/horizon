{%- doc -%}
  Renders the icon button that removes a cart line inside blocks/_mionas-cart-item.liquid. The on:click
  path is assets/component-cart-items.js's onLineItemRemove, which counts lines from 1.

  @param {object} line - The cart line item.
{%- enddoc -%}

{%- liquid
  assign can_remove = line.instructions.can_remove | default: true, allow_false: true
  assign label = 'accessibility.remove_item' | t: title: line.title | escape
  assign icon = 'icon-delete.svg' | inline_asset_content
-%}
{%- capture attributes -%}
  type="button" on:click="/onLineItemRemove/{{ line.index | plus: 1 }}"{% unless can_remove %} hidden{% endunless %}
{%- endcapture -%}

{% render 'mionas-icon-button',
  tag: 'button',
  variant: 'ghost',
  size: 'sm',
  svg: icon,
  aria_label: label,
  attributes: attributes,
  class: 'mionas-cart-item-remove',
  shopify_attributes: block.shopify_attributes
%}

{% stylesheet %}
  .mionas-icon-button.mionas-cart-item-remove[hidden] {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Cart Item Remove",
  "tag": null,
  "settings": []
}
{% endschema %}
