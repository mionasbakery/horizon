{%- doc -%}
  Renders the upsell cards inside the cart page's free-shipping card while the cart is under
  the threshold. The upsell cards come from sections/mionas-upsell-list.liquid through
  assets/mionas-product-upsells.js; this block holds the cart data the script ranks by, and takes
  the threshold from blocks/mionas-free-shipping-bar.liquid on the same page. Renders nothing for an
  empty cart.
{%- enddoc -%}

{%- liquid
  assign latest_product = cart.items.first.product
  assign source_ids = cart.items | map: 'product_id' | uniq | slice: 0, 3 | join: ','
  assign collection_handles = block.settings.collections | map: 'handle' | join: ','
  assign heading = 'mionas.product_upsells.heading_under' | t
  assign button_tooltip = block.settings.button_tooltip
  if button_tooltip == blank
    assign button_tooltip = 'actions.add_to_cart' | t
  endif
-%}

{%- if cart.item_count > 0 -%}
  <script src="{{ 'mionas-product-upsells.js' | asset_url }}" type="module"></script>

  <div
    class="mionas-product-upsells"
    data-product-ids="{{ source_ids }}"
    data-total="{{ cart.total_price }}"
    {{ block.shopify_attributes }}
  >
    {%- comment -%}
      The recommendations response carries no stylesheet, so one inert card is rendered here to put
      the card and add-to-cart files in the page's render tree, which is what ships their CSS.
    {%- endcomment -%}
    <template>
      {%- capture button -%}
        {% content_for 'block', type: 'mionas-add-to-cart', id: 'static-add-to-cart', closest.product: latest_product %}
      {%- endcapture -%}
      {% render 'mionas-product-upsell-card', product: latest_product, button: button %}
      {% render 'mionas-button-class', variant: 'secondary', size: 'sm' %}
    </template>

    <mionas-product-upsells
      data-skip-node-update
      hidden
      data-url="{{ routes.product_recommendations_url }}"
      data-collections="{{ collection_handles }}"
      data-button-tooltip="{{ button_tooltip | escape }}"
    >
      {% render 'mionas-text',
        content: heading,
        variant: 'body',
        tag: 'p',
        class: 'mionas-product-upsells__heading'
      %}
      <div class="mionas-product-upsells__list" data-list></div>
    </mionas-product-upsells>
  </div>
{%- endif -%}

{% stylesheet %}
  /* A card lays its children out at their own width; the list fills the card. */
  .mionas-product-upsells {
    width: 100%;
  }

  mionas-product-upsells {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-block-start: var(--space-sm);
  }

  mionas-product-upsells[hidden] {
    display: none;
  }

  .text-role.mionas-product-upsells__heading {
    font-weight: var(--card-title-font-weight);
  }

  /* The add-to-cart button's animation layers are absolutely positioned; a positioned list keeps
     them inside the card. */
  .mionas-product-upsells__list {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
  }


  @media screen and (min-width: 750px) {
    mionas-product-upsells {
      gap: var(--space-2xs);
      margin-block-start: var(--space-xs);
    }

    .text-role.mionas-product-upsells__heading {
      display: none;
    }

    .mionas-product-upsells__list {
      gap: var(--space-xs);
    }
  }

  /* Four cards a row at most, then three, two and one as the free-shipping card narrows, each card
     at least 300px so a name fits on its one line. Breakpoints are the card's width, not the
     window's, because the card sits full width or in a column depending on the cart's setting. */
  mionas-product-upsells {
    container: mionas-product-upsells / inline-size;
  }

  @container mionas-product-upsells (min-width: 608px) {
    .mionas-product-upsells__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container mionas-product-upsells (min-width: 916px) {
    .mionas-product-upsells__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container mionas-product-upsells (min-width: 1224px) {
    .mionas-product-upsells__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Product Upsells",
  "tag": null,
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Suggest from",
      "info": "Only related products in these collections are suggested. Leave empty to suggest any related product."
    },
    {
      "type": "text",
      "id": "button_tooltip",
      "label": "Button tooltip",
      "info": "Shown when the pointer rests on a card's cart button. Leave empty to use the theme's own wording, which stays translated per language."
    }
  ],
  "presets": [{ "name": "Mionas: Product Upsells" }]
}
{% endschema %}
