{%- comment -%}
  A hand-configured review card for the theme editor.

  The markup and CSS live in snippets/mionas-review-card.liquid because
  sections/mionas-google-reviews.liquid renders the same card from Google Business Profile data.
  This file's only job is to map theme-editor settings onto that snippet -- see the snippet's
  comment for the design-system and token reasoning.
{%- endcomment -%}
{% render 'mionas-review-card',
  rating: block.settings.rating,
  quote: block.settings.quote,
  name: block.settings.name,
  location: block.settings.location,
  avatar: block.settings.avatar,
  avatar_alt: block.settings.avatar_alt,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Mionas: Review card",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "Rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Number of filled stars out of 5."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Las mejores cookies que he probado fuera de EE.UU. Llegaron perfectas."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Marta G."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "info": "Optional. Shown after the name."
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Avatar",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "avatar_alt",
      "label": "Avatar alt text",
      "info": "Falls back to the name if left blank. Only used when an avatar is set."
    }
  ],
  "presets": [
    {
      "name": "Mionas: Review card",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
