{%- comment -%}
  Mirrors ../design-system/src/react/ProductCard/{ProductCard.tsx,ProductCardMedia.tsx,
  ProductCardPrice.tsx}: a Card shell, rendered `as="a"` to the product page, with a fixed-height
  cropped media (hover zoom), title, and price.

  Scope, confirmed with the user: this is the low-risk, opt-in fork only. Horizon's storefront-wide
  product grids (collection pages, search results, cart/product recommendations) render through a
  completely different, deeply embedded pair -- snippets/product-card.liquid and the internal
  `_product-card` block -- wired directly into 6 core sections and baked into 9 page template JSON
  files. Neither is touched here. This is a new, separate, merchant-addable block (the same relationship
  blocks/product-card.liquid, the *native* merchant-addable one, has to that same core pair) meant to
  be inserted explicitly -- e.g. inside a Mionas: Card, a group, or a custom section.

  ProductCard.tsx's `as="a"` mode never nests a separate pressable action (an <a> can't validly
  contain a <button>), so ProductCardActions isn't reproduced here -- there is nothing left to
  compose once the whole card is already the link. A variant with a real add-to-cart action would
  need `as="div"` plus separate inner links, which is a bigger, separate piece of work.

  Every colour/radius/shadow/spacing/gap comes from --card-*/--product-card-* tokens
  (assets/design-tokens.css); title and price both use the "body" text role's size/line-height/
  letter-spacing, with only weight/colour overridden locally, the same convention every other Mionas
  block follows. Family is --card-base-font-family, the token ProductCard inherits by rendering
  inside a Card; it resolves through --font-family-archivo, which
  snippets/design-system-bridge.liquid repoints at the theme's loaded body font.
{%- endcomment -%}
{% liquid
  assign card_product = block.settings.product
%}

{%- if card_product != blank -%}
  <a href="{{ card_product.url }}" class="mionas-product-card" {{ block.shopify_attributes }}>
    <div class="mionas-product-card__media">
      {%- if card_product.featured_image != blank -%}
        {{
          card_product.featured_image
          | image_url: width: 640
          | image_tag: class: 'mionas-product-card__media-img', alt: card_product.featured_image.alt, loading: 'lazy'
        }}
      {%- endif -%}
    </div>
    <p class="mionas-product-card__title">{{ card_product.title }}</p>
    <p class="mionas-product-card__price">{{ card_product.price | money }}</p>
  </a>
{%- endif -%}

{% stylesheet %}
  .mionas-product-card {
    display: block;
    background: var(--card-base-background);
    border-radius: var(--card-base-radius);
    border: var(--card-base-border-width) solid var(--card-base-border-color);
    box-shadow: var(--card-base-shadow);
    font-family: var(--card-base-font-family);
    max-width: 320px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    padding-bottom: var(--card-base-padding);
  }

  .mionas-product-card:active {
    opacity: var(--card-state-pressed-opacity);
  }

  .mionas-product-card__media {
    /* ProductCard.module.css hardcodes both of these and the design system has no token behind
       either yet, so each is declared once here as a block-local custom property -- one line to
       swap the day a token appears, instead of a literal buried in a transform and a transition. */
    --product-card-media-hover-scale: 1.05;
    --product-card-media-hover-duration: 0.5s;

    height: var(--product-card-base-media-height);
    overflow: hidden;
  }

  .mionas-product-card__media-img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
    transition: transform var(--product-card-media-hover-duration) ease;
  }

  .mionas-product-card__media:hover .mionas-product-card__media-img {
    transform: scale(var(--product-card-media-hover-scale));
  }

  .mionas-product-card__title {
    margin: 0;
    padding: var(--card-base-padding) var(--card-base-padding) 0;
    font-size: var(--text-role-body-font-size);
    line-height: var(--text-role-body-line-height);
    font-weight: var(--card-title-font-weight);
    letter-spacing: var(--text-role-body-letter-spacing);
    color: var(--card-title-foreground);
  }

  .mionas-product-card__price {
    margin-top: var(--product-card-base-gap);
    padding: 0 var(--product-card-base-padding-inline);
    font-size: var(--text-role-body-font-size);
    line-height: var(--text-role-body-line-height);
    font-weight: var(--product-card-price-font-weight);
    letter-spacing: var(--text-role-body-letter-spacing);
    color: var(--product-card-price-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Product card",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Product card",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
