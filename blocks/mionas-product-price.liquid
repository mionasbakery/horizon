{%- comment -%}
  Mirrors ../design-system/src/react/ProductCard/ProductCardPrice.tsx: the product price at the
  "body" text role, in --product-card-price-* weight and colour.

  Reads closest.product, so it renders only inside a product context -- the card slot of
  sections/mionas-collection.liquid, a native product card, or a product page.

  ProductCardPrice.tsx shows a single price. The compare-at price is offered here as an opt-in
  setting because a bakery running a promotion has nowhere else to show it on the card, but it is off
  by default so the default composition stays faithful to the design system. It renders only when the
  product is genuinely discounted.
{%- endcomment -%}

{%- liquid
  assign product = closest.product
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

{%- if product != blank -%}
  <p class="mionas-product-price" {{ block.shopify_attributes }}>
    <span class="mionas-product-price__current">{{ product.price | money }}</span>

    {%- if block.settings.show_compare_at_price and on_sale -%}
      <s class="mionas-product-price__compare">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        {{- product.compare_at_price | money -}}
      </s>
    {%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .mionas-product-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs, 8px);
    margin: 0;
    padding-inline: var(--product-card-base-padding-inline);
    font-family: var(--card-base-font-family);
    font-size: var(--text-role-body-font-size);
    line-height: var(--text-role-body-line-height);
    letter-spacing: var(--text-role-body-letter-spacing);
    font-weight: var(--product-card-price-font-weight);
    color: var(--product-card-price-foreground);
  }

  /* The struck-through original is deliberately lighter than the live price rather than a new
     colour: the design system has no token for a compare-at price, and inheriting the price colour
     at reduced opacity keeps it on-palette whatever --product-card-price-foreground becomes. */
  .mionas-product-price__compare {
    opacity: 0.6;
    font-weight: var(--text-role-body-font-weight, 400);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Product price",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "Show compare-at price",
      "default": false,
      "info": "Shows the original price struck through, only on products that are actually discounted."
    }
  ],
  "presets": [
    {
      "name": "Mionas: Product price",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
