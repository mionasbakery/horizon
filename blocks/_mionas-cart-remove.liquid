{%- doc -%}
  Renders the button that removes a cart line inside sections/mionas-cart.liquid. The on:click path
  is assets/component-cart-items.js's onLineItemRemove, which counts lines from 1.

  @param {object} line - The cart line item.
{%- enddoc -%}

{%- assign can_remove = line.instructions.can_remove | default: true, allow_false: true -%}

{%- assign remove_label = 'actions.remove' | t -%}
<button
  class="mionas-cart-remove"
  type="button"
  aria-label="{{ 'accessibility.remove_item' | t: title: line.title | escape }}"
  on:click="/onLineItemRemove/{{ line.index | plus: 1 }}"
  {% unless can_remove %}
    hidden
  {% endunless %}
  {{ block.shopify_attributes }}
>
  {% render 'mionas-text', content: remove_label, variant: 'body', color: 'primary', tag: 'span' %}
</button>

{% stylesheet %}
  .mionas-cart-remove {
    display: inline-flex;
    align-items: center;
    min-height: var(--minimum-touch-target);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .mionas-cart-remove .text-role {
    font-weight: var(--link-body-font-weight);
    text-decoration: underline;
  }

  .mionas-cart-remove[hidden] {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Cart Remove",
  "tag": null,
  "settings": []
}
{% endschema %}
