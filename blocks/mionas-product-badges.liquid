{%- doc -%}
  Renders a product's custom.badges metafield as a row or overlay of colored badge pills.

  @param {product} [closest.product] - The product whose badges to render. Renders nothing if absent.
{%- enddoc -%}

{%- comment -%}
  Badges on a product card: short labels like "Sin gluten" or "Nuevo", from the product's
  custom.badges metafield -- a list of `badge` metaobjects with `label`, `kind`, and optional
  `background_color`/`foreground_color` color fields. Each one is a Mionas Badge
  (snippets/mionas-badge.liquid): kind information is the Outline variant, highlight the Default one,
  and a background colour fills either. No automatic contrast pairing between the two fields --
  the merchant can pick colors that clash, same as any design tool.

  A metaobject, not a tag, because mionasbakery publishes es (primary) and ca locales and tags
  aren't translatable; a metaobject's label field is.

  Metaobject fields need `.value` (e.g. `badge.label.value`) -- getting this wrong renders a blank
  label rather than raising, so it fails silently.

  The card mounts this block twice: once as an overlay of highlight badges over the image, once
  inline under the title for information ones. `kind` routes them, which is why it's a constrained
  select on the metaobject rather than a free string.

  Deliberately not reusing ProductPromoCard's promo flag, Stamp's eyebrow, or Horizon's sale/sold-out
  chip -- a badge here is a per-product property, not a marketing device, by the store owner's
  explicit choice.

  The overlay needs no native edit or fork: Horizon's own sale/sold-out badge is absolute against
  .card-gallery inside a block that accepts no children, but .product-card__content is already
  position: relative (base.css), so an overlay child of the card pins to the card box with no new
  positioning rule.

  Known collision: Horizon's native Sale/Sold out badge sits at the corner set in
  settings.badge_position. If that matches this block's Corner setting, the two overlap -- not
  detected automatically, since the theme setting is global and this block is per-placement. Fix is
  merchandising: put the native badges on the opposite corner.
{%- endcomment -%}
{%- liquid
  assign product = closest.product
  assign block_settings = block.settings
  assign badges = product.metafields.custom.badges.value

  assign kind_filter = block_settings.kind | default: 'all'
  assign placement = block_settings.placement | default: 'inline'
-%}

{%- if badges != blank -%}
  {%- capture items -%}
    {%- for badge in badges -%}
      {%- liquid
        assign badge_kind = badge.kind.value
        # Merchant text from a metaobject; snippets/mionas-badge.liquid expects it escaped.
        assign badge_label = badge.label.value | escape

        # information is a quiet fact (Badge's outline); highlight takes the default fill.
        assign badge_variant = 'outline'
        if badge_kind == 'highlight'
          assign badge_variant = 'default'
        endif
      -%}
      {%- if badge_label != blank -%}
        {%- if kind_filter == 'all' or kind_filter == badge_kind -%}
          <li class="mionas-product-badges__item">
            {%- comment -%}
              background_color and foreground_color are Shopify color fields, so "#rrggbb" or
              blank, safe for the snippet's inline style.
            {%- endcomment -%}
            {%- render 'mionas-badge',
              text: badge_label,
              variant: badge_variant,
              size: block_settings.size,
              background: badge.background_color.value,
              foreground: badge.foreground_color.value
            -%}
          </li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- comment -%}
    The gate is on the captured items, not on `badges`: a product can carry badges of which none
    match this instance's Kind filter, and an empty <ul> would still take its gap slot in the card's
    flex column. Same reflex as blocks/mionas-text.liquid's visible_text check.
  {%- endcomment -%}
  {%- assign has_items = items | strip -%}

  {%- if has_items != blank -%}
    {%- liquid
      assign list_class = 'mionas-product-badges spacing-style mionas-product-badges--' | append: placement
      if placement == 'overlay'
        assign corner = block_settings.corner | default: 'top-left'
        assign list_class = list_class | append: ' mionas-product-badges--' | append: corner
      endif
    -%}
    {%- capture list_style -%}
      {%- render 'spacing-style', settings: block_settings -%}
    {%- endcapture -%}
    <ul
      class="{{ list_class }}"
      style="{{ list_style }}"
      {{ block.shopify_attributes }}
    >
      {{- items -}}
    </ul>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .mionas-product-badges {
    display: flex;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Several badges is the normal case, so each placement lays its list out for it: the inline row
     wraps onto a second line rather than truncating, and the overlay stacks down the corner rather
     than running sideways across the photo. */
  .mionas-product-badges--inline {
    flex-wrap: wrap;
    align-items: center;
  }

  .mionas-product-badges--overlay {
    /* Absolute against .product-card__content, which base.css already makes position: relative. The
       inset clears the card's own corner radius, the same trick --badge-inset uses in
       product-badges-styles.liquid -- a flat 8px offset visually collides with a 16px-radius
       corner. */
    --mionas-product-badges-inset: max(var(--space-xs), calc(var(--card-base-radius) * (1 - cos(45deg))));

    position: absolute;
    z-index: var(--layer-flat);
    flex-direction: column;
    align-items: flex-start;

    /* The whole card is a link (snippets/product-card.liquid:80) and these badges are not
       interactive, so they must never intercept the click. */
    pointer-events: none;
  }

  .mionas-product-badges--top-left {
    top: var(--mionas-product-badges-inset);
    left: var(--mionas-product-badges-inset);
  }

  .mionas-product-badges--top-right {
    top: var(--mionas-product-badges-inset);
    right: var(--mionas-product-badges-inset);
  }

  .mionas-product-badges--bottom-left {
    bottom: var(--mionas-product-badges-inset);
    left: var(--mionas-product-badges-inset);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Product Badges",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "kind",
      "label": "Kind",
      "options": [
        { "value": "all", "label": "All" },
        { "value": "information", "label": "Information" },
        { "value": "highlight", "label": "Highlight" }
      ],
      "default": "information",
      "info": "Which badges from the product's Badges metafield this instance renders."
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "default": "sm",
      "info": "Small uses Note text, Medium Label, Large Body. Small suits a product card."
    },
    {
      "type": "select",
      "id": "placement",
      "label": "Placement",
      "options": [
        { "value": "inline", "label": "Inline" },
        { "value": "overlay", "label": "Overlay" }
      ],
      "default": "inline",
      "info": "Overlay pins the badges to a corner of the card, over the image."
    },
    {
      "type": "select",
      "id": "corner",
      "label": "Corner",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "top-left",
      "visible_if": "{{ block.settings.placement == 'overlay' }}",
      "info": "Avoid the corner used by the theme's own Sale and Sold out badges, or they overlap."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Product Badges",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
