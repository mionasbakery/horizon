{%- doc -%}
  A full-bleed image tile with a bottom gradient scrim, title, and subtitle, always a link.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system/src/react/FeatureCard/FeatureCard.tsx: a full-bleed photo tile with a
  bottom gradient scrim, an uppercase title, and a subtitle -- always a link, anatomy fixed (no
  variant prop, no children slot).

  No native Horizon block/section covers this, so it forks a new file per mionas-design-component's
  rule rather than reskinning.

  FeatureCard.tsx composes Card, CardMedia, Box and Text. This renders the Card classes and Text, and
  adds only what FeatureCard.module.css adds: the tile shape, the full-bleed media and the overlay.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.link != blank -%}
  <a
    href="{{ block_settings.link }}"
    class="{% render 'mionas-card-class', interactive: true %} mionas-feature-card"
    {%- if block_settings.open_in_new_tab -%} target="_blank" rel="noopener noreferrer"{%- endif -%}
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.image != blank -%}
      {{
        block_settings.image
        | image_url: width: 800
        | image_tag: class: 'mionas-feature-card__media', alt: block_settings.alt, loading: 'lazy'
      }}
    {%- endif -%}
    <div class="mionas-feature-card__overlay">
      {%- if block_settings.title != blank -%}
        {%- render 'mionas-text',
          content: block_settings.title,
          variant: 'subheading',
          color: 'inverse-primary',
          transform: 'uppercase'
        -%}
      {%- endif -%}
      {%- if block_settings.subtitle != blank -%}
        {%- render 'mionas-text',
          content: block_settings.subtitle,
          variant: 'body',
          color: 'inverse-primary',
          class: 'mionas-feature-card__subtitle'
        -%}
      {%- endif -%}
    </div>
  </a>
{%- endif -%}

{% stylesheet %}
  .mionas-feature-card {
    position: relative;
    display: block;
    aspect-ratio: var(--feature-card-base-aspect-ratio);
    text-decoration: none;
    color: inherit;
  }

  .mionas-feature-card__media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }

  .mionas-feature-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--feature-card-overlay-padding);
    background: var(--feature-card-base-background);
  }

  .text-role.mionas-feature-card__subtitle {
    margin-top: 4px;
    opacity: var(--feature-card-subtitle-opacity);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Feature Card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ocasions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Mionas: Feature Card",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
