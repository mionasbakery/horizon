{%- doc -%}
  A full-bleed image tile with a bottom gradient scrim, title, and subtitle, always a link.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system/src/react/FeatureCard/FeatureCard.tsx: a full-bleed photo tile with a
  bottom gradient scrim, an uppercase title, and a subtitle -- always a link, anatomy fixed (no
  variant prop, no children slot).

  No native Horizon block/section covers this, so it forks a new file per mionas-design-component's
  rule rather than reskinning.

  FeatureCard.tsx composes Card + CardMedia + Box + Text, but none render here as separate blocks --
  this reproduces their combined CSS directly, since the anatomy is fixed and Card's own
  padding/max-width don't apply (FeatureCard.module.css overrides both to 0/none).

  Family is --font-family-archivo, the design system's body primitive that
  snippets/design-system-bridge.liquid repoints at the theme's loaded body font -- spent directly
  since FeatureCard.module.css itself sets no family and just inherits it from Text.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.link != blank -%}
  <a
    href="{{ block_settings.link }}"
    class="mionas-feature-card"
    {%- if block_settings.open_in_new_tab -%} target="_blank" rel="noopener noreferrer"{%- endif -%}
    {{ block.shopify_attributes }}
  >
    {%- if block_settings.image != blank -%}
      {{
        block_settings.image
        | image_url: width: 800
        | image_tag: class: 'mionas-feature-card__media', alt: block_settings.alt, loading: 'lazy'
      }}
    {%- endif -%}
    <div class="mionas-feature-card__overlay">
      {%- if block_settings.title != blank -%}
        <p class="mionas-feature-card__title">{{ block_settings.title }}</p>
      {%- endif -%}
      {%- if block_settings.subtitle != blank -%}
        <p class="mionas-feature-card__subtitle">{{ block_settings.subtitle }}</p>
      {%- endif -%}
    </div>
  </a>
{%- endif -%}

{% stylesheet %}
  .mionas-feature-card {
    position: relative;
    display: block;
    aspect-ratio: var(--feature-card-base-aspect-ratio);
    border-radius: var(--card-base-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  .mionas-feature-card:active {
    opacity: var(--card-state-pressed-opacity);
  }

  .mionas-feature-card__media {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    object-fit: cover;
  }

  .mionas-feature-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--feature-card-overlay-padding);
    background: var(--feature-card-base-background);
  }

  /* Weight comes from the title-lg role, not a FeatureCard token -- the design system has none;
     Text's title-lg band already carries the weight. Its tracking is 0 (not an omission). */
  .mionas-feature-card__title {
    margin: 0;
    font-family: var(--font-family-archivo);
    font-size: var(--text-role-title-lg-font-size);
    line-height: var(--text-role-title-lg-line-height);
    font-weight: var(--text-role-title-lg-font-weight);
    letter-spacing: var(--text-role-title-lg-letter-spacing);
    text-transform: uppercase;
    color: var(--text-color-inverse-primary);
  }

  .mionas-feature-card__subtitle {
    margin: 4px 0 0;
    font-family: var(--font-family-archivo);
    font-size: var(--text-role-body-md-font-size);
    line-height: var(--text-role-body-md-line-height);
    font-weight: var(--text-role-body-md-font-weight);
    letter-spacing: var(--text-role-body-md-letter-spacing);
    color: var(--text-color-inverse-primary);
    opacity: var(--feature-card-subtitle-opacity);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Feature card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ocasions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Mionas: Feature card",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
