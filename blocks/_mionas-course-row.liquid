{%- comment -%}
  The per-course row of sections/mionas-course-list.liquid: date badge, title, meta line, and a
  single CTA that is either "Reservar" (to the product page) or "Lista de espera" when sold out.

  Private (leading underscore) because it reads closest.product and renders nothing outside a
  product context, so it must not appear in the merchant's block picker. It's a static block
  (fixed id via content_for 'block') so the editor shows one settings row governing every course,
  not one per iteration.

  Unlike snippets/group.liquid, the row can't use a whole-card overlay link: its CTA is itself an
  `<a>`, and an overlay link plus a button anchor puts a link inside a link's hit area. It would
  also contradict the sold-out state, where the CTA is deliberately inert. The CTA is a link, not
  add-to-cart, because the family workshop has two variants at different prices and this is a
  considered purchase people research before committing.

  It wears .mionas-button--outline directly rather than duplicating the CSS (as
  snippets/mionas-submit-button.liquid must, for its own reasons) because the CTA is already an
  anchor. That also means the inert waitlist button inherits
  .mionas-button[aria-disabled="true"]'s dimmed styling for free.

  `| date:` accepts the `custom.course_date` metafield value directly, so no string-parsing
  fallback is needed. But `| date: '%b'` renders the English abbreviation regardless of storefront
  locale, so the Spanish month label below is looked up from a fixed list keyed by the
  locale-independent `%m` instead.
{%- endcomment -%}

{%- liquid
  assign product = closest.product

  # NOT `assign settings = block.settings`: `settings` is the global theme-settings object in
  # Shopify Liquid, and shadowing it here would break any snippet rendered below that reads
  # settings.color_palette or similar. blocks/mionas-button.liquid uses block_settings for the
  # same reason.
  assign block_settings = block.settings

  assign course_date = product.metafields.custom.course_date.value

  # Spanish month label lookup -- see the header comment above on why `%b` is not trusted. '%m' is
  # numeric and locale-independent, so indexing into a fixed Spanish list with it is safe where
  # `%b` is not.
  #
  # If course_date were blank, '%m' | plus: 0 is 0 and `minus: 1` makes month_index -1. Liquid's
  # array indexing follows Ruby semantics, so a negative index counts from the end -- month_names[-1]
  # is 'DIC', a confidently wrong month rather than an error. The render guard below requires
  # course_date to be present specifically to keep this branch unreachable.
  assign month_names = 'ENE,FEB,MAR,ABR,MAY,JUN,JUL,AGO,SEP,OCT,NOV,DIC' | split: ','
  assign month_index = course_date | date: '%m' | plus: 0 | minus: 1
  assign month_label = month_names[month_index]

  # Meta line parts are collected into a delimited string and split, so an empty part disappears
  # ALONG WITH ITS SEPARATOR. Appending ' · ' inline instead would leave "3h ·  · €79,00" whenever
  # capacity is unset. `split` discards empty segments, which is exactly the behaviour wanted here.
  assign meta_parts = ''

  if block_settings.show_duration
    assign duration = product.metafields.custom.course_duration.value
    if duration != blank
      assign meta_parts = meta_parts | append: duration | append: '|'
    endif
  endif

  if block_settings.show_capacity
    assign capacity = product.metafields.custom.course_capacity.value
    if capacity != blank
      assign meta_parts = meta_parts | append: capacity | append: '|'
    endif
  endif

  if block_settings.show_price
    assign price_text = product.price_min | money
    # product.price_varies is true when min and max differ -- the family workshop's €59/€79.
    if product.price_varies
      assign price_text = block_settings.price_from_prefix | append: ' ' | append: price_text
    endif
    assign meta_parts = meta_parts | append: price_text | append: '|'
  endif

  assign meta_list = meta_parts | split: '|'

  if product.available
    assign cta_label = block_settings.book_label
    assign cta_url = product.url
  else
    assign cta_label = block_settings.waitlist_label
    assign cta_url = block_settings.waitlist_url
  endif

  assign heading_tag = 'h' | append: block_settings.heading_level

  # Built via append rather than a literal class="..." string, matching
  # blocks/mionas-add-to-cart.liquid:156's convention -- theme check's ValidScopedCSSClass rule
  # only inspects literal class attributes, and a literal string here would flag mionas-button and
  # its modifiers as "possibly out of scope" even though blocks/mionas-button.liquid's stylesheet
  # (rendered elsewhere on every page) is exactly where they are defined.
  assign cta_classes = 'mionas-button mionas-button--outline mionas-button--sm' | append: ' mionas-course-row__cta'
-%}

{%- if product != blank and course_date != blank -%}
  <div
    class="mionas-course-row spacing-style"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.background_color != blank %}--mionas-course-row-background: {{ block_settings.background_color }};{% endif %}
      --mionas-course-row-radius: {{ block_settings.corner_radius }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- comment -%}
      The badge is the single source of truth for the course date. Some products still carry a
      leftover `DD/MM ` prefix in their title as well as the course_date metafield -- strip that
      prefix before publishing, or the date renders twice.
    {%- endcomment -%}
    <div class="mionas-course-row__date">
      <time datetime="{{ course_date | date: '%Y-%m-%d' }}">
        <span class="mionas-course-row__day">{{ course_date | date: '%d' }}</span>
        <span class="mionas-course-row__month">{{ month_label }}</span>
      </time>
    </div>

    <div class="mionas-course-row__body">
      <{{ heading_tag }} class="mionas-course-row__title">{{ product.title }}</{{ heading_tag }}>
      {%- if meta_list.size > 0 -%}
        <p class="mionas-course-row__meta">{{ meta_list | join: ' · ' }}</p>
      {%- endif -%}
    </div>

    <div class="mionas-course-row__actions">
      {%- unless product.available -%}
        <span class="mionas-course-row__badge">{{ block_settings.sold_out_label }}</span>
      {%- endunless -%}

      {%- comment -%}
        Blank-link branch matches blocks/mionas-button.liquid:45-50 -- role="link" plus
        aria-disabled="true", rendered dimmed and inert by .mionas-button[aria-disabled="true"].
        The if/else tags carry no whitespace-stripping hyphens for the same reason as there
        (blocks/mionas-button.liquid:38-43): stripping glues the anchor to its first attribute and
        breaks the element.
      {%- endcomment -%}
      <a
        {% if cta_url == blank %}
          role="link"
          aria-disabled="true"
        {% else %}
          href="{{ cta_url }}"
        {% endif %}
        class="{{ cta_classes }}"
        aria-label="{{ cta_label }}: {{ product.title | escape }}"
      >
        {{- cta_label -}}
      </a>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Mobile first: date on the left, title/meta beside it, CTA full-width beneath. Desktop becomes
     a three-zone line via the min-width: 750px override below. */
  .mionas-course-row {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    column-gap: var(--space-sm);
    row-gap: var(--space-xs);
    background: var(--mionas-course-row-background, var(--card-base-background));
    border: var(--card-base-border-width) solid var(--card-base-border-color);
    border-radius: var(--mionas-course-row-radius, var(--card-base-radius));
    box-shadow: var(--card-base-shadow);
    font-family: var(--card-base-font-family);
  }

  .mionas-course-row__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }

  /* display: contents drops <time>'s own box so its day/month children keep participating in the
     parent flex container as if <time> weren't there, while still giving the badge one
     machine-readable datetime. */
  .mionas-course-row__date time {
    display: contents;
  }

  .mionas-course-row__day {
    font-size: var(--text-role-title-lg-font-size);
    font-weight: var(--text-role-title-lg-font-weight);
    line-height: 1;
  }

  .mionas-course-row__month {
    color: var(--color-vermell-segell);
    font-size: var(--text-role-label-lg-font-size);
    font-weight: var(--text-role-label-md-font-weight);
    letter-spacing: var(--text-role-label-md-letter-spacing);
  }

  .mionas-course-row__body {
    min-width: 0;
  }

  /* Body typography on a heading element, kept a heading only for document outline/accessibility.
     text-transform and letter-spacing are set explicitly to override base.css's h3 preset
     (uppercase, tracked), which otherwise leaks through -- same reason
     blocks/mionas-text.liquid's .text-role declares font-family. */
  .mionas-course-row__title {
    margin: 0;
    font-size: var(--text-role-body-md-font-size);
    font-weight: var(--text-role-label-md-font-weight);
    line-height: var(--text-role-body-md-line-height);
    text-transform: none;
    letter-spacing: var(--text-role-body-md-letter-spacing);
    text-wrap: pretty;
  }

  .mionas-course-row__meta {
    margin: var(--space-3xs) 0 0;
    font-size: var(--text-role-label-lg-font-size);
    line-height: var(--text-role-label-lg-line-height);
    color: var(--color-neutral-400);
  }

  /* Full-bleed across both columns on mobile -- this is what makes the CTA a full-width tap target,
     which is the whole point of layout A. */
  .mionas-course-row__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2xs);
  }

  .mionas-course-row__badge {
    align-self: flex-start;
    background: var(--color-vermell-segell);
    color: var(--color-white);
    border-radius: var(--radius-full);
    padding: var(--space-3xs) var(--space-xs);
    font-size: var(--text-role-label-lg-font-size);
    font-weight: var(--text-role-label-md-font-weight);
  }

  /* .mionas-button is inline-flex; stretch it to the column on mobile only. */
  .mionas-course-row__cta {
    display: flex;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .mionas-course-row {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      column-gap: var(--space-md);
      row-gap: 0;
    }

    .mionas-course-row__actions {
      grid-column: auto;
      flex-direction: row;
      align-items: center;
      gap: var(--space-xs);
    }

    .mionas-course-row__cta {
      display: inline-flex;
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Course row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "book_label",
      "label": "Book button label",
      "default": "Reservar"
    },
    {
      "type": "text",
      "id": "waitlist_label",
      "label": "Waitlist button label",
      "default": "Lista de espera"
    },
    {
      "type": "url",
      "id": "waitlist_url",
      "label": "Waitlist link",
      "info": "Leave blank to render the button as an inert, dimmed placeholder."
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out badge",
      "default": "Agotado"
    },
    {
      "type": "header",
      "content": "Meta line"
    },
    {
      "type": "checkbox",
      "id": "show_duration",
      "label": "Show duration",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_capacity",
      "label": "Show capacity",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "price_from_prefix",
      "label": "Prefix for products with several prices",
      "default": "desde",
      "visible_if": "{{ block.settings.show_price }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Title HTML tag",
      "options": [
        { "value": "2", "label": "h2" },
        { "value": "3", "label": "h3" },
        { "value": "4", "label": "h4" }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ]
}
{% endschema %}
