{%- doc -%}
  A circular icon-only link button.
{%- enddoc -%}
{%- comment -%}
  Mirrors ../design-system's IconButton: a circular icon-only link on the Button variants and sizes.

  Icon-only means the label is entirely the accessible name -- there is no visible text for a screen
  reader to fall back on. `aria_label` is therefore effectively required, not decorative; it carries
  no schema default on purpose; an empty accessible name is worse than an obviously-blank editor
  field prompting a merchant to fill it in.

  Markup and styles live in snippets/mionas-icon-button.liquid so blocks/mionas-social-link.liquid
  can reuse them without duplication -- a block can't {% render %} another block.
{%- endcomment -%}
{% render 'mionas-icon-button',
  icon: block.settings.icon,
  link: block.settings.link,
  aria_label: block.settings.aria_label,
  open_in_new_tab: block.settings.open_in_new_tab,
  variant: block.settings.variant,
  size: block.settings.size,
  shopify_attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Mionas: Icon Button",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "instagram", "label": "Instagram" },
        { "value": "tiktok", "label": "TikTok" },
        { "value": "whatsapp", "label": "WhatsApp" }
      ],
      "default": "instagram"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible name",
      "info": "Announced by screen readers -- this button shows no visible text, so this is its only accessible name. Required in practice."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" },
        { "value": "danger", "label": "Danger" },
        { "value": "inverse-primary", "label": "Inverse primary" },
        { "value": "inverse-ghost", "label": "Inverse ghost" },
        { "value": "inverse-outline", "label": "Inverse outline" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" }
      ],
      "default": "md"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Icon Button",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
