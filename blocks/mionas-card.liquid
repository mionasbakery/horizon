{%- doc -%}
  Renders a bordered/shadowed content shell that composes freely with nested child theme blocks.
{%- enddoc -%}

{%- comment -%}
  Mirrors ../design-system/src/react/Card/Card.tsx: a bordered/shadowed shell that composes freely
  with any nested child block. Distinct from the native blocks/_card.liquid, which is a generic
  layout panel on Horizon's own tokens rather than the design system's --card-* ones.

  Renders through snippets/group.liquid, borrowing its layout/size/link schema, but deliberately
  omits Group's Appearance/Borders sections and Card.module.css's max-width cap: the `variant`
  setting below owns the surface entirely, and the Size settings are the single answer to width, so
  a hidden cap silently contradicting a merchant's choice would be worse than losing that bit of
  fidelity.

  Background/border/radius are applied via the `style:` param rather than a plain CSS rule, because
  snippets/border-override.liquid emits unconditionally and would tie with `.mionas-card` at equal
  specificity; `style:` is appended last, so it always wins.

  Padding starts at 0 on every side, diverging from Card.tsx's own default bottom padding, so
  children bleed to all edges until a merchant adds what the composition needs.

  Only covers Card.tsx's `as="div"|"a"` (no "as button"), the same scope call mionas-button.liquid
  and mionas-link.liquid make elsewhere.
{%- endcomment -%}
{% liquid
  assign block_settings = block.settings
  assign variant = block_settings.variant | default: 'default'

  assign card_classes = 'mionas-card'
  unless variant == 'default'
    assign card_classes = card_classes | append: ' mionas-card--' | append: variant
  endunless
  if block_settings.link != blank
    assign card_classes = card_classes | append: ' mionas-card--interactive'
  endif
%}

{%- comment -%}
  The whole card surface, driven by `variant` alone. Plain is a transparent, square, borderless
  surface -- it contributes no background so whatever sits behind the card shows through.
{%- endcomment -%}
{%- capture card_style -%}
  {%- case variant -%}
    {%- when 'plain' -%}
      --border-width: 0; --border-style: none; --border-radius: 0;
    {%- when 'outline' -%}
      background: var(--card-base-background);
      --border-width: var(--card-base-border-width); --border-style: solid;
      --border-color: var(--card-outline-border-color); --border-radius: var(--card-base-radius);
    {%- else -%}
      background: var(--card-base-background);
      --border-width: var(--card-base-border-width); --border-style: solid;
      --border-color: var(--card-base-border-color); --border-radius: var(--card-base-radius);
  {%- endcase -%}
{%- endcapture -%}

{%- capture children -%}
  {%- content_for 'blocks' -%}
{%- endcapture -%}

{%- render 'group',
  children: children,
  settings: block_settings,
  shopify_attributes: block.shopify_attributes,
  block_id: block.id,
  class: card_classes,
  style: card_style
-%}

{% stylesheet %}
  /* Background, border and radius ride on the `style:` param above, not here -- see the file
     comment. Padding is absent entirely: it comes from the Padding settings alone. */
  .mionas-card {
    box-shadow: var(--card-base-shadow);
    font-family: var(--card-base-font-family);
    overflow: hidden;
  }

  .mionas-card--outline,
  .mionas-card--plain {
    box-shadow: none;
  }

  .mionas-card--interactive {
    cursor: pointer;
  }

  .mionas-card--interactive:active {
    opacity: var(--card-state-pressed-opacity);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Card",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "outline", "label": "Outline" },
        { "value": "plain", "label": "Plain" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 matches the design system: children stack flush, the way CardMedia sits against the text under it."
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.block_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Card",
      "category": "t:categories.layout",
      "settings": {
        "variant": "default",
        "gap": 0
      }
    }
  ]
}
{% endschema %}
