{%- comment -%}
  Renders a collection product grid/carousel with a composable, merchant-editable static card.

  The section loops the collection and renders Horizon's native _product-card once per product;
  the card's contents (media, title, price, native and Mionas blocks) are merchant-editable
  children rather than baked into this section. _product-card accepts @theme children and passes
  closest.product down to them (_product-card.liquid:9-11,34), and
  snippets/product-card-bridge.liquid gives it the Mionas look -- a Mionas-owned card block used
  to exist here but was deleted once the store unified on the native card.

  Same shape as sections/mionas-split-panel.liquid: the frame (grid) is owned here, the slot
  (card) is static -- every iteration renders the same fixed id ('static-product-card'), so the
  merchant composes one card design that applies to every product, and a static slot can't be
  removed, reordered or duplicated.

  There's no built-in heading or "see all" setting: the section opens a free content_for 'blocks'
  region above the grid for that, the same way product-list opens one below its grid.

  Layout is delegated to snippets/resource-list.liquid, exactly as product-list does it: every
  card is captured into one string separated by <!--@list/split-->, split into an array, and both
  handed over so resource-list owns grid/carousel/editorial rendering and the mobile-carousel
  fallback.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign max_items = section.settings.max_products

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    mionas-collection
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- comment -%}
    Whitespace control on the tag is load-bearing: base.css hides
    .section-resource-list__content:empty, and a stray newline inside the div would be a text node
    that defeats :empty, leaving a --gap-sized hole above the cards when no block is added.
  {%- endcomment -%}
  <div class="section-resource-list__content">{%- content_for 'blocks' -%}</div>

  {%- comment -%}
    Placement matters: these render outside the capture below, mirroring
    snippets/product-grid.liquid:110-111. Inside the loop they'd emit once per product and get
    swept into the <!--@list/split--> payload, corrupting the array resource-list receives.

    Needed here because snippets/resource-list.liquid renders neither, unlike product-grid --
    every other card style (quick-add, swatches, badges) blocks/_product-card.liquid already
    renders itself.
  {%- endcomment -%}
  {% render 'product-card-styles' %}
  {% render 'product-card-gallery-zoom-details-styles' %}

  {%- capture list_items -%}
    {%- for product in collection.products limit: max_items -%}
      {%- unless forloop.first -%}<!--@list/split-->{%- endunless -%}
      <div class="resource-list__item">
        {%- comment -%}
          One fixed id for every iteration -- see the static-slot note above. The product travels
          as closest.product, which is how every child block resolves which product it is
          rendering (sections/product-list.liquid:37-42 does the same).
        {%- endcomment -%}
        {% content_for 'block',
          type: '_product-card',
          id: 'static-product-card',
          closest.product: product
        %}
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  -%}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'mionasCollectionCarousel',
    slide_count: max_items,
    content_type: 'products',
    test_id: 'mionas-collection'
  %}
</div>

{% stylesheet %}
  /* Layout is owned by the section/section-resource-list/spacing-style/gap-style classes; these
     two rules only make the card fill its grid cell, so cards with different title lengths don't
     end up different heights. */
  .mionas-collection .resource-list__item {
    display: flex;
    height: 100%;
  }

  .mionas-collection .resource-list__item > .product-card {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Collection",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type != 'carousel' }}"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "2",
      "visible_if": "{{ section.settings.layout_type == 'grid' and section.settings.carousel_on_mobile == false }}"
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "60cqw",
          "label": "t:options.one_number"
        },
        {
          "value": "44cqw",
          "label": "t:options.two_number"
        }
      ],
      "default": "60cqw",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "t:content.carousel_navigation",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "t:settings.icon",
      "options": [
        {
          "value": "arrow",
          "label": "t:options.arrows"
        },
        {
          "value": "chevron",
          "label": "t:options.chevrons"
        },
        {
          "value": "arrows_large",
          "label": "t:options.arrows_large"
        },
        {
          "value": "chevron_large",
          "label": "t:options.chevron_large"
        },
        {
          "value": "none",
          "label": "t:options.none"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "t:settings.icon_background",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.icons_style != 'none' and section.settings.layout_type == 'carousel' or section.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Mionas: Collection",
      "category": "t:categories.product",
      "settings": {
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 6,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 8,
        "rows_gap": 24,
        "icons_style": "none",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "center",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 16,
            "background_color": "#FFFFFF",
            "border": "solid",
            "border_width": 1,
            "border_opacity": 100,
            "border_color": "#ECE8E2",
            "border_radius": 16,
            "padding-block-start": 0,
            "padding-block-end": 16,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "square",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_color": "",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "text_color": "#101413",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 16,
                "padding-inline-end": 16
              }
            },
            "price": {
              "type": "mionas-price",
              "name": "Mionas: Price",
              "settings": {
                "variant": "label",
                "size": "lg",
                "color": "default",
                "show_compare_at_price": false,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 16,
                "padding-inline-end": 16
              }
            },
            "add_to_cart": {
              "type": "mionas-add-to-cart",
              "name": "Mionas: Add to cart",
              "settings": {
                "variant": "primary",
                "size": "md",
                "full_width": true,
                "icon_only": false,
                "label_add": "Añadir al carrito",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 16,
                "padding-inline-end": 16
              }
            }
          },
          "block_order": ["card-gallery", "title", "price", "add_to_cart"]
        }
      }
    }
  ]
}
{% endschema %}
