{%- comment -%}
  Renders the breadcrumb trail as a standalone page section.

  The standalone placement: a section a merchant adds, removes and reorders independently at the
  top of a template's section list. blocks/mionas-breadcrumbs.liquid is the same trail as a theme
  block, for nesting inside a Section next to a Heading; both render
  snippets/mionas-breadcrumbs.liquid, which owns the crumb logic and styles. Section and block both
  exist because a page-level trail usually stands alone, but merchants also want it sharing a
  Section's width/background/spacing with a heading -- only a block can do that.

  The trail follows the merchant's navigation menu first (defaulting to navigation-menu, the one
  sections/header-group.json actually renders) so crumbs match a path a visitor could have clicked,
  rather than an invented hierarchy. Templates the menu has no entry for fall back to Shopify's
  template context -- see the snippet for the full derivation rules.

  The setting ids below are referenced by every templates/*.json entry that places this section;
  renaming or removing one silently drops that setting from all of those placements.
{%- endcomment -%}
{% liquid
  assign home_label = section.settings.home_label | default: 'Home'
  assign landmark_label = section.settings.label | default: 'Breadcrumb'

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  {%- render 'mionas-breadcrumbs',
    home_label: home_label,
    landmark_label: landmark_label,
    menu: section.settings.menu
  -%}
</div>

{% schema %}
{
  "name": "Mionas: Breadcrumbs",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "The trail follows this menu's hierarchy. Leave empty to use the header menu (Navigation Menu). Pages the menu doesn't contain fall back to their collection or blog."
    },
    {
      "type": "text",
      "id": "home_label",
      "label": "Home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Accessible name",
      "default": "Breadcrumb",
      "info": "Announced by screen readers to describe the trail. Not shown visually."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Mionas: Breadcrumbs",
      "category": "t:categories.links"
    }
  ]
}
{% endschema %}
