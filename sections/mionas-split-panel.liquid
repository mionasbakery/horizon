{%- comment -%}
  Renders a two-column split panel: a static media side and a static copy side on a colour panel.

  One shape, four roles: the home hero (flush, bleed), the campaign banner (card, bleed, primary
  panel), the loyalty banner (card, inset), and the newsletter card (card, bleed, media left, with
  an email-signup block in the copy). Only the first two ship as presets; the other two are a
  Campaign with its settings and copy blocks swapped.

  A section's `type` is its filename, so renaming this file means moving every
  `"type": "mionas-split-panel"` reference in templates/ along with it, pushed together --
  otherwise a stored section points at a type that no longer exists.

  The two sides are static blocks (content_for 'block' with a fixed type and id) of types that
  already exist, so a merchant can't remove, reorder or duplicate a side -- the same mechanism
  carousel.liquid and product-list.liquid use for their own static slots. This section adds no
  typography, buttons or image rendering of its own.

  The copy side is a `group` (blocks/group.liquid) that renders its children dynamically, so the
  merchant can retitle, reorder, add or remove the eyebrow/heading/lead/actions per instance -- the
  lock is on the section's shape, not the copy's contents. A line-by-line lock would need a private
  `_`-prefixed static block instead (the _carousel-content / _product-list-content pattern).

  Only the split grid and panel colour live here; everything else -- including the copy column's
  flow, gap and alignment -- belongs to the group blocks.
{%- endcomment -%}

{% liquid
  if section.settings.variant == 'primary'
    assign panel_color = 'var(--color-blau-sitges)'
  else
    assign panel_color = 'var(--color-beige-vainilla)'
  endif
%}

<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != blank %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
  "
>
  <div
    class="mionas-split-panel mionas-split-panel--{{ section.settings.variant }} mionas-split-panel--media-{{ section.settings.media_position }} mionas-split-panel--edge-{{ section.settings.panel_edge }} mionas-split-panel--treatment-{{ section.settings.media_treatment }}"
    style="--mionas-split-panel-panel: {{ panel_color }};"
    {{ section.shopify_attributes }}
  >
    <div class="mionas-split-panel__media">
      {% content_for 'block', type: 'group', id: 'static-media' %}
    </div>

    <div class="mionas-split-panel__copy">
      {% content_for 'block', type: 'group', id: 'static-copy' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .mionas-split-panel {
    display: grid;
    /* minmax(0, 1fr) not a bare 1fr: grid items default to min-width: auto, so wide content in
       one column can push it past 50%. Flooring the minimum at 0 keeps the split even regardless
       of content. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: calc(var(--space-md) * 2);
    height: 100%;
    background: var(--mionas-split-panel-panel, var(--color-background));
  }

  /* Only the grid cell and padding; column flow/gap/alignment belongs to the group block inside
     (blocks/group.liquid) -- duplicating that here would fight the merchant's group settings. */
  .mionas-split-panel__copy {
    padding: calc(var(--space-lg) * 2) calc(var(--space-md) * 2);
  }

  /* The media group is set to height: fill (blocks/group.liquid offers fit/fill/custom), so the
     media cell has to have a height of its own or the row collapses. */
  .mionas-split-panel__media {
    height: 100%;
  }

  .mionas-split-panel--media-right .mionas-split-panel__media {
    grid-column: 2;
    grid-row: 1;
  }

  .mionas-split-panel--media-right .mionas-split-panel__copy {
    grid-column: 1;
    grid-row: 1;
  }

  .mionas-split-panel--media-left .mionas-split-panel__media {
    grid-column: 1;
    grid-row: 1;
  }

  .mionas-split-panel--media-left .mionas-split-panel__copy {
    grid-column: 2;
    grid-row: 1;
  }

  /* Single column below the theme's mobile breakpoint, image always leading
     whichever side it takes on desktop. */
  @media screen and (max-width: 749px) {
    .mionas-split-panel {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .mionas-split-panel--media-left .mionas-split-panel__media,
    .mionas-split-panel--media-right .mionas-split-panel__media {
      grid-column: 1;
      grid-row: 1;
      min-height: 220px;
    }

    .mionas-split-panel--media-left .mionas-split-panel__copy,
    .mionas-split-panel--media-right .mionas-split-panel__copy {
      grid-column: 1;
      grid-row: 2;
      padding: calc(var(--space-md) * 2) calc(var(--space-md) + var(--space-2xs));
    }
  }

  /* Card edge: radius + card shadow, no border -- the prototype's border is deliberately dropped
     since all three banners override it to 0. --card-base-shadow is subtler than the prototype's
     shadow but is the nearest existing token. */
  .mionas-split-panel--edge-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--card-base-shadow);
  }

  /* Inset pads the panel itself, so the copy cell drops its own padding -- otherwise the two
     stack and double the inset. Declared after the mobile block on purpose: it ties specificity
     with the mobile copy rule and needs source order to win. */
  .mionas-split-panel--treatment-inset {
    padding: calc(var(--space-lg) * 1.5) calc(var(--space-lg) + var(--space-md));
    /* Redeclares the base gap on purpose: this ties specificity with the mobile
       `.mionas-split-panel { gap: 0 }` rule, and source order lets it win at <=749px -- keeping
       a gap for inset panels on mobile while other configurations collapse to 0. Not redundant. */
    gap: calc(var(--space-md) * 2);
  }

  .mionas-split-panel--treatment-inset .mionas-split-panel__copy {
    padding: 0;
  }

  /* Inset media sits at its own height inside the panel's padding rather than filling the row. */
  .mionas-split-panel--treatment-inset .mionas-split-panel__media {
    height: auto;
  }
{% endstylesheet %}

