{%- comment -%}
  Renders the newsletter blog's history as editor blocks: the latest-email card, the heading and intro, and the year list.

  A paginate here does not reach the blocks, so each block pages the articles itself. 250 is
  Liquid's maximum page size; past 250 emails the oldest drop off.
{%- endcomment -%}

{%- liquid
  # Blank shows the blog of the page the section is on.
  assign newsletter_blog = section.settings.blog | default: blog
  assign has_articles = false
-%}
{%- paginate newsletter_blog.articles by 250 -%}
  {%- if newsletter_blog.articles.size > 0 -%}
    {%- assign has_articles = true -%}
  {%- endif -%}
{%- endpaginate -%}

{%- if has_articles or request.design_mode -%}
  <div
    class="section section--{{ section.settings.section_width }} spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div
      class="mionas-newsletters"
      style="--mionas-newsletters-gap: {{ section.settings.gap }}px;"
    >
      {%- unless has_articles -%}
        {%- render 'mionas-text',
          content: 'No published newsletters yet. The blocks appear once the blog has an article.',
          variant: 'label',
          size: 'lg',
          tag: 'p',
          class: 'mionas-newsletters__note'
        -%}
      {%- endunless -%}
      {%- content_for 'blocks', closest.blog: newsletter_blog -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .mionas-newsletters {
    display: flex;
    flex-direction: column;
    gap: var(--mionas-newsletters-gap);
  }

  /* Theme editor only. */
  .mionas-newsletters__note {
    margin: 0;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width-thin) dashed var(--border-focus);
    border-radius: var(--radius-md);
  }

  @media screen and (max-width: 749px) {
    .mionas-newsletters {
      gap: min(var(--mionas-newsletters-gap), calc(var(--space-md) * 2));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Newsletters",
  "tag": "section",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_mionas-latest-newsletter"
    },
    {
      "type": "mionas-group"
    },
    {
      "type": "_mionas-past-newsletters"
    }
  ],
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Leave empty to use the blog of the page."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Mionas: Newsletters",
      "blocks": {
        "latest": {
          "type": "_mionas-latest-newsletter",
          "blocks": {
            "card": {
              "type": "mionas-group",
              "name": "Mionas: Group - Latest Newsletter",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "horizontal_alignment": "space-between",
                "vertical_alignment": "center",
                "align_baseline": false,
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 40,
                "width": "fill",
                "custom_width": 100,
                "width_mobile": "fill",
                "custom_width_mobile": 100,
                "height": "fit",
                "custom_height": 100,
                "background_media": "none",
                "background_color": "#0b078c",
                "video_position": "cover",
                "background_image_position": "cover",
                "toggle_overlay": false,
                "overlay_color": "#00000026",
                "overlay_style": "solid",
                "gradient_direction": "to top",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_color": "",
