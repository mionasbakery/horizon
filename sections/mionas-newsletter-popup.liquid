{%- comment -%}
  Mionas newsletter popup: a first-visit signup popup with its widget, rendered on every page from
  the footer group.

  The markup ships closed and the scripts decide whether to open it; the Liquid exclusions only skip
  visitors the scripts could never show it to.
{%- endcomment -%}
{%- capture popup_eligible -%}
  {%- render 'mionas-popup-eligible', settings: section.settings, exclude_marketing_subscribers: true -%}
{%- endcapture -%}
{%- assign popup_eligible = popup_eligible | strip -%}

{%- if popup_eligible == 'true' or request.design_mode -%}
  {%- liquid
    assign popup_id = 'MionasNewsletterPopup-' | append: section.id
    assign popup_label = 'mionas.newsletter_popup.label' | t
    assign close_label = 'mionas.newsletter_popup.close' | t
    assign dismiss_label = 'mionas.newsletter_popup.dismiss_widget' | t

    assign widget_eyebrow = section.settings.widget_eyebrow | escape
    assign widget_headline = section.settings.widget_headline | escape
    assign widget_subline = section.settings.widget_subline | escape
    assign widget_offer = widget_headline | append: ' ' | append: widget_subline | strip
    assign widget_label = widget_eyebrow | append: ': ' | append: widget_offer | strip
    assign widget_offer_html = widget_subline
    if widget_headline != blank
      assign widget_offer_html = '<strong>' | append: widget_headline | append: '</strong> ' | append: widget_subline | strip
    endif
    assign show_widget = false
    if section.settings.launcher != 'off' and widget_label != blank
      assign show_widget = true
    endif

    # GA4 accepts only letters, digits and underscores in event names, so hyphens and spaces become underscores.
    assign test_name = section.settings.test_name | default: 'newsletter-popup' | handleize
    assign measurement_name = section.settings.measurement_name | default: 'newsletter_popup' | handleize | replace: '-', '_'
  -%}

  <script
    src="{{ 'mionas-popup.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  {%- if show_widget -%}
    <script
      src="{{ 'mionas-popup-widget.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {%- endif -%}
  <script
    src="{{ 'mionas-newsletter-popup.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {%- capture decline_classes -%}
    {%- render 'mionas-button-class', variant: 'ghost', full_width: true -%}
  {%- endcapture -%}
  {%- capture continue_classes -%}
    {%- render 'mionas-button-class', variant: 'primary', full_width: true -%}
  {%- endcapture -%}

  {%- capture popup_content -%}
    <div
      ref="formView"
      class="mionas-newsletter-popup__view"
    >
      {% content_for 'blocks' %}

      <button
        type="button"
        class="{{ decline_classes }} mionas-newsletter-popup__decline"
        on:click="/decline"
      >
        {{ 'mionas.newsletter_popup.decline' | t }}
      </button>
    </div>

    <div
      ref="successView"
      class="mionas-newsletter-popup__view"
      role="status"
      tabindex="-1"
      hidden
    >
      <span class="mionas-newsletter-popup__check">
        {{- 'icon-checkmark.svg' | inline_asset_content -}}
      </span>
      {%- comment -%}
        Empty on purpose: the script copies the signup block's success banner into it, because a
        theme block's settings are not readable from its parent section.
      {%- endcomment -%}
      {%- render 'mionas-text', content: '', variant: 'headline', size: 'lg', tag: 'h2' -%}
      <button
        type="button"
        class="{{ continue_classes }}"
        on:click="/continueShopping"
      >
        {{ 'mionas.newsletter_popup.continue' | t }}
      </button>
    </div>
  {%- endcapture -%}

  {%- comment -%} Shopify hides cart attributes that start with an underscore from the buyer at checkout. {%- endcomment -%}
  {%- capture popup_attributes -%}
    data-ab-test="{{ section.settings.ab_test_enabled }}" data-popup-share="{{ section.settings.popup_share }}"
    data-test-name="{{ test_name }}" data-event-prefix="{{ measurement_name }}_"
    data-clarity-tag="{{ measurement_name }}" data-cart-attribute="_{{ measurement_name }}"
  {%- endcapture -%}

  {%- render 'mionas-popup',
    element: 'mionas-newsletter-popup-component',
    id: popup_id,
    storage_key: 'newsletter-popup',
    section_id: section.id,
    settings: section.settings,
    label: popup_label,
    close_label: close_label,
    content: popup_content,
    attributes: popup_attributes
  -%}

  {%- if show_widget -%}
    {%- capture widget_content -%}
      {%- if widget_eyebrow != blank -%}
        {%- render 'mionas-stamp', content: widget_eyebrow, size: 'md', color: 'accent-inverse', tag: 'span' -%}
      {%- endif -%}
      {%- render 'mionas-text', content: widget_offer_html, variant: 'body', size: 'md', color: 'inverse-primary', tag: 'span', class: 'mionas-popup-widget__line' -%}
    {%- endcapture -%}
    {%- render 'mionas-popup-widget',
      popup_id: popup_id,
      show: section.settings.launcher,
      reshow_days: section.settings.widget_reshow_days,
      section_id: section.id,
      position: section.settings.launcher_position,
      vertical: section.settings.launcher_vertical,
      label: widget_label,
      dismiss_label: dismiss_label,
      content: widget_content
    -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .mionas-newsletter-popup__view {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .mionas-newsletter-popup__view[hidden] {
    display: none;
  }

  .mionas-newsletter-popup__view:focus {
    outline: none;
  }

  /* The design sets the two buttons 8px apart, closer than the column's 16px gap. */
  .mionas-newsletter-popup__decline {
    margin-top: calc(var(--space-xs) - var(--space-md));
  }

  .mionas-newsletter-popup__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-button-base-size);
    height: var(--icon-button-base-size);
    border-radius: var(--radius-full);
    background: var(--brand-primary);
    color: var(--text-color-inverse-primary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Newsletter popup",
  "tag": "div",
  "enabled_on": {
    "groups": ["footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Beside the text on screens 750px and wider, and as a banner above it on phones."
    },
    {
      "type": "select",
      "id": "audience",
      "label": "Who sees the popup",
      "options": [
        { "value": "everyone", "label": "Everyone" },
        { "value": "testers", "label": "Only testers" }
      ],
      "default": "everyone",
      "info": "With Testers, the A/B test is off and only testers see the popup. Testers see it even when they already get marketing emails. The popup forgets a close or a signup when the tester reloads the page or closes the browser, so each reload is a first visit again."
    },
    {
      "type": "textarea",
      "id": "tester_emails",
      "label": "Tester emails",
      "info": "One email on each line. A tester must log in to their customer account with that email.",
      "visible_if": "{{ section.settings.audience == 'testers' }}"
    },
    {
      "type": "header",
      "content": "Pages"
    },
    {
      "type": "checkbox",
      "id": "hide_on_home",
      "label": "Hide on the home page",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_product",
      "label": "Hide on product pages",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_collection",
      "label": "Hide on collection pages",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_cart",
      "label": "Hide on the cart page",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_search",
      "label": "Hide on search results",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_blog",
      "label": "Hide on blogs and articles",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_page",
      "label": "Hide on content pages",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_account",
      "label": "Hide on customer account pages",
      "default": false
    },
    {
      "type": "link_list",
      "id": "hidden_pages_menu",
      "label": "Hide on the pages in this menu",
      "info": "Create a menu in Online Store → Navigation and add the pages, products, collections, blogs or articles where the popup must not show. A blog also hides its articles. Works in every language."
    },
    {
      "type": "header",
      "content": "Automatic opening"
    },
    {
      "type": "checkbox",
      "id": "auto_open",
      "label": "Open automatically",
      "default": true,
      "info": "Turn off only if the newsletter widget is on: the widget is then the only way to open the popup."
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "Delay before opening",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 8,
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "exit_intent",
      "label": "Open when the visitor is about to leave",
      "default": false,
      "info": "Replaces the timed opening. On desktop it opens when the pointer leaves the top of the window; on phones, on a fast scroll back up. The delay above becomes the minimum time on the page.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "wait_for_interaction",
      "label": "Wait for the first scroll, tap or key press",
      "default": true,
      "info": "Keep on for SEO: a popup that opens on an untouched page can count as the page's largest element in Google's page speed data, and it keeps the popup out of Google's crawler.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "range",
      "id": "scroll_depth",
      "label": "Scroll depth before opening",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 0,
      "info": "0% opens after any first scroll, tap or key press.",
      "visible_if": "{{ section.settings.auto_open and section.settings.wait_for_interaction }}"
    },
    {
      "type": "range",
      "id": "reshow_days",
      "label": "Days before showing again after a close",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 0,
      "info": "0 never shows it again. After a signup it never shows again.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "header",
      "content": "Newsletter widget"
    },
    {
      "type": "select",
      "id": "launcher",
      "label": "Show newsletter widget",
      "options": [
        { "value": "off", "label": "Never (needs Open automatically)" },
        { "value": "after_close", "label": "After the popup closes (needs Open automatically)" },
        { "value": "always", "label": "Always" }
      ],
      "default": "off",
      "info": "A tab on the bottom edge on desktop and a sheet at the bottom on phones. It opens the popup and has its own close button. It never shows to the A/B control group or to subscribers. With Open automatically off, choose Always: Never leaves no way to open the popup, and After the popup is closed works like Always."
    },
    {
      "type": "range",
      "id": "widget_reshow_days",
      "label": "Days before showing the widget again after its close",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 7,
      "info": "0 never shows it again. After a signup it never shows again.",
      "visible_if": "{{ section.settings.launcher != 'off' }}"
    },
    {
      "type": "text",
      "id": "widget_eyebrow",
      "label": "First line",
      "default": "Suscríbete a la newsletter",
      "visible_if": "{{ section.settings.launcher != 'off' }}"
    },
    {
      "type": "text",
      "id": "widget_headline",
      "label": "Offer",
      "default": "10% de descuento",
      "visible_if": "{{ section.settings.launcher != 'off' }}"
    },
    {
      "type": "text",
      "id": "widget_subline",
      "label": "Last line",
      "default": "en tu primera compra",
      "visible_if": "{{ section.settings.launcher != 'off' }}"
    },
    {
      "type": "select",
      "id": "launcher_position",
      "label": "Desktop position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "info": "On phones it is always a sheet at the bottom.",
      "visible_if": "{{ section.settings.launcher != 'off' }}"
    },
    {
      "type": "select",
      "id": "launcher_vertical",
      "label": "Desktop vertical position",
      "options": [
        { "value": "top", "label": "Top, under the header" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom",
      "info": "At the bottom right it can overlap the Shopify Inbox chat button.",
      "visible_if": "{{ section.settings.launcher != 'off' }}"
    },
    {
      "type": "header",
      "content": "A/B test"
    },
    {
      "type": "checkbox",
      "id": "ab_test_enabled",
      "label": "A/B test on",
      "default": true,
      "info": "Visitors in the control group never see the popup. Turn off to show it to every new visitor.",
      "visible_if": "{{ section.settings.audience == 'everyone' }}"
    },
    {
      "type": "range",
      "id": "popup_share",
      "label": "Share of visitors who see the popup",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.audience == 'everyone' and section.settings.ab_test_enabled }}"
    },
    {
      "type": "text",
      "id": "test_name",
      "label": "Test name",
      "default": "newsletter-popup",
      "info": "Sent with every event, the Clarity tag and the order attribute. A new name puts every visitor in a new group; visitors who closed or subscribed still don't see the popup again."
    },
    {
      "type": "text",
      "id": "measurement_name",
      "label": "Measurement name",
      "default": "newsletter_popup",
      "info": "Used for the GA4 and Clarity events (newsletter_popup_shown, …), the Clarity tag and the order attribute (_newsletter_popup). Their value is <test name>:<group>. If you change it, change it in the GA4 custom pixel too."
    },
    {
      "type": "header",
      "content": "Content padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Mionas: Newsletter popup",
      "blocks": {
        "stamp": {
          "type": "mionas-stamp",
          "name": "Mionas: Stamp - Newsletter",
          "settings": {
            "text": "<p>Suscríbete a la newsletter</p>",
            "size": "md",
            "variant": "accent",
            "tag": "p"
          }
        },
        "heading": {
          "type": "mionas-text",
          "name": "Mionas: Text - Heading",
          "settings": {
            "text": "<p>10% de descuento en tu primera compra</p>",
            "variant": "headline",
            "size": "lg",
            "tag": "h2"
          }
        },
        "body": {
          "type": "mionas-text",
          "name": "Mionas: Text - Body",
          "settings": {
            "text": "<p>Además, sé el primero en enterarte de ofertas exclusivas, nuevos cursos y lanzamientos.</p>",
            "variant": "body",
            "size": "md",
            "tag": "p"
          }
        },
        "signup": {
          "type": "mionas-email-signup",
          "name": "Mionas: Email signup - Popup",
          "settings": {
            "button_width": "fill",
            "submit_variant": "primary",
            "submit_size": "md",
            "field_surface": true,
            "customer_tag": "newsletter-popup"
          }
        }
      },
      "block_order": ["stamp", "heading", "body", "signup"]
    }
  ]
}
{% endschema %}
