{%- comment -%}
  Mionas newsletter dialog: a first-visit signup dialog with its corner fold, rendered on every page from
  the footer group. The dialog and the corner fold are fixed blocks with their own settings; this section
  holds the rules for both.

  The markup ships closed and the scripts decide whether to open it. The Liquid leaves out visitors the
  scripts could never show it to; an excluded page still renders it for the corner fold, but never opens it
  by itself.
{%- endcomment -%}
{%- capture dialog_eligible -%}
  {%- render 'mionas-newsletter-eligible', settings: section.settings, exclude_marketing_subscribers: true -%}
{%- endcapture -%}
{%- liquid
  assign eligibility = dialog_eligible | strip | split: ':'
  assign dialog_eligible = eligibility[0]
  assign page_rule = eligibility[1]
-%}

{%- if section.settings.enabled == false -%}
  {%- assign dialog_eligible = 'false' -%}
{%- endif -%}

{%- if dialog_eligible != 'false' or request.design_mode -%}
  {%- liquid
    assign dialog_id = 'MionasNewsletterDialog-' | append: section.id
    assign auto_open = false
    if section.settings.auto_open and dialog_eligible == 'true'
      assign auto_open = true
    endif
  -%}

  <script
    src="{{ 'mionas-dialog.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  {%- if auto_open -%}
    <script
      src="{{ 'mionas-newsletter-trigger.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {%- endif -%}
  <script
    src="{{ 'mionas-newsletter-dialog.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>

  {%- capture dialog_attributes -%}
    {%- if page_rule != blank %}data-page-rule="{{ page_rule }}"{% endif -%}
  {%- endcapture -%}

  {% content_for 'block',
    type: '_mionas-dialog',
    id: 'dialog',
    dialog_id: dialog_id,
    section_id: section.id,
    dialog_attributes: dialog_attributes
  %}

  {%- if auto_open -%}
    {%- render 'mionas-newsletter-trigger', dialog_id: dialog_id, settings: section.settings -%}
  {%- endif -%}

  {% content_for 'block',
    type: '_mionas-corner-fold',
    id: 'corner_fold',
    dialog_id: dialog_id,
    section_id: section.id,
    auto_open: section.settings.auto_open
  %}
{%- endif -%}

{% schema %}
{
  "name": "Mionas: Newsletter Dialog",
  "tag": "div",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable the dialog",
      "default": true,
      "info": "When off, no visitor sees the dialog or its corner fold. The theme editor still shows them, so you can edit them."
    },
    {
      "type": "checkbox",
      "id": "hide_for_ordered_customers",
      "label": "Hide from customers who have ordered",
      "default": true,
      "info": "Logged-in customers with at least one order never see the dialog or its corner fold, since the offer is for a first purchase. A visitor who is not logged in cannot be recognised and still sees it. Customers subscribed to marketing emails never see it."
    },
    {
      "type": "header",
      "content": "Pages",
      "info": "The dialog never opens by itself on the pages in the menu or on the checked page types. The checkboxes cover whole page types and pages a menu cannot hold. The corner fold still shows there and still opens the dialog. The checkout, the order status page, the customer account and login pages and the storefront password page never show the dialog, because they are outside the theme or have no footer."
    },
    {
      "type": "checkbox",
      "id": "hide_on_product",
      "label": "Hide on product pages",
      "info": "Every product page.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_collection",
      "label": "Hide on collection pages",
      "info": "Every collection page and the list of all collections.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_cart",
      "label": "Hide on the cart page",
      "info": "The cart page. The cart drawer has its own setting under Automatic opening.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_blog",
      "label": "Hide on blogs and articles",
      "info": "Every blog and article.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_page",
      "label": "Hide on content pages",
      "info": "Every page made in Online Store → Pages.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_404",
      "label": "Hide on the 404 page",
      "info": "The page a visitor gets for a link that does not exist.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_on_search",
      "label": "Hide on search results",
      "info": "The search results page.",
      "default": true
    },
    {
      "type": "link_list",
      "id": "hidden_pages_menu",
      "label": "Hide on the pages in this menu",
      "info": "Create a menu in Online Store → Navigation and add the home page, search, pages, products, collections, the list of all collections, blogs, articles or policies where the dialog must not show. A blog also hides its articles. Works in every language."
    },
    {
      "type": "header",
      "content": "Automatic opening",
      "info": "The dialog opens when the visitor has been idle for the idle time. That count starts at the first scroll, tap, click or key press, and on a page with the cookie banner at the first one after the visitor answers it. It never opens over the banner or at page load, which keeps it out of Google's page speed data and away from Google's crawler. The settings below say what restarts and pauses the count."
    },
    {
      "type": "checkbox",
      "id": "auto_open",
      "label": "Open automatically",
      "default": true,
      "info": "Turn off only if the newsletter corner fold is on: the corner fold is then the only way to open the dialog."
    },
    {
      "type": "range",
      "id": "idle_seconds",
      "label": "Idle time before opening",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "s",
      "default": 8,
      "info": "The dialog opens when the visitor has done nothing for this long, counted from the first scroll, tap, click or key press, and on a page with the cookie banner from the first one after the answer. Moving the mouse does not start the count. If a finger or mouse button is still down at that moment, the dialog opens after the release, and the click still works. Each page starts the count again.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "reset_on_press",
      "label": "Restart the count on every tap, click or key press",
      "default": true,
      "info": "Every tap, click or key press starts the count again from the full idle time. So does every change to a form control, such as a variant, checkbox, quantity button or select, and every carousel swipe or arrow. When off, the count runs from the first action and ignores later presses.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "reset_on_scroll",
      "label": "Restart the count on scroll and mouse movement",
      "info": "When on, every page scroll and every mouse movement start the count again, so the dialog waits for a real pause. When off, the count keeps running while the visitor scrolls or moves the mouse.",
      "default": false,
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "pause_while_typing",
      "label": "Pause while the visitor types in a field",
      "default": true,
      "info": "The count stops while a text, email, search, phone, password or number field has focus. When the field loses focus, the count starts again from the full idle time. Other controls only restart the count. When off, the dialog can open while the visitor types.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "pause_while_hidden",
      "label": "Pause while the tab is hidden",
      "default": true,
      "info": "The count stops while the visitor is in another tab or app. When the tab shows again, the count starts again from the full idle time. When off, the count runs in the background, and the dialog can be open when the visitor comes back.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "checkbox",
      "id": "pause_for_cart",
      "label": "Wait while the cart drawer is open",
      "default": true,
      "info": "The count stops while the cart drawer is open. When the drawer closes, the count starts again from the full idle time. When off, the dialog can open over the cart drawer.",
      "visible_if": "{{ section.settings.auto_open }}"
    },
    {
      "type": "range",
      "id": "reshow_days",
      "label": "Days between automatic opens",
      "min": 0,
      "max": 90,
      "step": 1,
      "unit": "d",
      "default": 30,
      "info": "The dialog opens by itself at most once in this many days, counted from the last time it opened, whether the visitor closed it or left the page. 0 opens it by itself only once. After a signup it never opens by itself again.",
      "visible_if": "{{ section.settings.auto_open }}"
    }
  ],
  "presets": [
    {
      "name": "Mionas: Newsletter Dialog",
      "blocks": {
        "dialog": {
          "type": "_mionas-dialog",
          "name": "Mionas: Dialog",
          "static": true,
          "blocks": {
            "heading": {
              "type": "mionas-heading-group",
              "name": "Mionas: Heading Group",
              "settings": {
                "eyebrow": "<p>Suscríbete a la newsletter</p>",
                "eyebrow_color": "accent",
                "heading": "<p>10% de descuento en tu primera compra</p>",
                "heading_variant": "heading",
                "heading_tag": "h2"
              }
            },
            "body": {
              "type": "mionas-text",
              "name": "Mionas: Text - Body",
              "settings": {
                "text": "<p>Además, sé el primero en enterarte de ofertas exclusivas, nuevos cursos y lanzamientos.</p>",
                "variant": "body",
                "tag": "p"
              }
            },
            "signup": {
              "type": "mionas-email-signup",
              "name": "Mionas: Email signup - Dialog",
              "settings": {
                "button_width": "fill",
                "submit_variant": "primary",
                "submit_size": "md",
                "field_surface": true,
                "customer_tag": "newsletter-popup"
              }
            }
          },
          "block_order": ["heading", "body", "signup"]
        },
        "corner_fold": {
          "type": "_mionas-corner-fold",
          "name": "Mionas: Corner Fold",
          "static": true
        }
      }
    }
  ]
}
{% endschema %}
