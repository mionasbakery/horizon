{%- comment -%}
  Renders a date-sorted list of upcoming course products, soonest first.

  A course row is a horizontal, imageless date/title/price layout, so it can't reuse
  _product-card's vertical stack -- and mionas-collection's carousel, mobile_card_size and column
  settings would all be meaningless here. It still borrows mionas-collection's free content_for
  'blocks' region above the list for the "PRÓXIMAS FECHAS" kicker (same reasoning as that file).

  collection.products caps at 50, and the past-date filter below runs after that window -- a
  safety net, not a substitute for drafting past courses out of the collection, since truncation
  happens in the collection's manual order before this section ever sees the products.

  Products missing course_date are excluded from the list and named in a theme-editor-only
  warning below, so a missing metafield surfaces as a visible prompt instead of a course quietly
  vanishing.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign max_products = section.settings.max_products

  # %Y%m%d (not %Y-%m-%d) sorts lexicographically as a string and converts to an integer via
  # `| plus: 0` for the past-date comparison below -- one format serves both needs.
  #
  # 'now' resolves in the shop's timezone, and full-page caching can leave a just-passed course
  # visible briefly; the merchant drafting past courses by hand is the real safety net.
  assign today = 'now' | date: '%Y%m%d' | plus: 0

  # Keys are "<YYYYMMDD>~<index>"; sorting them sorts products by date while the index recovers
  # the product afterward. Same-date rows tie-break lexicographically on the index (e.g. ~1, ~12,
  # ~3) -- unspecified deliberately, since only the date prefix affects the page.
  assign date_keys = ''
  assign skipped_products = ''

  for product in collection.products
    assign course_date = product.metafields.custom.course_date.value
    if course_date == blank
      # A product with no date cannot be placed in a date-sorted list. Skipping it silently is a
      # trap, so its title is collected for the theme-editor warning rendered below.
      assign skipped_products = skipped_products | append: product.title | append: '|'
      continue
    endif
    assign date_key = course_date | date: '%Y%m%d' | append: '~' | append: forloop.index0
    assign date_keys = date_keys | append: date_key | append: ','
  endfor

  assign sorted_keys = date_keys | split: ',' | sort

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="
    mionas-course-list
    section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- comment -%}
    Whitespace control on the tag is load-bearing: base.css hides
    .section-resource-list__content:empty, and a stray newline inside the div would be a text node
    that defeats :empty, leaving a --gap-sized hole above the rows when no block is added. Copied
    from mionas-collection.liquid, which carries the same note.
  {%- endcomment -%}
  <div class="section-resource-list__content">{%- content_for 'blocks' -%}</div>

  {%- capture rows -%}
    {%- comment -%}
      Order matters: sort, then drop past dates, then cap at max_products. A `limit:` on the loop
      above would cap products in the collection's manual order before sorting, which could show
      arbitrary dates instead of the soonest ones.
    {%- endcomment -%}
    {%- assign rendered = 0 -%}
    {%- for date_key in sorted_keys -%}
      {%- if rendered >= max_products -%}
        {%- break -%}
      {%- endif -%}

      {%- assign key_parts = date_key | split: '~' -%}
      {%- assign key_date = key_parts[0] | plus: 0 -%}
      {%- if key_date < today -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign product_index = key_parts[1] | plus: 0 -%}
      {%- assign course = collection.products[product_index] -%}

      {%- comment -%}
        One fixed id for every iteration -- see "WHY THE ROW IS A STATIC BLOCK" in
        blocks/_mionas-course-row.liquid. The product travels as closest.product, exactly as
        sections/mionas-collection.liquid passes it to its own static card.
      {%- endcomment -%}
      {% content_for 'block',
        type: '_mionas-course-row',
        id: 'static-course-row',
        closest.product: course
      %}

      {%- assign rendered = rendered | plus: 1 -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    assign rows_content = rows | strip
  -%}

  {%- if rows_content == blank -%}
    {%- comment -%}
      Collapsing to nothing would leave the page as a heading above an info panel with no
      explanation of where the courses went. The fallback line is a setting rather than hardcoded
      copy because it is the merchant's message, not the theme's.
    {%- endcomment -%}
    {%- if section.settings.empty_message != blank -%}
      <p class="mionas-course-list__empty">{{ section.settings.empty_message }}</p>
    {%- endif -%}
  {%- else -%}
    <div class="mionas-course-list__rows">{{ rows_content }}</div>
  {%- endif -%}

  {%- comment -%}
    Theme editor only (request.design_mode): a course silently vanishing from the storefront is
    worse than a visible warning, so products missing course_date are named here instead of just
    dropped. English on purpose, matching the rest of this theme's schema labels.
  {%- endcomment -%}
  {%- if request.design_mode and skipped_products != blank -%}
    {%- assign skipped_list = skipped_products | split: '|' -%}
    <p class="mionas-course-list__warning">
      {{ skipped_list.size }} {% if skipped_list.size == 1 %}product{% else %}products{% endif %} hidden — no “Course date” metafield set:
      {{ skipped_list | join: ', ' }}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .mionas-course-list__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .mionas-course-list__empty {
    margin: 0;
    font-size: var(--text-role-body-lg-font-size);
    line-height: var(--text-role-body-lg-line-height);
  }

  /* Theme editor only -- deliberately loud, and never rendered on the storefront. */
  .mionas-course-list__warning {
    margin: var(--space-sm) 0 0;
    padding: var(--space-xs) var(--space-sm);
    border: var(--border-width-thin) solid var(--border-danger);
    border-radius: var(--radius-md);
    color: var(--color-vermell-segell);
    font-size: var(--text-role-label-lg-font-size);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Course list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" },
    { "type": "_divider" }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "inline_richtext",
      "id": "empty_message",
      "label": "Message when there are no upcoming courses",
      "default": "Próximamente nuevas fechas. Escríbenos para avisarte."
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Mionas: Course list",
      "category": "t:categories.product",
      "settings": {
        "section_width": "page-width",
        "max_products": 6,
        "empty_message": "Próximamente nuevas fechas. Escríbenos para avisarte.",
        "gap": 28,
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-course-row": {
          "type": "_mionas-course-row",
          "name": "Mionas: Course row",
          "static": true,
          "settings": {}
        }
      }
    }
  ]
}
{% endschema %}
