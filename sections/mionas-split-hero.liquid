{%- comment -%}
  A split hero: copy on one side, image on the other, on a full-bleed colour panel.

  The home page builds this shape by hand -- templates/index.json's "Split Hero" is a generic
  `section` composed of an `image` block plus a `group` holding three `mionas-text` blocks and a
  nested `group` of two `button` blocks. Reproducing it elsewhere means recreating that tree by
  hand, and two hand-built copies drift apart. This section makes the shape a unit.

  The two sides are *static* blocks -- rendered with content_for 'block' plus an explicit type and
  id -- of types that already exist. A static slot cannot be removed, reordered or duplicated by a
  merchant, so the section always has exactly one media side and one copy side. That is the same
  mechanism sections/carousel.liquid uses for its static header and sections/product-list.liquid
  for its header and cards -- and it is why this file re-implements no typography, no buttons and
  no image rendering. Contrast with the deleted blocks/mionas-split-hero.liquid (removed in
  bce9ff0), which emitted its own markup and therefore needed its own design tokens, bridge entries
  and a contract test to pin them. None of that is needed here.

  The copy side is a `group` (blocks/group.liquid), which renders its children dynamically via
  content_for 'blocks' --
  so the eyebrow/heading/lead and the nested actions row are its ordinary children: the merchant
  can retitle, reorder, add or remove them per instance. That is deliberate and mirrors the home
  page hero's own outer group -- the lock is on the section's shape, not on the copy's contents,
  exactly as the actions row already worked. If the copy ever needs to be locked line-by-line, the
  route is a private `_`-prefixed block that renders each line as its own static slot (the
  _carousel-content / _product-list-content pattern), not a native group.

  Only the split grid and the panel colour live here. Everything else belongs to the blocks --
  including the copy column's flow, gap and alignment, which are the group's settings.
{%- endcomment -%}

{% liquid
  if section.settings.variant == 'vanilla'
    assign panel_color = 'var(--color-beige-vainilla)'
  else
    assign panel_color = settings.color_palette.color3
  endif
%}

<div
  class="section section--{{ section.settings.section_width }} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != blank %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
  "
>
  <div
    class="mionas-split-hero mionas-split-hero--{{ section.settings.variant }} mionas-split-hero--media-{{ section.settings.media_position }}"
    style="--mionas-split-hero-panel: {{ panel_color }};"
    {{ section.shopify_attributes }}
  >
    <div class="mionas-split-hero__media">
      {% content_for 'block', type: 'image', id: 'static-media' %}
    </div>

    <div class="mionas-split-hero__copy">
      {% content_for 'block', type: 'group', id: 'static-copy' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .mionas-split-hero {
    display: grid;
    /* minmax(0, 1fr) rather than a bare 1fr: grid items default to min-width: auto, so a wide
       image, a long unbreakable word, or a button row that refuses to wrap can push its column
       past half and quietly break the even split. Flooring the minimum at 0 keeps it exactly
       50/50 regardless of content. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    height: 100%;
    background: var(--mionas-split-hero-panel, var(--color-background));
  }

  /* Only the grid cell and its padding. The copy's own layout -- column flow, gap, alignment --
     belongs to the `group` block inside it (blocks/group.liquid), the same way the home page's
     hero delegates to its outer group. Duplicating that here would fight the merchant's own
     group settings. */
  .mionas-split-hero__copy {
    padding: 48px 32px;
  }

  /* The image block is set to height: fill, so the media cell has to have a height
     of its own or the row collapses. */
  .mionas-split-hero__media {
    height: 100%;
  }

  .mionas-split-hero--media-right .mionas-split-hero__media {
    grid-column: 2;
    grid-row: 1;
  }

  .mionas-split-hero--media-right .mionas-split-hero__copy {
    grid-column: 1;
    grid-row: 1;
  }

  .mionas-split-hero--media-left .mionas-split-hero__media {
    grid-column: 1;
    grid-row: 1;
  }

  .mionas-split-hero--media-left .mionas-split-hero__copy {
    grid-column: 2;
    grid-row: 1;
  }

  /* Single column below the theme's mobile breakpoint, image always leading
     whichever side it takes on desktop. */
  @media screen and (max-width: 749px) {
    .mionas-split-hero {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .mionas-split-hero--media-left .mionas-split-hero__media,
    .mionas-split-hero--media-right .mionas-split-hero__media {
      grid-column: 1;
      grid-row: 1;
      min-height: 220px;
    }

    .mionas-split-hero--media-left .mionas-split-hero__copy,
    .mionas-split-hero--media-right .mionas-split-hero__copy {
      grid-column: 1;
      grid-row: 2;
      padding: 32px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Mionas: Split hero",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Panel color",
      "options": [
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "vanilla",
          "label": "Vanilla"
        }
      ],
      "default": "sand",
      "info": "Sand follows the theme palette. Vanilla is the design system's beige vainilla."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "info": "The image always leads on mobile, whichever side it takes on desktop."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "section_height_custom",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50,
      "unit": "%",
      "visible_if": "{{ section.settings.section_height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Mionas: Split hero",
      "category": "t:categories.banners",
      "settings": {
        "variant": "sand",
        "media_position": "left",
        "section_width": "full-width",
        "section_height": "medium",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "static-media": {
          "type": "image",
          "name": "Image",
          "static": true,
          "settings": {
            "image_ratio": "landscape",
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fill",
            "border": "none",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "static-copy": {
          "type": "group",
          "name": "Copy",
          "static": true,
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "align_baseline": false,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "border": "none",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "eyebrow": {
              "type": "mionas-text",
              "name": "Eyebrow",
              "settings": {
                "text": "<p>ESPECIALIDAD EN COOKIES · SITGES</p>",
                "role": "stamp",
                "variant": "accent",
                "tag": "div"
              }
            },
            "heading": {
              "type": "mionas-text",
              "name": "Heading",
              "settings": {
                "text": "<p>COOKIES RECIÉN HORNEADAS, DIRECTAS A TU CASA</p>",
                "role": "hero",
                "variant": "default",
                "tag": "h1"
              }
            },
            "lead": {
              "type": "mionas-text",
              "name": "Lead",
              "settings": {
                "text": "<p>Te enviamos las cookies recién horneadas cada <strong>martes y miércoles</strong>. Recíbelas en <strong>24-48</strong>h.</p>",
                "role": "lead",
                "variant": "default",
                "tag": "p"
              }
            },
            "actions": {
              "type": "group",
              "name": "Actions",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "align_baseline": false,
                "gap": 12,
                "width": "fill",
                "custom_width": 100,
                "width_mobile": "fill",
                "custom_width_mobile": 100,
                "height": "fit",
                "custom_height": 100,
                "background_media": "none",
                "border": "none",
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "cta": {
                  "type": "button",
                  "name": "t:names.button",
                  "settings": {
                    "label": "Comprar ahora",
                    "link": "shopify://collections/all",
                    "open_in_new_tab": false,
                    "style_class": "button",
                    "width": "fit-content",
                    "custom_width": 100,
                    "width_mobile": "fit-content",
                    "custom_width_mobile": 100
                  }
                },
                "secondary": {
                  "type": "button",
                  "name": "t:names.button",
                  "settings": {
                    "label": "Nuestra historia",
                    "link": "shopify://collections/all",
                    "open_in_new_tab": false,
                    "style_class": "button-secondary",
                    "width": "fit-content",
                    "custom_width": 100,
                    "width_mobile": "fit-content",
                    "custom_width_mobile": 100
                  }
                }
              },
              "block_order": [
                "cta",
                "secondary"
              ]
            }
          },
          "block_order": [
            "eyebrow",
            "heading",
            "lead",
            "actions"
          ]
        }
      }
    }
  ]
}
{% endschema %}
